# Copy thành .env rồi điền giá trị
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Chỉ bật khi đã public qua HTTPS
SECURE_COOKIES=false
TRUST_PROXY=false

DB_PATH=data/chicong.db
BACKUP_DIR=data/backups

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# File JSON của Google Service Account (nhớ share 2 thư mục Drive cho email của service account)
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service-account.json
# Dán ID hoặc cả link thư mục đều được
DRIVE_VAT_INPUT_FOLDER_ID=
DRIVE_VAT_OUTPUT_FOLDER_ID=

# Sao lưu tự động mỗi ngày (giờ VN), giữ N bản gần nhất trong BACKUP_DIR
BACKUP_HOUR=2
BACKUP_KEEP=14
