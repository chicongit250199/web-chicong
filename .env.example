# Copy thành .env rồi điền giá trị
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Chỉ bật khi đã public qua HTTPS
SECURE_COOKIES=false
TRUST_PROXY=false

DB_PATH=data/chicong.db
BACKUP_DIR=data/backups

GEMINI_API_KEY=
# Key dự phòng (tự chuyển khi key 1 hết lượt / quá tải)
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính quá tải
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite

# File JSON của Google Service Account (nhớ share 2 thư mục Drive cho email của service account)
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service-account.json
# Dán ID hoặc cả link thư mục đều được
DRIVE_VAT_INPUT_FOLDER_ID=
DRIVE_VAT_OUTPUT_FOLDER_ID=

# Sao lưu tự động mỗi ngày (giờ VN), giữ N bản gần nhất trong BACKUP_DIR
BACKUP_HOUR=2
BACKUP_KEEP=14

# Sao lưu lên Google Drive của cửa hàng (OAuth client loại "TVs and Limited Input devices", quyền drive.file).
# Kết nối 1 lần ở trang Hệ thống. Token lưu trong credentials/drive-backup-token.json
GDRIVE_BACKUP_CLIENT_ID=
GDRIVE_BACKUP_CLIENT_SECRET=
OFFSITE_BACKUP_KEEP=30

# Sao lưu ngoài máy lên GitHub (nhánh backup của repo, dùng SSH key của máy), mã hóa AES-256 bằng mật khẩu này.
# Tạo: openssl rand -base64 18 — CHÉP RA CHỖ AN TOÀN, mất là không giải mã được.
BACKUP_PASSPHRASE=
GIT_BACKUP_KEEP=7

# Tự động quét hóa đơn VAT trên Drive: mỗi ngày lúc HH:MM (giờ VN). Muốn quét mỗi N phút thì xóa dòng AT và đặt MINUTES=N; MINUTES=0 = tắt
VAT_AUTO_SYNC_AT=00:00
