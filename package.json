{
  "name": "chicong-web",
  "version": "1.0.0",
  "description": "Web nội bộ & ERP Chí Công Computer",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i public/css/input.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i public/css/input.css -o public/css/app.css --watch",
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prestart": "npm run build:css",
    "seed:demo": "node scripts/seed-demo.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@googleapis/drive": "^27.1.0",
    "alpinejs": "^3.17.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.12.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tailwindcss": "3.4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
