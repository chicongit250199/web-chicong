{
  "name": "chicong-web",
  "version": "1.0.0",
  "description": "Web nội bộ & ERP Chí Công Computer",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i public/css/input.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i public/css/input.css -o public/css/app.css --watch",
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prestart": "npm run build:css"
  },
  "dependencies": {
    "alpinejs": "^3.17.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tailwindcss": "3.4"
  },
  "private": true,
  "engines": {
    "node": ">=18.17"
  }
}
