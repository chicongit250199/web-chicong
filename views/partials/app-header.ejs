<header class="sticky top-0 z-40 flex h-14 items-center justify-between gap-3 border-b border-slate-200 bg-white/95 px-3 backdrop-blur md:px-4 dark:border-slate-800 dark:bg-slate-900/95">
  <a href="<%= user.role === 'manager' ? '/manager' : '/staff' %>" class="flex min-w-0 items-center gap-2 font-semibold">
    <% if (settings.logo_url) { %>
      <img src="<%= settings.logo_url %>" alt="" class="h-9 w-auto">
    <% } else { %>
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-600 text-sm font-bold text-white">CC</span>
    <% } %>
    <span class="hidden truncate sm:inline"><%= settings.company_name %></span>
    <span class="hidden rounded-md bg-slate-100 px-1.5 py-0.5 text-[11px] font-semibold uppercase text-slate-500 sm:inline dark:bg-slate-800"><%= user.role === 'manager' ? 'Quản lý' : 'Nhân viên' %></span>
  </a>
  <div class="flex items-center gap-2">
    <%# Task quá hạn: icon cảnh báo, bấm mở danh sách (popup góc trên phải) %>
    <% if (typeof taskAlerts !== 'undefined' && taskAlerts.length && !(typeof hideTaskAlerts !== 'undefined' && hideTaskAlerts)) { const pend = taskAlerts.filter(x => x.alert && x.alert.kind === 'pending').length; %>
      <div x-data="{ open: false }" class="relative" @keydown.escape.window="open = false" @click.outside="open = false">
        <button type="button" @click="open = !open" class="relative grid h-9 w-9 place-items-center rounded-lg text-orange-600 hover:bg-orange-50 dark:text-orange-400 dark:hover:bg-orange-950/50"
                title="<%= taskAlerts.length %> task cần chú ý" aria-label="<%= taskAlerts.length %> task cần chú ý">
          <%- icon('alert', 'h-6 w-6') %>
          <span class="absolute -right-0.5 -top-0.5 grid h-5 min-w-5 place-items-center rounded-full bg-orange-600 px-1 text-[11px] font-bold text-white ring-2 ring-white dark:ring-slate-900"><%= taskAlerts.length > 99 ? '99+' : taskAlerts.length %></span>
        </button>
        <div x-show="open" x-cloak x-transition:enter="toast-top-in" x-transition:leave="transition duration-150 ease-in" x-transition:leave-end="opacity-0 -translate-y-2"
             class="fixed right-4 top-16 z-[65] w-[26rem] max-w-[calc(100vw-2rem)] overflow-hidden rounded-xl border border-orange-300 bg-white text-sm shadow-2xl dark:border-orange-800 dark:bg-slate-900">
          <div class="flex items-start gap-2 bg-orange-50 px-4 py-2.5 text-orange-900 dark:bg-orange-950/60 dark:text-orange-100">
            <%- icon('alert', 'mt-0.5 h-5 w-5 shrink-0 text-orange-600') %>
            <p class="flex-1"><b><%= taskAlerts.length %> task cần chú ý</b><br><span class="text-xs"><%= [pend ? `${pend} task chờ quá ${taskAlertDays.pending} ngày` : '', taskAlerts.length - pend ? `${taskAlerts.length - pend} task đang sửa quá ${taskAlertDays.processing} ngày` : ''].filter(Boolean).join(' · ') %> <span class="opacity-70">(không tính Chủ nhật)</span></span></p>
            <button type="button" @click="open = false" class="opacity-60 hover:opacity-100" aria-label="Đóng"><%- icon('x', 'h-4 w-4') %></button>
          </div>
          <ul class="max-h-[60vh] divide-y divide-slate-100 overflow-y-auto dark:divide-slate-800">
            <% taskAlerts.slice(0, 10).forEach(x => { %>
              <li><a href="/staff/tasks/<%= x.id %>" class="flex flex-wrap items-center gap-x-3 gap-y-0.5 px-4 py-2 hover:bg-orange-50 dark:hover:bg-orange-950/30">
                <span class="font-mono text-xs"><%= x.ticket_code %></span>
                <span class="min-w-0 flex-1 truncate font-medium"><%= x.device_model %></span>
                <span class="text-xs text-slate-500"><%= x.assigned_name || 'Chưa ai nhận' %></span>
                <span class="<%= x.alert.kind === 'pending' ? 'badge-red' : 'badge-amber' %>"><%= x.alert.label %></span>
              </a></li>
            <% }) %>
          </ul>
          <a href="/staff/tasks?view=overdue" class="block border-t border-slate-200 px-4 py-2 text-center text-xs font-semibold text-orange-700 hover:bg-orange-50 dark:border-slate-800 dark:text-orange-300 dark:hover:bg-orange-950/30">Xem tất cả<%= taskAlerts.length > 10 ? ` (${taskAlerts.length})` : '' %> →</a>
        </div>
      </div>
    <% } %>
    <%- include('theme-icons') %>
    <span class="hidden text-sm font-medium md:inline"><%= user.full_name %></span>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-950" title="Đăng xuất">
        <%- icon('logout', 'h-4 w-4') %><span class="hidden sm:inline">Đăng xuất</span>
      </button>
    </form>
  </div>
</header>
