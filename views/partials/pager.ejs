<%# Phân trang: page, pages, total, link(p) -> url. Hiện 1 … p-1 p p+1 … cuối %>
<% if (pages > 1) {
  const set = new Set([1, pages, page - 1, page, page + 1].filter(p => p >= 1 && p <= pages));
  const nums = [...set].sort((a, b) => a - b);
  const btn = 'grid h-8 min-w-8 place-items-center rounded-lg px-2 text-sm font-medium transition';
%>
  <nav class="mt-3 flex flex-wrap items-center justify-between gap-2" aria-label="Phân trang">
    <p class="text-xs text-slate-500"><%= (page - 1) * pageSize + 1 %>–<%= Math.min(page * pageSize, total) %> / <%= total %></p>
    <div class="flex items-center gap-1">
      <% if (page > 1) { %><a href="<%= link(page - 1) %>" class="<%= btn %> text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-800" aria-label="Trang trước">‹</a><% } else { %><span class="<%= btn %> text-slate-300 dark:text-slate-700">‹</span><% } %>
      <% nums.forEach((n, i) => { %>
        <% if (i && n - nums[i - 1] > 1) { %><span class="px-1 text-slate-400">…</span><% } %>
        <a href="<%= link(n) %>" class="<%= btn %> <%= n === page ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-800' %>" <%= n === page ? 'aria-current="page"' : '' %>><%= n %></a>
      <% }) %>
      <% if (page < pages) { %><a href="<%= link(page + 1) %>" class="<%= btn %> text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-800" aria-label="Trang sau">›</a><% } else { %><span class="<%= btn %> text-slate-300 dark:text-slate-700">›</span><% } %>
    </div>
  </nav>
<% } else if (total) { %>
  <p class="mt-3 text-xs text-slate-500"><%= total %> dòng</p>
<% } %>
