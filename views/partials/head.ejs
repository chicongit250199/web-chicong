<!doctype html>
<html lang="<%= lang %>"<%- typeof appUi !== 'undefined' && appUi ? ' class="app-ui"' : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= title %> · <%= settings.company_name %></title>
  <% if (settings.logo_url) { %><link rel="icon" href="<%= settings.logo_url %>"><% } %>
  <script nonce="<%= nonce %>">
    // Áp theme trước khi vẽ trang để không bị nháy
    (function () {
      var m = 'auto'; try { m = localStorage.getItem('theme') || 'auto'; } catch (e) {}
      var dark = m === 'dark' || (m === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.dataset.theme = m;
    })();
  </script>
  <link rel="stylesheet" href="/css/app.css?v=<%= v %>">
  <script defer src="/js/app.js?v=<%= v %>"></script>
  <% (typeof scripts !== 'undefined' ? scripts : []).forEach(s => { %><script defer src="<%= s %>?v=<%= v %>"></script>
  <% }) %>
  <script defer src="/vendor/alpine.js"></script>
  <% if (typeof appUi !== 'undefined' && appUi) { %>
  <%# Chrome/Edge: rê chuột ~0,2s (điện thoại: lúc chạm) vào link là tải trước trang -> bấm vào hiện gần như ngay.
      Chỉ tải trước trang xem thường; bỏ qua in phiếu, xuất file, JSON, đăng xuất, trang Hệ thống (nặng). %>
  <script type="speculationrules" nonce="<%= nonce %>">
  {"prefetch":[{"where":{"and":[
    {"or":[{"href_matches":"/staff*"},{"href_matches":"/manager*"}]},
    {"not":{"href_matches":"/manager/system*"}},
    {"not":{"href_matches":"*/print*"}},{"not":{"href_matches":"*/receipt*"}},{"not":{"href_matches":"*.json*"}},
    {"not":{"href_matches":"*.csv*"}},{"not":{"href_matches":"*export*"}},{"not":{"href_matches":"*download*"}},
    {"not":{"href_matches":"/logout*"}},{"not":{"selector_matches":"[target=_blank], [download], .no-prefetch"}}
  ]},"eagerness":"moderate"}]}
  </script>
  <% } %>
</head>
<body class="min-h-screen bg-paper text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100">
<% const bgMode = settings.bg_logo || 'float'; if (settings.logo_url && bgMode !== 'off') { %>
  <%# Logo nền: in chìm ở giữa + vài logo nhỏ trôi quanh (nằm sau mọi nội dung, không bắt chuột) %>
  <div class="bg-logos" aria-hidden="true">
    <img src="<%= settings.logo_url %>" alt="" class="bg-logo-center">
    <% if (bgMode === 'float') { [[6,12,72,0],[86,18,56,1],[14,78,64,2],[78,72,88,3],[48,92,48,4],[94,48,44,5]].forEach(([x, y, size, k]) => { %>
      <img src="<%= settings.logo_url %>" alt="" class="bg-logo-float bg-float-<%= k %>" style="left:<%= x %>%;top:<%= y %>%;width:<%= size %>px">
    <% }) } %>
  </div>
<% } %>
