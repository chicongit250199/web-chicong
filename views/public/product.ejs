<%- include('_layout_top') %>
<% const stock = stockOf(p);
   const condKey = c => { const n = String(c || '').toLowerCase(); return !n ? null : /like/.test(n) ? 'cond.likenew' : /mới|moi|new/.test(n) ? 'cond.new' : 'cond.used'; };
   const ck = condKey(p.condition);
   const name = field(p, 'name');
   const highlights = (descBlocks.find(b => b.type === 'ul') || { items: [] }).items.slice(0, 4);
   const quickSpecs = specRows.filter(r => r.k).slice(0, 5); %>
<main class="mx-auto max-w-7xl px-4 pb-24 pt-6 md:pb-10">
  <nav class="mb-4 flex flex-wrap items-center gap-1 text-sm text-slate-500">
    <a href="/" class="hover:text-brand-600"><%= t('nav.home') %></a>
    <% if (cat) { %><span>›</span><a href="/c/<%= cat.id %>" class="hover:text-brand-600"><%= field(cat, 'name') %></a><% } %>
    <span>›</span><span class="line-clamp-1 text-slate-700 dark:text-slate-300"><%= name %></span>
  </nav>

  <%# ===== Phần đầu: ảnh + thông tin mua ===== %>
  <section class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-10">
    <div x-data="{ i: 0, n: <%= images.length %> }" @keydown.arrow-right.window="n > 1 && (i = (i + 1) % n)" @keydown.arrow-left.window="n > 1 && (i = (i - 1 + n) % n)">
      <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <% if (images.length) { %>
          <div class="grid aspect-square">
            <% images.forEach((u, k) => { %>
              <img src="<%= u %>" alt="<%= name %> — ảnh <%= k + 1 %>" <%= k ? 'loading="lazy"' : '' %> class="col-start-1 row-start-1 h-full w-full object-contain p-6 transition-opacity duration-300" :class="i === <%= k %> ? 'opacity-100' : 'pointer-events-none opacity-0'">
            <% }) %>
          </div>
          <% if (images.length > 1) { %>
            <button type="button" @click="i = (i - 1 + n) % n" aria-label="Ảnh trước" class="absolute left-3 top-1/2 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-xl text-slate-700 shadow hover:bg-white dark:bg-slate-800/90 dark:text-slate-200">‹</button>
            <button type="button" @click="i = (i + 1) % n" aria-label="Ảnh sau" class="absolute right-3 top-1/2 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-xl text-slate-700 shadow hover:bg-white dark:bg-slate-800/90 dark:text-slate-200">›</button>
            <span class="absolute bottom-3 right-3 rounded-full bg-slate-900/70 px-2.5 py-0.5 text-xs text-white" x-text="(i + 1) + ' / ' + n"></span>
          <% } %>
        <% } else { %>
          <div class="grid aspect-square place-items-center bg-gradient-to-br from-slate-50 to-slate-100 text-slate-300 dark:from-slate-900 dark:to-slate-950 dark:text-slate-700"><%- icon(cat ? cat.icon : 'box', 'h-40 w-40') %></div>
        <% } %>
        <div class="absolute left-4 top-4 flex flex-wrap gap-2">
          <% if (ck) { %><span class="rounded-full bg-slate-900/85 px-3 py-1 text-xs font-semibold text-white backdrop-blur"><%= t(ck) %></span><% } %>
          <% if (p.is_featured) { %><span class="rounded-full bg-amber-400 px-3 py-1 text-xs font-bold uppercase text-amber-950">Hot</span><% } %>
        </div>
      </div>
      <% if (images.length > 1) { %>
        <div class="mt-3 grid grid-cols-5 gap-2">
          <% images.forEach((u, k) => { %>
            <button type="button" @click="i = <%= k %>" class="overflow-hidden rounded-xl border-2 bg-white transition dark:bg-slate-900" :class="i === <%= k %> ? 'border-brand-600 shadow' : 'border-slate-200 opacity-70 hover:opacity-100 dark:border-slate-800'" aria-label="Xem ảnh <%= k + 1 %>">
              <img src="<%= u %>" alt="" loading="lazy" class="aspect-square w-full object-contain p-1">
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="flex flex-col">
      <% if (cat) { %><a href="/c/<%= cat.id %>" class="mb-2 inline-flex w-fit items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:bg-brand-900/40 dark:text-brand-300"><%- icon(cat.icon, 'h-3.5 w-3.5') %><%= field(cat, 'name') %></a><% } %>
      <h1 class="text-2xl font-extrabold leading-tight tracking-tight md:text-3xl"><%= name %></h1>

      <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
        <% if (stock !== null) { %>
          <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-semibold <%= stock > 0 ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-800' %>">
            <span class="h-2 w-2 rounded-full <%= stock > 0 ? 'bg-emerald-500' : 'bg-slate-400' %>"></span><%= stock > 0 ? t('product.in_stock') + (stock > 1 ? ' · ' + t('product.left', { n: stock }) : '') : t('product.out_of_stock') %>
          </span>
        <% } %>
      </div>

      <div class="mt-5 rounded-2xl bg-gradient-to-r from-red-50 to-orange-50 p-4 dark:from-red-950/40 dark:to-orange-950/30">
        <p class="text-3xl font-extrabold tracking-tight text-red-600 md:text-4xl dark:text-red-400"><%= p.price ? fmt.money(p.price) : t('product.price_contact') %></p>
      </div>

      <% if (highlights.length || quickSpecs.length) { %>
        <ul class="mt-5 space-y-2 text-sm">
          <% (highlights.length ? highlights : quickSpecs).forEach(h => { %>
            <li class="flex gap-2.5"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-emerald-500 text-white"><%- icon('check', 'h-3 w-3') %></span>
              <span><% if (h.strong || h.k) { %><strong><%= h.strong || h.k %>:</strong> <% } %><%= h.text || h.v %></span></li>
          <% }) %>
        </ul>
      <% } %>

      <div class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3">
        <a href="<%= contact.zalo %>" target="_blank" rel="noopener" class="btn col-span-2 bg-[#0068ff] py-3 text-base text-white shadow-md shadow-blue-500/20 hover:opacity-90 sm:col-span-1"><%- icon('chat', 'h-5 w-5') %>Zalo</a>
        <a href="<%= contact.whatsapp %>" target="_blank" rel="noopener" class="btn bg-[#25d366] py-3 text-white hover:opacity-90"><%- icon('chat', 'h-5 w-5') %>WhatsApp</a>
        <a href="<%= contact.tel %>" class="btn border-2 border-brand-600 py-3 text-brand-700 hover:bg-brand-50 dark:text-brand-300 dark:hover:bg-slate-800"><%- icon('phone', 'h-5 w-5') %><%= settings.phone %></a>
      </div>

      <div class="mt-6 grid grid-cols-3 gap-2 text-center text-xs">
        <% [['chat', 'product.trust_1'], ['checkCircle', 'product.trust_2'], ['wrench', 'product.trust_3']].forEach(([ic, k]) => { %>
          <div class="rounded-xl border border-slate-200 bg-white px-2 py-3 dark:border-slate-800 dark:bg-slate-900">
            <span class="mx-auto mb-1.5 grid h-9 w-9 place-items-center rounded-full bg-brand-50 text-brand-600 dark:bg-brand-900/40 dark:text-brand-300"><%- icon(ic, 'h-5 w-5') %></span>
            <span class="font-medium text-slate-700 dark:text-slate-300"><%= t(k) %></span>
          </div>
        <% }) %>
      </div>
      <p class="mt-4 flex items-start gap-2 text-sm text-slate-500"><%- icon('map', 'mt-0.5 h-4 w-4 shrink-0 text-brand-600') %><span><%= t('product.visit') %>: <%= settings.address %></span></p>
    </div>
  </section>

  <%# ===== Nội dung: bài giới thiệu + bảng cấu hình ===== %>
  <section class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-8">
    <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm md:p-8 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-5 flex items-center gap-2 text-xl font-bold"><span class="h-6 w-1.5 rounded-full bg-brand-600"></span><%= t('product.overview') %></h2>
      <% if (!descBlocks.length) { %>
        <p class="text-slate-600 dark:text-slate-400"><%= t('product.no_desc') %></p>
      <% } %>
      <div class="space-y-4 text-[15px] leading-7 text-slate-700 dark:text-slate-300">
        <% descBlocks.forEach((b, i) => { %>
          <% if (b.type === 'h') { %>
            <h3 class="flex items-center gap-2 pt-3 text-lg font-bold text-slate-900 dark:text-white"><span class="h-5 w-1 rounded-full bg-gradient-to-b from-brand-500 to-sky-400"></span><%= titleCase(b.text) %></h3>
          <% } else if (b.type === 'ul') { %>
            <ul class="grid gap-2.5 rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50 <%= b.items.length > 3 ? 'sm:grid-cols-2' : '' %>">
              <% b.items.forEach(it => { %>
                <li class="flex gap-2.5"><span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white"><%- icon('check', 'h-3 w-3') %></span>
                  <span><% if (it.strong) { %><strong class="text-slate-900 dark:text-white"><%= it.strong %>:</strong> <% } %><%= it.text %></span></li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="<%= i === 0 ? 'text-base font-medium text-slate-800 dark:text-slate-200' : '' %>"><%= b.text %></p>
          <% } %>
        <% }) %>
      </div>
    </article>

    <aside class="lg:sticky lg:top-6 lg:self-start">
      <% if (specRows.length) { %>
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h2 class="flex items-center gap-2 bg-gradient-to-r from-brand-700 to-sky-500 px-5 py-3 font-bold text-white"><%- icon('cpu', 'h-5 w-5') %><%= t('product.specs') %></h2>
          <dl class="divide-y divide-slate-100 text-sm dark:divide-slate-800">
            <% specRows.forEach((r, i) => { %>
              <div class="grid grid-cols-[7.5rem_1fr] gap-3 px-5 py-2.5 <%= i % 2 ? 'bg-slate-50/70 dark:bg-slate-800/30' : '' %>">
                <% if (r.k) { %><dt class="font-medium text-slate-500"><%= r.k %></dt><dd class="text-slate-800 dark:text-slate-200"><%= r.v %></dd>
                <% } else { %><dd class="col-span-2 text-slate-800 dark:text-slate-200"><%= r.v %></dd><% } %>
              </div>
            <% }) %>
          </dl>
        </div>
      <% } %>
      <div class="mt-4 rounded-3xl bg-gradient-to-br from-brand-600 to-sky-500 p-5 text-white shadow-md">
        <p class="font-bold"><%= t('product.ask') %></p>
        <p class="mt-1 text-sm text-white/85"><%= settings.company_name %> · <%= settings.phone %></p>
        <div class="mt-3 flex gap-2">
          <a href="<%= contact.zalo %>" target="_blank" rel="noopener" class="btn flex-1 bg-white py-2 text-brand-700 hover:bg-brand-50">Zalo</a>
          <a href="<%= contact.tel %>" class="btn flex-1 bg-white/15 py-2 text-white ring-1 ring-white/40 hover:bg-white/25"><%- icon('phone', 'h-4 w-4') %><%= t('product.call') %></a>
        </div>
      </div>
    </aside>
  </section>

  <% if (related.length) { %>
    <section class="mt-12">
      <h2 class="mb-4 flex items-center gap-2 text-xl font-bold"><span class="h-6 w-1.5 rounded-full bg-brand-600"></span><%= t('product.related') %></h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:grid-cols-5">
        <% related.forEach(r => { %><%- partial('public/_card', { p: r, catIcon: cat && cat.icon, field, fmt, icon, t, stock: stockOf(r) }) %><% }) %>
      </div>
    </section>
  <% } %>
</main>

<%# Thanh liên hệ cố định trên điện thoại %>
<div class="fixed inset-x-0 bottom-14 z-30 grid grid-cols-2 gap-2 border-t border-slate-200 bg-white/95 p-2 backdrop-blur md:hidden dark:border-slate-800 dark:bg-slate-900/95">
  <a href="<%= contact.tel %>" class="btn border-2 border-brand-600 py-2 text-brand-700 dark:text-brand-300"><%- icon('phone', 'h-4 w-4') %><%= t('product.call') %></a>
  <a href="<%= contact.zalo %>" target="_blank" rel="noopener" class="btn bg-[#0068ff] py-2 text-white"><%- icon('chat', 'h-4 w-4') %>Zalo</a>
</div>
<%- include('_layout_bottom') %>
