<header class="relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-600 to-sky-500 text-white">
  <% if (settings.banner_url) { %>
    <img src="<%= settings.banner_url %>" alt="" class="absolute inset-0 h-full w-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-slate-950/40 to-transparent"></div>
  <% } %>
  <div class="relative mx-auto flex h-36 max-w-7xl flex-col justify-between px-4 py-4 md:h-44">
    <a href="/" class="flex items-center gap-3 self-start">
      <% if (settings.logo_url) { %>
        <img src="<%= settings.logo_url %>" alt="<%= settings.company_name %>" class="h-12 w-auto rounded-lg bg-white/90 p-1 md:h-14">
      <% } else { %>
        <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/15 text-lg font-bold ring-1 ring-white/30 md:h-14 md:w-14">CC</span>
      <% } %>
      <span>
        <span class="block text-xl font-bold leading-tight drop-shadow md:text-2xl"><%= settings.company_name %></span>
        <span class="block text-xs text-white/80 md:text-sm"><%= settings.legal_name %></span>
      </span>
    </a>
    <div class="flex flex-wrap items-center justify-end gap-2 self-end">
      <nav class="inline-flex rounded-lg bg-white/90 p-0.5 text-xs text-slate-700 shadow-sm dark:bg-slate-900/90 dark:text-slate-200" aria-label="Language">
        <% languages.forEach(l => { %>
          <a href="<%= langUrl(l) %>" hreflang="<%= l %>" class="rounded-md px-2 py-1 font-semibold <%= l === lang ? 'bg-brand-600 text-white' : 'hover:bg-slate-100 dark:hover:bg-slate-800' %>"><%= l.toUpperCase() %></a>
        <% }) %>
      </nav>
      <%- include('../partials/theme-switch') %>
    </div>
  </div>
</header>
