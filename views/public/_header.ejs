<% const langNames = { vi: 'Tiếng Việt', en: 'English', ru: 'Русский', zh: '中文' }; %>
<%# Cụm điều khiển: ngôn ngữ (dropdown cờ) + giao diện (icon) %>
<% const controls = () => { %>
  <div class="flex shrink-0 items-center gap-1.5">
    <div x-data="{ open: false }" class="relative text-xs text-slate-700 dark:text-slate-200" @click.outside="open = false" @keydown.escape="open = false">
      <button type="button" @click="open = !open" :aria-expanded="open" aria-haspopup="listbox" aria-label="Language"
              class="flex h-8 items-center gap-1.5 rounded-lg border border-slate-300 bg-white/90 px-2 font-semibold shadow-sm hover:bg-white dark:border-slate-700 dark:bg-slate-900/90 dark:hover:bg-slate-900">
        <img src="/img/flags/<%= lang %>.svg" alt="" class="h-3 w-[18px] rounded-[2px] object-cover ring-1 ring-black/10">
        <span><%= lang.toUpperCase() %></span>
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 opacity-60 transition" :class="open && 'rotate-180'"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/></svg>
      </button>
      <ul x-show="open" x-cloak x-transition.origin.top.right role="listbox"
          class="absolute right-0 z-50 mt-1 w-36 overflow-hidden rounded-lg border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
        <% languages.forEach(l => { %>
          <li role="option" aria-selected="<%= l === lang %>">
            <a href="<%= langUrl(l) %>" hreflang="<%= l %>" class="flex items-center gap-2 px-2.5 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 <%= l === lang ? 'font-semibold text-brand-600' : '' %>">
              <img src="/img/flags/<%= l %>.svg" alt="" class="h-3 w-[18px] rounded-[2px] object-cover ring-1 ring-black/10"><%= langNames[l] %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
    <%- include('../partials/theme-icons') %>
  </div>
<% } %>

<% if (bannerList.length) { %>
  <%# Có banner: thanh mỏng trên cùng + banner hiển thị trọn vẹn đúng tỉ lệ ảnh %>
  <header class="pb-2 md:pb-4">
    <div class="mx-auto flex h-12 max-w-7xl items-center justify-between gap-3 px-4">
      <a href="/" class="flex min-w-0 items-center gap-2">
        <% if (settings.logo_url) { %><img src="<%= settings.logo_url %>" alt="" class="h-8 w-8 shrink-0 rounded-md object-contain"><% } %>
        <span class="truncate text-sm font-bold"><%= settings.company_name %></span>
      </a>
      <% controls() %>
    </div>
    <h1 class="sr-only"><%= settings.company_name %> — <%= settings.legal_name %></h1>
    <% if (bannerList.length === 1) { %>
      <a href="/" class="mx-auto block max-w-5xl md:px-4">
        <img src="<%= bannerList[0] %>" alt="<%= settings.company_name %>" class="block h-auto w-full md:rounded-xl md:shadow-md">
      </a>
    <% } else { %>
      <%# Trình chiếu: các ảnh chồng cùng 1 ô lưới, đổi độ mờ; tự chuyển 5s, dừng khi rê chuột, vuốt trên điện thoại %>
      <div class="mx-auto max-w-5xl md:px-4">
        <div x-data="{ i: 0, n: <%= bannerList.length %>, t: null, x0: null,
                       go(k) { this.i = (k + this.n) % this.n },
                       start() { clearInterval(this.t); this.t = setInterval(() => this.go(this.i + 1), 5000) },
                       stop() { clearInterval(this.t) } }"
             x-init="start()" @mouseenter="stop()" @mouseleave="start()"
             @touchstart.passive="x0 = $event.touches[0].clientX; stop()"
             @touchend="if (x0 !== null) { const d = $event.changedTouches[0].clientX - x0; if (Math.abs(d) > 40) go(i + (d < 0 ? 1 : -1)); x0 = null } start()"
             class="group relative grid overflow-hidden md:rounded-xl md:shadow-md" role="region" aria-roledescription="carousel" aria-label="Banner">
          <% bannerList.forEach((b, k) => { %>
            <img src="<%= b %>" alt="<%= settings.company_name %>" <%= k ? 'loading="lazy"' : '' %>
                 class="col-start-1 row-start-1 block h-auto w-full transition-opacity duration-700"
                 :class="i === <%= k %> ? 'opacity-100' : 'pointer-events-none opacity-0'" :aria-hidden="i !== <%= k %>">
          <% }) %>
          <button type="button" @click="go(i - 1); start()" aria-label="Banner trước"
                  class="absolute left-2 top-1/2 hidden h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-black/30 text-white opacity-0 transition hover:bg-black/50 group-hover:opacity-100 md:grid">‹</button>
          <button type="button" @click="go(i + 1); start()" aria-label="Banner sau"
                  class="absolute right-2 top-1/2 hidden h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-black/30 text-white opacity-0 transition hover:bg-black/50 group-hover:opacity-100 md:grid">›</button>
          <div class="absolute inset-x-0 bottom-1.5 flex justify-center gap-1.5 md:bottom-2.5">
            <% bannerList.forEach((b, k) => { %>
              <button type="button" @click="go(<%= k %>); start()" aria-label="Banner <%= k + 1 %>"
                      class="h-1.5 rounded-full shadow transition-all md:h-2" :class="i === <%= k %> ? 'w-5 bg-white md:w-6' : 'w-1.5 bg-white/60 md:w-2'"></button>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>
  </header>
<% } else { %>
  <%# Chưa có banner: header màu thương hiệu %>
  <header class="relative bg-gradient-to-br from-brand-700 via-brand-600 to-sky-500 text-white">
    <div class="mx-auto flex h-32 max-w-7xl items-start justify-between gap-3 px-4 py-3 md:h-40">
      <a href="/" class="flex min-w-0 items-center gap-3 self-end">
        <% if (settings.logo_url) { %>
          <img src="<%= settings.logo_url %>" alt="<%= settings.company_name %>" class="h-12 w-auto rounded-lg bg-white/90 p-1 md:h-14">
        <% } else { %>
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/15 text-lg font-bold ring-1 ring-white/30 md:h-14 md:w-14">CC</span>
        <% } %>
        <span>
          <span class="block text-xl font-bold leading-tight drop-shadow md:text-2xl"><%= settings.company_name %></span>
          <span class="block text-xs text-white/80 md:text-sm"><%= settings.legal_name %></span>
        </span>
      </a>
      <% controls() %>
    </div>
  </header>
<% } %>
