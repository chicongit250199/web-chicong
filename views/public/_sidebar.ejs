<%# Menubar trái: PC thu gọn còn icon, hover mở rộng (đè lên nội dung, không xô lệch bố cục) %>
<aside class="group fixed inset-y-0 left-0 z-40 hidden w-16 flex-col border-r border-slate-200 bg-white/95 shadow-sm backdrop-blur transition-[width] duration-200 hover:w-60 hover:shadow-xl md:flex dark:border-slate-800 dark:bg-slate-900/95">
  <a href="/" class="flex h-14 shrink-0 items-center gap-3 overflow-hidden border-b border-slate-200 px-5 dark:border-slate-800 <%= path === '/' ? 'text-brand-600' : '' %>">
    <%- icon('home', 'h-6 w-6 shrink-0') %>
    <span class="whitespace-nowrap text-sm font-semibold opacity-0 transition-opacity group-hover:opacity-100"><%= t('nav.home') %></span>
  </a>
  <nav class="flex-1 overflow-y-auto overflow-x-hidden py-2">
    <% categories.forEach(c => { %>
      <a href="/c/<%= c.id %>" title="<%= field(c, 'name') %>"
         class="flex items-center gap-3 px-5 py-3 text-slate-600 hover:bg-brand-50 hover:text-brand-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white <%= path === '/c/' + c.id ? 'bg-brand-50 text-brand-700 dark:bg-slate-800 dark:text-white' : '' %>">
        <%- icon(c.icon, 'h-6 w-6 shrink-0') %>
        <span class="whitespace-nowrap text-sm font-medium opacity-0 transition-opacity group-hover:opacity-100"><%= field(c, 'name') %></span>
      </a>
    <% }) %>
  </nav>
  <a href="/login" class="flex h-14 shrink-0 items-center gap-3 overflow-hidden border-t border-slate-200 px-5 text-brand-600 hover:bg-brand-50 dark:border-slate-800 dark:hover:bg-slate-800">
    <%- icon('login', 'h-6 w-6 shrink-0') %>
    <span class="whitespace-nowrap text-sm font-semibold opacity-0 transition-opacity group-hover:opacity-100"><%= t('nav.login') %></span>
  </a>
</aside>

<%# Mobile: thanh điều hướng dưới + drawer danh mục %>
<div x-data="{ open: false }" class="md:hidden">
  <nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-4 border-t border-slate-200 bg-white/95 pb-[env(safe-area-inset-bottom)] text-[11px] font-medium backdrop-blur dark:border-slate-800 dark:bg-slate-900/95">
    <a href="/" class="flex flex-col items-center gap-0.5 py-2 <%= path === '/' ? 'text-brand-600' : 'text-slate-600 dark:text-slate-300' %>"><%- icon('home', 'h-5 w-5') %><%= t('nav.home') %></a>
    <button type="button" @click="open = true" class="flex flex-col items-center gap-0.5 py-2 text-slate-600 dark:text-slate-300"><%- icon('grid', 'h-5 w-5') %><%= t('nav.categories') %></button>
    <a href="<%= contact.zalo %>" target="_blank" rel="noopener" class="flex flex-col items-center gap-0.5 py-2 text-slate-600 dark:text-slate-300"><%- icon('chat', 'h-5 w-5') %>Zalo</a>
    <a href="/login" class="flex flex-col items-center gap-0.5 py-2 text-brand-600"><%- icon('login', 'h-5 w-5') %><%= t('nav.login') %></a>
  </nav>
  <div x-show="open" x-cloak x-transition.opacity class="fixed inset-0 z-50 bg-slate-950/50" @click="open = false"></div>
  <aside x-show="open" x-cloak x-transition:enter="transition duration-200" x-transition:enter-start="-translate-x-full" x-transition:leave="transition duration-150" x-transition:leave-end="-translate-x-full"
         class="fixed inset-y-0 left-0 z-50 flex w-72 max-w-[85vw] flex-col bg-white shadow-xl dark:bg-slate-900" @keydown.escape.window="open = false">
    <div class="flex h-14 items-center justify-between border-b border-slate-200 px-4 dark:border-slate-800">
      <span class="font-semibold"><%= t('nav.categories') %></span>
      <button type="button" @click="open = false" class="rounded-lg p-2 hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Close"><%- icon('x', 'h-5 w-5') %></button>
    </div>
    <nav class="flex-1 overflow-y-auto py-2">
      <% categories.forEach(c => { %>
        <a href="/c/<%= c.id %>" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-100 dark:hover:bg-slate-800"><%- icon(c.icon, 'h-5 w-5 text-brand-600') %><span class="text-sm font-medium"><%= field(c, 'name') %></span></a>
      <% }) %>
    </nav>
  </aside>
</div>
