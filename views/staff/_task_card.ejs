<% const st = fmt.status(t.status); const al = typeof alertOf === 'function' ? alertOf(t) : null; %>
<a href="/staff/tasks/<%= t.id %>" class="block rounded-xl border bg-white p-3 shadow-sm transition hover:shadow-md dark:bg-slate-900 <%= !al ? 'border-slate-200 hover:border-brand-400 dark:border-slate-800' : al.kind === 'pending' ? 'border-red-300 ring-1 ring-red-200 dark:border-red-800 dark:ring-red-900' : 'border-orange-300 ring-1 ring-orange-200 dark:border-orange-800 dark:ring-orange-900' %>">
  <% if (al) { %>
    <p class="-mx-3 -mt-3 mb-2 flex items-center gap-1.5 rounded-t-xl px-3 py-1.5 text-xs font-semibold <%= al.kind === 'pending' ? 'bg-red-50 text-red-700 dark:bg-red-950/60 dark:text-red-300' : 'bg-orange-50 text-orange-700 dark:bg-orange-950/60 dark:text-orange-300' %>"><%- icon('alert', 'h-3.5 w-3.5') %><%= al.label %></p>
  <% } %>
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <p class="truncate font-semibold"><%= t.device_model %></p>
      <p class="text-xs text-slate-500"><%= t.ticket_code %> · <%= fmt.datetime(t.created_at) %></p>
    </div>
    <span class="flex shrink-0 flex-col items-end gap-1"><span class="<%= st.cls %>"><%= st.label %></span><% if (t.partner_name) { %><span class="badge-violet"><%= t.partner_name %></span><% } %></span>
  </div>
  <p class="mt-2 line-clamp-2 text-sm text-slate-600 dark:text-slate-300"><%= t.issue_desc %></p>
  <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
    <span class="flex items-center gap-1"><%- icon('phone', 'h-3.5 w-3.5') %><%= [t.customer_name, t.customer_phone].filter(Boolean).join(' · ') || 'Khách lẻ' %></span>
    <% if (t.assigned_name) { %><span class="flex items-center gap-1"><%- icon('userCheck', 'h-3.5 w-3.5') %><%= t.assigned_name %></span><% } %>
    <% if (t.expected_return_date) { %>
      <span class="flex items-center gap-1 <%= t.expected_return_date < fmt.todayYmd() && ['pending','processing'].includes(t.status) ? 'font-semibold text-red-600' : '' %>"><%- icon('clock', 'h-3.5 w-3.5') %>Hẹn <%= fmt.date(t.expected_return_date) %></span>
    <% } %>
    <% if (t.estimated_price) { %><span><%= fmt.money(t.estimated_price) %></span><% } %>
  </div>
</a>
