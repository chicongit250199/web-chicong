<%- include('../app/_top') %>
<div class="page-title">
  <h1><%- icon(typeof returnMode !== 'undefined' ? 'checkCircle' : 'list', 'h-6 w-6 text-brand-600') %><%= title %> <span class="text-base font-normal text-slate-500">(<%= tasks.length %>)</span></h1>
  <form class="flex w-full gap-2 sm:w-auto">
    <% if (typeof returnMode === 'undefined') { %><input type="hidden" name="view" value="<%= view %>"><% } %>
    <input name="q" value="<%= search %>" class="input sm:w-72" placeholder="SĐT, Model máy, mã phiếu..." autofocus>
    <button class="btn-primary"><%- icon('search', 'h-4 w-4') %></button>
  </form>
</div>
<% if (typeof returnMode === 'undefined') { %>
  <div class="tabs">
    <% [['pending','Chưa làm'],['assigned','Được giao'],['processing','Đang làm'],['overdue','⚠ Quá hạn'],['ready','Chờ trả máy'],['completed','Đã trả'],['all','Tất cả']].forEach(([k, l]) => { %>
      <a href="?view=<%= k %><%= search ? '&q=' + encodeURIComponent(search) : '' %>" class="tab <%= view === k ? 'tab-active' : '' %>"><%= l %></a>
    <% }) %>
  </div>
<% } else { %>
  <p class="mb-3 text-sm text-slate-500">Các máy đã sửa xong hoặc không sửa được, đang chờ khách nhận. Bấm vào máy để <strong>Hoàn thành</strong> hoặc <strong>Sửa lại</strong>.</p>
<% } %>
<div class="grid gap-2 md:grid-cols-2">
  <% tasks.forEach(t => { %><%- partial('staff/_task_card', { t, fmt, icon, alertOf }) %><% }) %>
</div>
<% if (!tasks.length) { %><p class="card py-12 text-center text-sm text-slate-500"><%= search ? 'Không tìm thấy task phù hợp.' : 'Không có task nào.' %></p><% } %>
<%- include('../app/_bottom') %>
