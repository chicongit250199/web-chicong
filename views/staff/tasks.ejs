<%- include('../app/_top') %>
<div class="page-title">
  <h1><%- icon('list', 'h-6 w-6 text-brand-600') %><%= title %> <span class="text-base font-normal text-slate-500">(<%= tasks.length %>)</span></h1>
  <form class="flex w-full flex-wrap gap-2 sm:w-auto">
    <input type="hidden" name="view" value="<%= view %>">
    <input name="q" value="<%= search %>" class="input min-w-0 flex-1 sm:w-72 sm:flex-none" placeholder="SĐT, Model máy, mã phiếu..." autofocus>
    <button class="btn-primary"><%- icon('search', 'h-4 w-4') %></button>
    <label class="flex w-full items-center gap-2 text-sm sm:w-auto"><span class="shrink-0 text-slate-500">Sắp xếp</span>
      <select name="sort" class="input py-2 sm:w-auto" x-on:change="$el.form.submit()">
        <% Object.entries(sorts).filter(([k]) => k !== 'completed_new' || view === 'completed' || view === 'all').forEach(([k, [label]]) => { %>
          <option value="<%= k %>" <%= sort === k ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select></label>
  </form>
</div>
<%- include('_task_tabs') %>
<div class="grid gap-2 md:grid-cols-2 xl:grid-cols-3">
  <% tasks.forEach(t => { %><%- partial('staff/_task_card', { t, fmt, icon, alertOf }) %><% }) %>
</div>
<% if (!tasks.length) { %><p class="card py-12 text-center text-sm text-slate-500"><%= search ? 'Không tìm thấy task phù hợp.' : 'Không có task nào.' %></p><% } %>
<%- include('../app/_bottom') %>
