<%- include('../app/_top') %>
<div class="page-title">
  <h1><%- icon('archive', 'h-6 w-6 text-brand-600') %>Kho hàng</h1>
  <a href="/staff/inventory/new" class="btn-primary"><%- icon('plusSquare', 'h-4 w-4') %>Nhập kho</a>
</div>
<div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4">
  <div class="stat"><p class="stat-label">Tồn kho</p><p class="stat-value"><%= fmt.num(counts.in_stock || 0) %></p></div>
  <div class="stat"><p class="stat-label">Đã bán</p><p class="stat-value"><%= fmt.num(counts.sold || 0) %></p></div>
  <div class="stat"><p class="stat-label">Giá trị tồn (giá KT)</p><p class="stat-value text-lg"><%= fmt.money(stockValue.tech) %></p></div>
  <div class="stat"><p class="stat-label">Giá trị tồn (bán lẻ)</p><p class="stat-value text-lg"><%= fmt.money(stockValue.retail) %></p></div>
</div>
<div class="tabs">
  <a href="?tab=in_stock<%= search ? '&q=' + encodeURIComponent(search) : '' %>" class="tab <%= tab === 'in_stock' ? 'tab-active' : '' %>">Kho hàng tồn kho (<%= counts.in_stock || 0 %>)</a>
  <a href="?tab=sold<%= search ? '&q=' + encodeURIComponent(search) : '' %>" class="tab <%= tab === 'sold' ? 'tab-active' : '' %>">Kho hàng đã bán (<%= counts.sold || 0 %>)</a>
</div>
<form class="mb-3 flex gap-2">
  <input type="hidden" name="tab" value="<%= tab %>">
  <input name="q" value="<%= search %>" class="input" placeholder="Tên hàng, mã hàng, Serial, NPP<%= tab === 'sold' ? ', khách hàng, SĐT' : '' %>...">
  <button class="btn-primary"><%- icon('search', 'h-4 w-4') %></button>
</form>
<% const canDel = tab === 'in_stock' || isManager; const backUrl = `/staff/inventory?tab=${tab}${search ? '&q=' + encodeURIComponent(search) : ''}${page > 1 ? '&page=' + page : ''}`; %>
<div @keydown.escape.window="ed = null" x-data="{ ed: null, sel: [], all: <%= JSON.stringify(items.map(i => i.id)) %>,
               toggleAll(e) { this.sel = e.target.checked ? [...this.all] : [] },
               ask(ids, label) {
                 const msg = 'Xóa ' + label + ' khỏi kho?<%= tab === 'sold' ? '\\nDoanh thu của các lần bán vẫn được giữ, chỉ xóa bản ghi trong kho.' : '' %>\nKhông thể hoàn tác.';
                 if (!confirm(msg)) return;
                 const f = $refs.delForm; f.querySelectorAll('input[name=ids]').forEach(x => x.remove());
                 ids.forEach(id => { const i = document.createElement('input'); i.type = 'hidden'; i.name = 'ids'; i.value = id; f.appendChild(i); });
                 f.submit();
               } }">
  <form method="post" action="/staff/inventory/delete" x-ref="delForm" class="hidden">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= backUrl %>">
  </form>
  <% if (canDel) { %>
    <div x-show="sel.length" x-cloak x-transition class="sticky top-16 z-20 mb-2 flex items-center justify-between gap-3 rounded-lg bg-slate-900 px-4 py-2.5 text-sm text-white shadow-lg dark:bg-slate-100 dark:text-slate-900">
      <span x-text="'Đã chọn ' + sel.length + ' món'"></span>
      <span class="flex gap-2">
        <button type="button" @click="sel = []" class="rounded-md px-3 py-1 hover:bg-white/10 dark:hover:bg-black/10">Bỏ chọn</button>
        <button type="button" @click="ask(sel, sel.length + ' món đã chọn')" class="flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1 font-semibold text-white hover:bg-red-700"><%- icon('trash', 'h-4 w-4') %>Xóa</button>
      </span>
    </div>
  <% } %>
  <div class="tbl-wrap">
    <table class="tbl inv-tbl">
      <thead><tr>
        <% if (canDel) { %><th class="w-8"><input type="checkbox" class="h-4 w-4" @change="toggleAll($event)" :checked="sel.length && sel.length === all.length" aria-label="Chọn tất cả"></th><% } %>
        <th class="w-24">Mã hàng</th><th>Tên hàng</th><th class="text-right" title="<%= tab === 'sold' ? 'Số lượng cùng mã hàng còn trong kho' : 'Số lượng cùng mã hàng đang tồn kho' %>">SL<%= tab === 'sold' ? ' còn' : '' %></th><th>Serial</th><th title="Ngày nhập">Nhập</th><th>Tình trạng</th><th>NPP</th><th title="Bảo hành nhập (tháng)">BH N</th>
        <th class="text-right">Giá KT</th><th class="text-right">Giá bán lẻ</th><th title="Bảo hành xuất (tháng)">BH X</th>
        <% if (tab === 'sold') { %><th>Ngày bán</th><th>Khách hàng</th><th>Hết BH</th><% } %><th>Ghi chú</th>
        <% if (canDel) { %><th></th><% } %>
      </tr></thead>
      <tbody>
        <% items.forEach(i => { %>
          <tr :class="sel.includes(<%= i.id %>) && 'is-sel'">
            <% if (canDel) { %><td><input type="checkbox" class="h-4 w-4" value="<%= i.id %>" x-model.number="sel" aria-label="Chọn"></td><% } %>
            <td class="max-w-[6rem] truncate text-xs" title="<%= i.item_code %>"><%= i.item_code %></td>
            <td class="min-w-40 font-medium"><span class="line-clamp-2" title="<%= i.name %>"><%= i.name %></span></td>
            <% const qty = tab === 'sold' ? (i.item_code ? i.same_count : null) : i.same_count + 1; %>
            <td class="whitespace-nowrap text-right font-semibold tabular-nums <%= qty === 0 ? 'text-red-600' : qty === 1 ? 'text-amber-600' : '' %>"><%= qty == null ? '' : qty %></td>
            <td class="max-w-[7.5rem] truncate font-mono text-[11px]" title="<%= i.serial || '' %>"><%= i.serial || '' %></td>
            <td class="whitespace-nowrap text-xs" title="<%= fmt.date(i.import_date) %>"><%= fmt.dateShort(i.import_date) %></td>
            <td class="text-xs"><%= i.condition || '' %></td>
            <td class="max-w-[11rem] truncate text-sm" title="<%= i.supplier || '' %>"><%= i.supplier || '' %></td>
            <td class="whitespace-nowrap text-xs"><%= i.warranty_in_months != null ? String(i.warranty_in_months).padStart(2, '0') + ' tháng' : '' %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= fmt.num(i.tech_price) %></td>
            <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= fmt.num(i.retail_price) %></td>
            <td class="whitespace-nowrap text-xs"><%= i.warranty_out_months != null ? String(i.warranty_out_months).padStart(2, '0') + ' tháng' : '' %></td>
            <% if (tab === 'sold') { %>
              <td class="whitespace-nowrap text-xs" title="<%= fmt.date(i.sold_date) %>"><%= fmt.dateShort(i.sold_date) %></td>
              <td><%= i.customer_name || '' %><br><span class="text-xs text-slate-500"><%= i.customer_phone || '' %></span></td>
              <td class="whitespace-nowrap"><% if (i.warranty_end) { %><span class="<%= i.warranty_end >= today ? 'badge-green' : 'badge-gray' %>" title="<%= fmt.date(i.warranty_end) %>"><%= fmt.dateShort(i.warranty_end) %></span><% } %></td>
            <% } %>
            <td class="max-w-[10rem] truncate text-xs text-slate-500" title="<%= i.note || '' %>"><%= i.note || '' %></td>
            <% if (canDel) { %>
              <td class="whitespace-nowrap text-right"><% if (i.status === 'in_stock') { %><a href="/staff/sell?item=<%= i.id %>"
                class="inline-grid h-8 w-8 place-items-center rounded-lg text-slate-400 hover:bg-emerald-50 hover:text-emerald-600 dark:hover:bg-slate-800" title="Bán"><%- icon('cart', 'h-4 w-4') %></a><% } %><button type="button" @click="ed = <%= JSON.stringify({ id: i.id, item_code: i.item_code || '', name: i.name, serial: i.serial || '', import_date: i.import_date || '', condition: i.condition || '', supplier: i.supplier || '', warranty_in_months: i.warranty_in_months ?? '', tech_price: i.tech_price ?? '', retail_price: i.retail_price ?? '', warranty_out_months: i.warranty_out_months ?? '', note: i.note || '', status: i.status, sold_date: i.sold_date || '', customer_name: i.customer_name || '', customer_phone: i.customer_phone || '', same: i.same_count, qty: i.nos_count ?? '' }) %>"
                class="inline-grid h-8 w-8 place-items-center rounded-lg text-slate-400 hover:bg-brand-50 hover:text-brand-600 dark:hover:bg-slate-800" title="Sửa"><%- icon('edit', 'h-4 w-4') %></button><button type="button" @click="ask([<%= i.id %>], <%= JSON.stringify((i.name + (i.serial ? ' (SN ' + i.serial + ')' : '')).slice(0, 80)) %>)"
                class="inline-grid h-8 w-8 place-items-center rounded-lg text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950" title="Xóa"><%- icon('trash', 'h-4 w-4') %></button></td>
            <% } %>
          </tr>
        <% }) %>
        <% if (!items.length) { %><tr><td colspan="17" class="py-10 text-center text-slate-500">Không có hàng hóa</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <%# Popup sửa hàng %>
  <template x-if="ed">
    <div class="modal-backdrop" @click.self="ed = null">
      <form method="post" :action="'/staff/inventory/' + ed.id + '/edit'" class="modal max-w-2xl space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= backUrl %>">
        <div class="flex items-center justify-between"><h3 class="text-lg font-semibold">Sửa hàng trong kho</h3>
          <span :class="ed.status === 'sold' ? 'badge-violet' : 'badge-green'" x-text="ed.status === 'sold' ? 'Đã bán' : 'Tồn kho'"></span></div>
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="block"><span class="label">Mã hàng</span><input name="item_code" x-model="ed.item_code" class="input uppercase" maxlength="64"></label>
          <label class="block sm:col-span-2"><span class="label req">Tên hàng hóa</span><input name="name" x-model="ed.name" class="input" required maxlength="300"></label>
          <label class="block"><span class="label">Serial</span><input name="serial" x-model="ed.serial" class="input font-mono"></label>
          <label class="block"><span class="label">Ngày nhập</span><input type="date" name="import_date" x-model="ed.import_date" class="input"></label>
          <label class="block"><span class="label">Tình trạng</span><input name="condition" x-model="ed.condition" list="conds" class="input"></label>
          <label class="block"><span class="label">NPP</span><input name="supplier" x-model="ed.supplier" class="input"></label>
          <label class="block"><span class="label">BH nhập (tháng)</span><input type="number" min="0" name="warranty_in_months" x-model="ed.warranty_in_months" class="input"></label>
          <label class="block"><span class="label">BH xuất (tháng)</span><input type="number" min="0" name="warranty_out_months" x-model="ed.warranty_out_months" class="input"></label>
          <label class="block"><span class="label">Giá KT (₫)</span><input name="tech_price" :value="formatVnd(ed.tech_price)" @input="$event.target.value = formatVnd($event.target.value)" inputmode="numeric" class="input text-right tabular-nums"></label>
          <label class="block"><span class="label">Giá bán lẻ (₫)</span><input name="retail_price" :value="formatVnd(ed.retail_price)" @input="$event.target.value = formatVnd($event.target.value)" inputmode="numeric" class="input text-right font-semibold tabular-nums"></label>
          <label class="block sm:col-span-3"><span class="label">Ghi chú</span><input name="note" x-model="ed.note" class="input"></label>
          <template x-if="ed.status === 'in_stock' && !ed.serial && ed.qty !== ''">
            <label class="block rounded-lg bg-amber-50 p-3 sm:col-span-3 dark:bg-amber-950/30"><span class="label">Số lượng tồn (hàng không serial, cùng mã hàng)</span>
              <span class="flex flex-wrap items-center gap-3"><input type="number" min="0" max="500" name="quantity" x-model.number="ed.qty" class="input w-28 text-right font-semibold">
                <span class="text-xs text-slate-600 dark:text-slate-300">Tăng: thêm món giống món này · Giảm: xóa bớt các món cùng mã · 0 = hết hàng</span></span></label>
          </template>
        </div>
        <datalist id="conds"><option value="Mới"><option value="Cũ"><option value="Like new"><option value="Đã qua sử dụng"></datalist>
        <% if (isManager) { %>
          <template x-if="ed.status === 'sold'">
            <div class="grid gap-3 rounded-lg bg-violet-50 p-3 sm:grid-cols-3 dark:bg-violet-950/30">
              <label class="block"><span class="label">Ngày bán</span><input type="date" name="sold_date" x-model="ed.sold_date" class="input"></label>
              <label class="block"><span class="label">Khách hàng</span><input name="customer_name" x-model="ed.customer_name" class="input"></label>
              <label class="block"><span class="label">SĐT khách</span><input name="customer_phone" x-model="ed.customer_phone" class="input" inputmode="tel"></label>
            </div>
          </template>
        <% } %>
        <label x-show="ed.status === 'in_stock' && ed.same > 0" class="flex items-start gap-2 rounded-lg bg-slate-50 p-3 text-sm dark:bg-slate-800/50">
          <input type="checkbox" name="apply_same" value="1" class="mt-0.5 h-4 w-4">
          <span>Áp dụng <strong>tên, giá, bảo hành</strong> cho <strong x-text="ed.same"></strong> món khác cùng mã hàng đang tồn kho</span>
        </label>
        <div class="flex justify-end gap-2 pt-1"><button type="button" @click="ed = null" class="btn-secondary">Hủy</button><button class="btn-primary"><%- icon('check', 'h-4 w-4') %>Lưu</button></div>
      </form>
    </div>
  </template>
</div>
<% if (pages > 1) { %>
  <nav class="mt-4 flex flex-wrap items-center justify-center gap-1 text-sm">
    <% const link = p => `?tab=${tab}&page=${p}${search ? '&q=' + encodeURIComponent(search) : ''}`; %>
    <% if (page > 1) { %><a href="<%= link(page - 1) %>" class="btn-secondary px-3 py-1.5">‹</a><% } %>
    <span class="px-3">Trang <%= page %> / <%= pages %> · <%= fmt.num(total) %> món</span>
    <% if (page < pages) { %><a href="<%= link(page + 1) %>" class="btn-secondary px-3 py-1.5">›</a><% } %>
  </nav>
<% } %>
<%- include('../app/_bottom') %>
