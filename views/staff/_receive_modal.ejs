<%# Popup nhập kho cho món "Hàng đặt". Đặt BÊN TRONG phần tử có x-data chứa receiveStock() (public/js/pc-parts.js) %>
<template x-if="rc">
  <div class="modal-backdrop" @click.self="rc = null" @keydown.escape.window="rc = null">
    <form class="modal space-y-3" @submit.prevent="submitReceive()">
      <h3 class="flex items-center gap-2 text-lg font-semibold"><%- icon('plusSquare', 'h-5 w-5 text-brand-600') %>Nhập kho hàng đã về</h3>
      <div class="rounded-lg bg-slate-50 px-3 py-2 text-sm dark:bg-slate-800/60">
        <p class="font-medium" x-text="rc.name + (rc.condition ? ' (' + rc.condition + ')' : '')"></p>
        <p class="text-xs text-slate-500" x-text="'Giá bán: ' + (rc.price != null ? formatVnd(rc.price) + ' ₫' : 'chưa có') + ' · BH xuất: ' + (rc.warranty_months != null ? rc.warranty_months + ' tháng' : '—') + ' (lấy từ báo giá)'"></p>
      </div>
      <label class="block"><span class="label">Số Serial <span class="font-normal text-slate-400">(mỗi dòng 1 cái — bỏ trống nếu không có serial)</span></span>
        <textarea x-model="serials" rows="3" class="input font-mono" placeholder="SN001&#10;SN002"></textarea></label>
      <div class="grid grid-cols-2 gap-3">
        <label class="block"><span class="label">Số lượng</span>
          <input type="number" min="1" max="500" x-model.number="quantity" class="input" :disabled="serialCount > 0" :value="serialCount > 0 ? serialCount : quantity"></label>
        <label class="block"><span class="label">Ngày nhập</span><input type="date" x-model="import_date" class="input"></label>
        <label class="block"><span class="label">Nhà cung cấp</span><input x-model="supplier" class="input" autocomplete="off"></label>
        <label class="block"><span class="label">Giá nhập (₫)</span><input class="input text-right tabular-nums" inputmode="numeric" :value="techDisplay" @input="onTech($event)"></label>
      </div>
      <p x-show="rcErr" class="text-sm text-red-600" x-text="rcErr"></p>
      <div class="flex justify-end gap-2 pt-1">
        <button type="button" @click="rc = null" class="btn-secondary">Hủy</button>
        <button class="btn-primary" :disabled="rcBusy"><span x-text="rcBusy ? 'Đang lưu...' : 'Nhập ' + (serialCount || quantity) + ' cái vào kho'"></span></button>
      </div>
    </form>
  </div>
</template>
