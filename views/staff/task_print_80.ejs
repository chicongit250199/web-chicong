<%# Phiếu nhận máy khổ 80mm (máy in bill). Mẫu A4/A5: task_print.ejs %>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8"><meta name="csrf-token" content="<%= csrfToken %>"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Phiếu <%= task.ticket_code %></title>
  <%- include('_slip80_style') %>
</head>
<body>
  <div class="actions"><button type="button" id="print-server-btn" class="primary">🖨 In ra máy in cửa hàng</button><label class="copies">Số bản <input type="number" id="print-server-copies" min="1" max="20" value="1"></label> <a href="?">Mẫu A5</a><div id="print-server-msg" class="psmsg"></div></div>
  <div class="slip">
    <%- include('_slip80_head', { title: 'PHIẾU NHẬN MÁY', code: task.ticket_code, createdAt: task.created_at, en: false }) %>
    <div class="hr"></div>
    <div class="row"><span class="k">Khách hàng</span><span class="v b"><%= task.customer_name || 'Khách lẻ' %></span></div>
    <% if (task.customer_phone) { %><div class="row"><span class="k">SĐT</span><span class="v b"><%= task.customer_phone %></span></div><% } %>
    <div class="row"><span class="k">Model máy</span><span class="v big"><%= task.device_model %></span></div>
    <% if (task.specs) { %><div class="row"><span class="k">Cấu hình</span><span class="v"><%= task.specs %></span></div><% } %>
    <div class="row"><span class="k">Lỗi</span><span class="v"><%= task.issue_desc %></span></div>
    <div class="row"><span class="k">Phụ kiện</span><span class="v"><%= task.accessories || 'Không' %></span></div>
    <div class="row"><span class="k">Báo giá</span><span class="v"><%= task.estimated_price != null ? fmt.money(task.estimated_price) : 'Báo sau khi kiểm tra' %></span></div>
    <% if (task.expected_return_date) { %><div class="row"><span class="k">Hẹn trả</span><span class="v b"><%= fmt.date(task.expected_return_date) %></span></div><% } %>
    <% if (task.received_name) { %><div class="row"><span class="k">NV nhận</span><span class="v"><%= task.received_name %></span></div><% } %>
    <div class="hr"></div>
    <div class="note">Quý khách vui lòng mang theo phiếu này khi nhận máy. Cửa hàng không chịu trách nhiệm dữ liệu nếu không được thông báo trước.</div>
    <div class="sign"><div>Khách hàng<div class="sp"></div></div><div>Nhân viên nhận<div class="sp"></div></div></div>
  </div>
  <script src="/js/print-server.js" defer></script>
</body>
</html>
