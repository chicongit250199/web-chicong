<%- include('../app/_top') %>
<div class="page-title"><h1><%- icon('cart', 'h-6 w-6 text-brand-600') %>Bán hàng / Dịch vụ</h1></div>
<div class="grid gap-4 lg:grid-cols-5" x-data="sellForm(<%= JSON.stringify(user.full_name) %>, <%= JSON.stringify(preset || null) %>, <%= JSON.stringify(build || null) %>)">
  <div class="space-y-4 lg:col-span-3">
    <div x-show="success" x-cloak class="flex items-center gap-2 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-emerald-200 dark:bg-emerald-950 dark:text-emerald-200 dark:ring-emerald-900"><%- icon('checkCircle', 'h-5 w-5') %><span class="flex-1" x-text="success"></span>
      <a x-show="receipt" :href="receipt" target="_blank" class="btn-primary px-3 py-1.5 text-sm"><%- icon('printer', 'h-4 w-4') %>In phiếu</a></div>
    <div x-show="error" x-cloak class="flex items-center gap-2 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200 dark:bg-red-950 dark:text-red-200 dark:ring-red-900"><%- icon('alert', 'h-5 w-5') %><span x-text="error"></span></div>

    <div x-show="buildId" x-cloak class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-blue-50 px-4 py-3 text-sm text-blue-800 ring-1 ring-blue-200 dark:bg-blue-950 dark:text-blue-200 dark:ring-blue-900">
      <span><%- icon('desktop', 'mr-1 inline h-4 w-4') %>Chốt bán cấu hình <strong x-text="buildCode"></strong>: món có trong kho đã chọn sẵn serial (đổi được), món chưa có ghi là hàng ngoài kho<% if (build && build.discount) { %>, giảm giá <%= fmt.money(build.discount) %> đã chia vào đơn giá từng món<% } %>.</span>
      <a :href="'/staff/build/' + buildId" class="font-semibold underline">Quay lại cấu hình</a>
    </div>
    <form class="card space-y-4" @submit.prevent="openConfirm()">
      <div class="relative" @click.outside="open = false">
        <label class="block"><span class="label req">Tên hàng hóa / dịch vụ</span>
          <input x-model="q" @input="search()" @keydown.arrow-down.prevent="move(1)" @keydown.arrow-up.prevent="move(-1)" @keydown.enter.prevent="choose()" @focus="results.length && (open = true)"
                 x-ref="q" class="input" placeholder="Gõ tên hàng / serial để chọn từ kho, hoặc gõ tên dịch vụ (VD: Cài Windows)" autocomplete="off" autofocus></label>
        <p class="mt-1 text-xs" :class="group ? 'text-emerald-600' : free ? 'text-amber-600' : 'text-slate-500'"
           x-text="group ? 'Hàng trong kho — sẽ trừ kho khi bán' : free ? 'Không chọn từ kho → ghi doanh thu như dịch vụ / hàng ngoài kho (không trừ kho)' : 'Chọn từ gợi ý để trừ kho, hoặc gõ tự do cho dịch vụ'"></p>
        <div x-show="open" x-cloak class="absolute z-20 mt-1 max-h-80 w-full overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900">
          <template x-for="(g, i) in results" :key="g.item_code + g.name">
            <button type="button" @click="choose(g)" @mouseenter="hi = i" class="flex w-full items-center justify-between gap-3 px-3 py-2 text-left text-sm" :class="hi === i && 'bg-brand-50 dark:bg-slate-800'">
              <span class="min-w-0"><span class="block truncate font-medium" x-text="g.name"></span><span class="block text-xs text-slate-500" x-text="g.item_code"></span></span>
              <span class="shrink-0 text-right"><span class="block font-semibold tabular-nums" x-text="g.retail_price != null ? formatVnd(g.retail_price) + ' ₫' : '—'"></span><span class="badge-green" x-text="'Còn ' + g.qty"></span></span>
            </button>
          </template>
          <p x-show="!results.length && !loading" class="px-3 py-3 text-sm text-slate-500">Không có trong kho — cứ nhập tiếp, sẽ ghi như <strong>dịch vụ / hàng ngoài kho</strong></p>
        </div>
      </div>

      <template x-if="group && hasSerials">
        <label class="block"><span class="label req">Số Serial</span>
          <select x-model="unitId" @change="applyUnit()" class="input" required>
            <option value="" x-text="'— Chọn Serial (còn ' + freeUnits.length + ') —'"></option>
            <template x-for="u in freeUnits" :key="u.id"><option :value="u.id" x-text="(u.serial || '(không serial)') + (u.condition ? ' · ' + u.condition : '') + (u.retail_price != null ? ' · ' + formatVnd(u.retail_price) + ' ₫' : '')"></option></template>
          </select></label>
      </template>

      <fieldset x-show="free" x-cloak><legend class="label">Loại</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30"><input type="radio" x-model="kind" value="repair"><%- icon('wrench', 'h-4 w-4') %>Dịch vụ / sửa chữa</label>
          <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30"><input type="radio" x-model="kind" value="sale"><%- icon('box', 'h-4 w-4') %>Bán hàng ngoài kho</label>
        </div></fieldset>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block"><span class="label req">Giá tiền (₫)</span>
          <input class="input text-right text-lg font-semibold tabular-nums" inputmode="numeric" :value="priceDisplay" @input="onPrice($event)" required></label>
        <label class="block"><span class="label">Bảo hành (tháng)</span>
          <select x-model="warranty" class="input"><option value="" x-text="group ? 'Theo kho' : 'Không bảo hành'"></option><% [0,1,3,6,9,12,24,36].forEach(w => { %><option value="<%= w %>"><%= w %> tháng</option><% }) %></select></label>
      </div>
      <div class="flex justify-end">
        <button type="button" @click="addLine()" class="btn-secondary"><%- icon('plusSquare', 'h-4 w-4') %>Thêm vào đơn</button>
      </div>

      <div x-show="cart.length" x-cloak class="rounded-lg border border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between border-b border-slate-200 px-3 py-2 text-sm font-semibold dark:border-slate-800">
          <span x-text="'Đơn hàng (' + cart.length + ' món)'"></span><span class="tabular-nums text-red-600" x-text="formatVnd(total) + ' ₫'"></span></div>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800">
          <template x-for="(l, i) in cart" :key="i">
            <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
              <span class="min-w-0"><span class="block truncate font-medium" x-text="l.name"></span>
                <span class="block text-xs text-slate-500" x-text="(l.item_id ? 'Trong kho' : (l.kind === 'repair' ? 'Dịch vụ' : 'Ngoài kho')) + (l.serial ? ' · SN: ' + l.serial : '') + ' · BH ' + l.warrantyShow + ' th'"></span>
                <select x-show="unitChoices(l).length > 1" x-cloak class="input mt-1 w-auto py-0.5 text-xs" :value="l.item_id" @change="changeUnit(l, $event.target.value)">
                  <template x-for="u in unitChoices(l)" :key="u.id"><option :value="u.id" :selected="u.id === l.item_id" x-text="u.serial || ('Món #' + u.id)"></option></template>
                </select></span>
              <span class="flex shrink-0 items-center gap-2"><span class="font-semibold tabular-nums" x-text="formatVnd(l.price) + ' ₫'"></span>
                <button type="button" @click="removeLine(i)" class="rounded p-1 text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950" title="Bỏ món"><%- icon('x', 'h-4 w-4') %></button></span>
            </li>
          </template>
        </ul>
      </div>
      <fieldset><legend class="label">Hình thức thanh toán</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30"><input type="radio" x-model="payment" value="cash"><%- icon('cash', 'h-4 w-4') %>Tiền mặt</label>
          <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30"><input type="radio" x-model="payment" value="transfer"><%- icon('bank', 'h-4 w-4') %>Chuyển khoản</label>
        </div></fieldset>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block"><span class="label">Tên khách hàng</span><input x-model="customer_name" class="input" autocomplete="off"></label>
        <label class="block"><span class="label">SĐT khách hàng</span><input x-model="customer_phone" class="input" inputmode="tel" autocomplete="off"></label>
      </div>
      <label class="block sm:w-1/2"><span class="label">Ngày bán <span class="font-normal text-slate-400">(để trống = hôm nay)</span></span>
        <input type="date" x-model="sale_date" :max="today" class="input"></label>
      <label class="block"><span class="label">Địa chỉ <span class="font-normal text-slate-400">(Giao hàng)</span></span>
        <input x-model="delivery_address" class="input" placeholder="Chỉ nhập khi cần giao hàng"></label>
      <div class="flex justify-end gap-2 border-t border-slate-200 pt-4 dark:border-slate-800">
        <button type="button" @click="reset(); error = ''; success = ''" class="btn-secondary">Hủy</button>
        <button class="btn-primary"><%- icon('cart', 'h-4 w-4') %><span x-text="cart.length ? (draft || group ? 'Bán (' + (cart.length + 1) + ' món)' : 'Bán (' + cart.length + ' món)') : (free && kind === 'repair' ? 'Thu tiền dịch vụ' : 'Bán hàng')"></span></button>
      </div>
    </form>
  </div>

  <aside class="lg:col-span-2">
    <h2 class="mb-2 font-semibold">Bán gần đây</h2>
    <ul class="card divide-y divide-slate-100 p-0 dark:divide-slate-800">
      <% recent.forEach(r => { %>
        <li class="relative px-4 py-2.5 pr-12 text-sm"><span class="absolute right-3 top-2.5"><a href="/staff/sell/receipt/<%= r.order_code || r.id %>" target="_blank" class="inline-grid h-7 w-7 place-items-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-brand-600 dark:hover:bg-slate-800 " title="In phiếu"><%- icon('printer', 'h-4 w-4') %></a></span><% r.lines.forEach(c => { %><p class="font-medium"><%= c %></p><% }) %>
          <p class="text-xs text-slate-500"><%= fmt.datetime(r.created_at) %> · <%= r.staff_name %> · <strong class="text-slate-700 dark:text-slate-300"><%= fmt.money(r.amount) %></strong> · <%= fmt.payment(r.payment_method) %></p></li>
      <% }) %>
      <% if (!recent.length) { %><li class="px-4 py-6 text-center text-sm text-slate-500">Chưa có giao dịch</li><% } %>
    </ul>
  </aside>

  <template x-if="confirm">
    <div class="modal-backdrop" @click.self="confirm = false" @keydown.escape.window="confirm = false">
      <div class="modal space-y-3">
        <h3 class="text-lg font-semibold" x-text="allService ? 'Xác nhận thu tiền dịch vụ' : 'Xác nhận bán hàng'"></h3>
        <dl class="divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm dark:divide-slate-800 dark:border-slate-800">
          <template x-for="(l, i) in cart" :key="i">
            <div class="flex justify-between gap-3 px-3 py-2"><dt class="min-w-0"><span class="block font-medium" x-text="l.name"></span>
              <span class="block text-xs text-slate-500" x-text="(l.item_id ? 'Trong kho' : (l.kind === 'repair' ? 'Dịch vụ' : 'Ngoài kho')) + (l.serial ? ' · SN: ' + l.serial : '') + ' · BH ' + l.warrantyShow + ' tháng'"></span></dt>
              <dd class="shrink-0 tabular-nums" x-text="formatVnd(l.price) + ' ₫'"></dd></div>
          </template>
          <div class="flex justify-between gap-3 px-3 py-2"><dt class="text-slate-500" x-text="cart.length > 1 ? 'Tổng cộng' : 'Giá tiền'"></dt><dd class="text-lg font-bold text-red-600" x-text="formatVnd(total) + ' ₫'"></dd></div>
          <div class="flex justify-between gap-3 px-3 py-2"><dt class="text-slate-500">Thanh toán</dt><dd x-text="payment === 'cash' ? 'Tiền mặt' : 'Chuyển khoản'"></dd></div>
                    <div class="flex justify-between gap-3 px-3 py-2"><dt class="text-slate-500">Khách hàng</dt><dd class="text-right" x-text="(customer_name || '—') + (customer_phone ? ' · ' + customer_phone : '')"></dd></div>
          <div class="flex justify-between gap-3 px-3 py-2" x-show="delivery_address"><dt class="text-slate-500">Giao hàng</dt><dd class="text-right" x-text="delivery_address"></dd></div>
          <div class="flex justify-between gap-3 px-3 py-2"><dt class="text-slate-500">Nhân viên</dt><dd class="font-medium" x-text="staffName"></dd></div>
          <div class="flex justify-between gap-3 px-3 py-2"><dt class="text-slate-500">Thời gian</dt><dd :class="sale_date && sale_date !== today && 'font-semibold text-amber-600'" x-text="sale_date && sale_date !== today ? 'Ngày ' + sale_date.split('-').reverse().join('/') + ' (ghi lùi)' : confirmTime"></dd></div>
        </dl>
        <div class="flex justify-end gap-2 pt-1">
          <button type="button" @click="confirm = false" class="btn-secondary">Quay lại sửa</button>
          <button type="button" @click="submit()" :disabled="sending" class="btn-primary"><span x-text="sending ? 'Đang lưu...' : 'Xác nhận bán'"></span></button>
        </div>
      </div>
    </div>
  </template>
</div>
<%- include('../app/_bottom') %>
