<%# Thẻ "Kiểm tra cấu hình máy" ở trang chi tiết task. pcReports: [{ ...row, d: data JSON, history: [...] }] %>
<% const arr = x => Array.isArray(x) ? x : (x && typeof x === 'object' ? [x] : []); %>
<section class="card" x-data="pcPick('task', <%= task.id %>)">
  <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex items-center gap-2 font-semibold"><%- icon('cpu', 'h-5 w-5 text-brand-600') %>Kiểm tra cấu hình máy</h2>
    <button type="button" @click="show()" class="btn-secondary px-3 py-1.5 text-sm"><%- icon('plusSquare', 'h-4 w-4') %>Gắn báo cáo kiểm tra</button>
  </div>
  <% if (!pcReports.length) { %>
    <p class="text-sm text-slate-500">Chưa có. Chạy <b>Kiểm tra cấu hình máy</b> trên máy khách (link /<%= settings.shel_path || 'shel' %>) rồi bấm “Gắn báo cáo kiểm tra”.</p>
  <% } %>
  <% pcReports.forEach(r => { const d = r.d || {}; %>
    <div class="mt-3 rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-700" x-data="{ more: false }">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="font-semibold"><%= r.model || 'Không rõ model' %></span>
        <span class="text-xs text-slate-500">Kiểm tra lúc <%= fmt.datetime(r.created_at) %><%= r.computer_name ? ' · ' + r.computer_name : '' %></span>
      </div>
      <p class="mt-1 whitespace-pre-line text-slate-700 dark:text-slate-300"><%= r.summary %></p>
      <button type="button" @click="more = !more" class="mt-1 text-xs text-brand-600 hover:underline" x-text="more ? 'Ẩn chi tiết' : 'Xem chi tiết'"></button>
      <div x-show="more" x-cloak class="mt-2 grid gap-3 text-xs sm:grid-cols-2">
        <% if (arr(d.disks).length) { %><div><p class="font-semibold">Ổ cứng</p><ul class="mt-1 space-y-1">
          <% arr(d.disks).forEach(k => { %><li><%= k.name %> · <%= k.sizeGB %> GB · <%= [k.media, k.bus].filter(Boolean).join(' ') %>
            <br><span class="text-slate-500">Sức khỏe: <b class="<%= k.healthPct == null ? '' : k.healthPct < 50 ? 'text-red-600' : k.healthPct < 80 ? 'text-amber-600' : 'text-emerald-600' %>"><%= k.healthPct != null ? k.healthPct + '%' : 'không có dữ liệu' %></b><%= k.temp ? ' · ' + k.temp + '°C' : '' %><%= k.hours ? ' · đã chạy ' + Number(k.hours).toLocaleString('vi-VN') + ' giờ' : '' %> · <%= k.status || '' %></span></li><% }) %>
        </ul></div><% } %>
        <% if (d.ram && arr(d.ram.modules).length) { %><div><p class="font-semibold">RAM (<%= arr(d.ram.modules).length %>/<%= d.ram.slots || '?' %> khe)</p><ul class="mt-1 space-y-0.5">
          <% arr(d.ram.modules).forEach(m => { %><li><%= m.slot %>: <%= m.gb %> GB <%= m.type %> <%= m.mhz %>MHz <span class="text-slate-500"><%= m.maker || '' %></span></li><% }) %>
        </ul></div><% } %>
        <% if (arr(d.volumes).length) { %><div><p class="font-semibold">Phân vùng</p><ul class="mt-1 space-y-0.5">
          <% arr(d.volumes).forEach(v => { %><li><%= v.drive %> trống <%= v.freeGB %> / <%= v.totalGB %> GB</li><% }) %>
        </ul></div><% } %>
        <div><p class="font-semibold">Khác</p><ul class="mt-1 space-y-0.5">
          <% if (d.board) { %><li>Mainboard: <%= d.board %></li><% } %>
          <% if (d.bios) { %><li>BIOS: <%= d.bios %></li><% } %>
          <% if (d.battery && d.battery.designCap) { %><li>Pin: <%= Number(d.battery.fullCap).toLocaleString('vi-VN') %> / <%= Number(d.battery.designCap).toLocaleString('vi-VN') %> mWh (chai <%= Math.round(d.battery.wearPct) %>%)</li><% } %>
          <% if (d.battery && (d.battery.model || d.battery.cycles)) { %><li>Model pin: <%= d.battery.model || '—' %><%= d.battery.maker ? ' (' + d.battery.maker + ')' : '' %> · số lần sạc: <%= d.battery.cycles ? Number(d.battery.cycles).toLocaleString('vi-VN') : 'máy không báo' %></li><% } %>
          <% arr(d.nets).forEach(n => { %><li>Mạng: <%= n.desc || n.name %> · <%= n.speed || '' %> · MAC <%= n.mac || '' %></li><% }) %>
        </ul></div>
      </div>
      <% if (r.history.length) { %>
        <div class="mt-2 rounded-lg bg-amber-50 p-2 text-xs dark:bg-amber-950/30">
          <p class="font-semibold text-amber-800 dark:text-amber-300">Máy này (cùng S/N <%= r.serial %>) đã kiểm tra trước đây:</p>
          <% r.history.forEach(h => { %>
            <details class="mt-1"><summary class="cursor-pointer"><a href="/staff/tasks/<%= h.task_id %>" class="text-brand-600 hover:underline"><%= h.ticket_code %></a> · <%= fmt.datetime(h.created_at) %></summary>
              <p class="mt-1 whitespace-pre-line text-slate-600 dark:text-slate-300"><%= h.summary %></p></details>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% }) %>
  <%- include('_pc_pick') %>
</section>
