<%- include('../app/_top') %>
<% const st = fmt.status(task.status); const nowStr = fmt.datetime(new Date().toISOString()); %>
<div x-data="{ m: null }" @keydown.escape.window="m = null">
  <div class="page-title">
    <h1><%- icon('wrench', 'h-6 w-6 text-brand-600') %><%= task.ticket_code %> <span class="<%= st.cls %> text-sm"><%= st.label %></span><% if (task.partner_name) { %><a href="/staff/partners?p=<%= task.partner_id %>" class="badge-violet text-sm hover:underline">Đối tác: <%= task.partner_name %></a><% } %></h1>
    <div class="flex gap-2">
      <a href="/staff/tasks/<%= task.id %>/print" target="_blank" class="btn-secondary"><%- icon('receipt', 'h-4 w-4') %>In phiếu</a>
      <% const payRev = task.status === 'completed' && revenues.find(r => r.order_code); if (payRev) { %><a href="/staff/sell/receipt/<%= payRev.order_code %>" target="_blank" class="btn-secondary"><%- icon('printer', 'h-4 w-4') %>Phiếu thanh toán</a><% } %>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <section class="card">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h2 class="font-semibold">Thông tin máy</h2>
          <% if (canEdit) { %><button type="button" @click="m = 'edit'" class="btn-secondary px-3 py-1.5 text-sm"><%- icon('edit', 'h-4 w-4') %>Sửa thông tin</button><% } %>
        </div>
        <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
          <div><dt class="text-slate-500">Model</dt><dd class="font-semibold"><%= task.device_model %></dd></div>
          <div><dt class="text-slate-500">Khách hàng</dt><dd class="font-medium"><%= task.customer_name || '—' %><% if (task.customer_phone) { %> · <a class="text-brand-600 hover:underline" href="tel:<%= task.customer_phone %>"><%= task.customer_phone %></a><% } %></dd></div>
          <div class="sm:col-span-2"><dt class="text-slate-500">Mô tả lỗi</dt><dd class="whitespace-pre-line"><%= task.issue_desc %></dd></div>
          <% if (task.specs) { %><div class="sm:col-span-2"><dt class="text-slate-500">Cấu hình</dt><dd class="whitespace-pre-line"><%= task.specs %></dd></div><% } %>
          <div><dt class="text-slate-500">Báo giá dự kiến</dt><dd><%= task.estimated_price != null ? fmt.money(task.estimated_price) : '—' %></dd></div>
          <div><dt class="text-slate-500">Ngày trả dự kiến</dt><dd><%= task.expected_return_date ? fmt.date(task.expected_return_date) : '—' %></dd></div>
          <div><dt class="text-slate-500">Phụ kiện</dt><dd><%= task.accessories || '—' %></dd></div>
          <div><dt class="text-slate-500">Nhận lúc</dt><dd><%= fmt.datetime(task.created_at) %><%= task.received_name ? ' · ' + task.received_name : '' %></dd></div>
          <% if (task.note) { %><div class="sm:col-span-2"><dt class="text-slate-500">Ghi chú</dt><dd class="whitespace-pre-line"><%= task.note %></dd></div><% } %>
        </dl>
      </section>

      <% if (['done','unrepairable','completed'].includes(task.status)) { %>
        <section class="card">
          <h2 class="mb-3 font-semibold">Kết quả sửa chữa</h2>
          <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
            <div><dt class="text-slate-500">KTV xử lý</dt><dd class="font-medium"><%= task.technician_name || '—' %></dd></div>
            <div><dt class="text-slate-500">Cập nhật lúc</dt><dd><%= fmt.datetime(task.updated_at) %></dd></div>
            <% if (task.fail_reason) { %><div class="sm:col-span-2"><dt class="text-slate-500">Lý do không sửa được</dt><dd class="font-medium text-red-600"><%= task.fail_reason %></dd></div><% } %>
            <% if (task.repair_detail) { %><div class="sm:col-span-2"><dt class="text-slate-500">Chi tiết lỗi</dt><dd class="whitespace-pre-line"><%= task.repair_detail %></dd></div><% } %>
            <% if (task.replaced_parts) { %><div class="sm:col-span-2"><dt class="text-slate-500">Vị trí sửa / linh kiện thay</dt><dd class="whitespace-pre-line"><%= task.replaced_parts %></dd></div><% } %>
            <div><dt class="text-slate-500">Giá tiền</dt><dd class="font-semibold"><%= fmt.money(task.final_price || 0) %></dd></div>
            <% if (task.status === 'completed') { %>
              <div><dt class="text-slate-500">Thanh toán</dt><dd><%= fmt.payment(task.payment_method || (revenues[0] && revenues[0].payment_method)) %> · BH <%= task.warranty_months || 0 %> tháng</dd></div>
              <div><dt class="text-slate-500">Trả máy lúc</dt><dd><%= fmt.datetime(task.completed_at) %></dd></div>
              <% if (extras.length) { %>
                <div class="sm:col-span-2"><dt class="text-slate-500">Bán kèm khi trả máy</dt><dd>
                  <ul class="mt-1 divide-y divide-slate-100 rounded-lg border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
                    <% extras.forEach(x => { %><li class="flex justify-between gap-3 px-3 py-1.5"><span><%= x.content %> <span class="text-xs text-slate-500">· BH <%= x.warranty_months || 0 %> th</span></span><span class="shrink-0 tabular-nums"><%= fmt.money(x.amount) %></span></li><% }) %>
                  </ul>
                  <p class="mt-1 text-right font-semibold">Tổng thu: <%= fmt.money((task.final_price || 0) + extras.reduce((s, x) => s + x.amount, 0)) %></p>
                </dd></div>
              <% } %>
            <% } %>
          </dl>
        </section>
      <% } %>

      <% if (histories.length) { %>
        <section class="card">
          <h2 class="mb-3 font-semibold">Lịch sử các lần sửa trước</h2>
          <ol class="space-y-3">
            <% histories.forEach(h => { %>
              <li class="rounded-lg border border-slate-200 p-3 text-sm dark:border-slate-800">
                <p class="flex flex-wrap items-center gap-2 font-medium">Lần <%= h.attempt_no %> <span class="<%= fmt.status(h.status).cls %>"><%= fmt.status(h.status).label %></span>
                  <span class="text-xs font-normal text-slate-500"><%= h.technician_name || '' %> · lưu <%= fmt.datetime(h.recorded_at) %></span></p>
                <% if (h.repair_detail) { %><p class="mt-1"><span class="text-slate-500">Chi tiết:</span> <%= h.repair_detail %></p><% } %>
                <% if (h.replaced_parts) { %><p><span class="text-slate-500">Thay:</span> <%= h.replaced_parts %></p><% } %>
                <% if (h.fail_reason) { %><p class="text-red-600"><span class="text-slate-500">Lý do:</span> <%= h.fail_reason %></p><% } %>
                <% if (h.price != null) { %><p><span class="text-slate-500">Giá:</span> <%= fmt.money(h.price) %></p><% } %>
                <% if (h.note) { %><p class="whitespace-pre-line text-slate-600 dark:text-slate-400"><%= h.note %></p><% } %>
              </li>
            <% }) %>
          </ol>
        </section>
      <% } %>
    </div>

    <%# ---- Cột hành động ---- %>
    <aside class="space-y-4">
      <section class="card space-y-3">
        <h2 class="font-semibold">Thao tác</h2>
        <% if (task.assigned_name) { %><p class="text-sm text-slate-500">Phụ trách: <strong class="text-slate-800 dark:text-slate-200"><%= task.assigned_name %></strong></p><% } %>

        <% if (task.status === 'pending') { %>
          <% if (canWork) { %>
            <button type="button" @click="m = 'start'" class="btn-primary w-full"><%- icon('wrench', 'h-4 w-4') %>Xử lý</button>
          <% } else { %>
            <p class="rounded-lg bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-950 dark:text-amber-200">Task đã giao cho <%= task.assigned_name %>.</p>
          <% } %>
        <% } else if (task.status === 'processing') { %>
          <% if (canWork) { %>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" @click="m = 'fail'" class="btn-danger"><%- icon('x', 'h-4 w-4') %>Không sửa được</button>
              <button type="button" @click="m = 'done'" class="btn bg-emerald-600 text-white hover:bg-emerald-700"><%- icon('check', 'h-4 w-4') %>Xong</button>
            </div>
          <% } else { %>
            <p class="rounded-lg bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-950 dark:text-amber-200"><%= task.assigned_name %> đang sửa máy này.</p>
          <% } %>
        <% } else if (['done','unrepairable'].includes(task.status)) { %>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" @click="m = 'redo'" class="btn-secondary"><%- icon('refresh', 'h-4 w-4') %>Sửa lại</button>
            <button type="button" @click="m = 'complete'" class="btn-primary"><%- icon('checkCircle', 'h-4 w-4') %>Hoàn thành</button>
          </div>
        <% } else { %>
          <p class="text-sm text-slate-500">Đã trả máy cho khách.</p>
          <% revenues.forEach(r => { %><p class="text-sm">Đã thu <strong><%= fmt.money(r.amount) %></strong> (<%= fmt.payment(r.payment_method) %>) · <%= r.staff_name %></p><% }) %>
        <% } %>
      </section>

      <% if (canDelete) { %>
        <button type="button" @click="m = 'delete'" class="flex w-full items-center justify-center gap-2 rounded-lg border border-red-200 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 dark:border-red-900 dark:hover:bg-red-950">
          <%- icon('trash', 'h-4 w-4') %><%= task.status === 'completed' ? 'Xóa máy đã trả' : 'Xóa task' %></button>
      <% } %>

      <% if (isManager && ['pending','processing'].includes(task.status)) { %>
        <form method="post" action="/manager/assign" class="card space-y-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="task_id" value="<%= task.id %>">
          <input type="hidden" name="back" value="/staff/tasks/<%= task.id %>">
          <label class="block"><span class="label">Giao cho nhân viên</span>
            <select name="user_id" class="input">
              <option value="">— Chưa giao —</option>
              <% staffList.forEach(s => { %><option value="<%= s.id %>" <%= s.id === task.assigned_to ? 'selected' : '' %>><%= s.full_name %></option><% }) %>
            </select></label>
          <button class="btn-secondary w-full"><%- icon('userCheck', 'h-4 w-4') %>Lưu phân công</button>
        </form>
      <% } %>
    </aside>
  </div>

  <%# ================= POPUP ================= %>
  <% if (canEdit) { %>
  <template x-if="m === 'edit'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/staff/tasks/<%= task.id %>/edit" class="modal max-w-2xl space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="flex items-center gap-2 text-lg font-semibold"><%- icon('edit', 'h-5 w-5') %>Sửa thông tin <%= task.ticket_code %></h3>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block"><span class="label">Tên khách hàng</span>
            <input name="customer_name" value="<%= task.customer_name || '' %>" class="input" maxlength="120" autocomplete="off"></label>
          <label class="block"><span class="label">SĐT khách hàng</span>
            <input name="customer_phone" value="<%= task.customer_phone || '' %>" class="input" inputmode="tel" pattern="[0-9+ .]{8,20}" autocomplete="off"></label>
        </div>
        <label class="block"><span class="label req">Model máy / linh kiện</span>
          <input name="device_model" value="<%= task.device_model %>" class="input" required maxlength="200" autocomplete="off"></label>
        <label class="block"><span class="label">Cấu hình</span>
          <textarea name="specs" rows="2" class="input"><%= task.specs || '' %></textarea></label>
        <label class="block"><span class="label req">Mô tả lỗi</span>
          <textarea name="issue_desc" rows="3" class="input" required><%= task.issue_desc %></textarea></label>
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="block" x-data="moneyInput('<%= task.estimated_price ?? '' %>')"><span class="label">Báo giá dự kiến (₫)</span>
            <input class="input text-right tabular-nums" inputmode="numeric" :value="display" @input="onInput($event)">
            <input type="hidden" name="estimated_price" :value="raw"></label>
          <label class="block"><span class="label">Ngày trả dự kiến</span>
            <input type="date" name="expected_return_date" value="<%= task.expected_return_date || '' %>" class="input"></label>
          <label class="block"><span class="label">Phụ kiện đi kèm</span>
            <input name="accessories" value="<%= task.accessories || '' %>" class="input"></label>
        </div>
        <label class="block"><span class="label">Ghi chú</span>
          <input name="note" value="<%= task.note || '' %>" class="input"></label>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-primary"><%- icon('check', 'h-4 w-4') %>Lưu thay đổi</button></div>
      </form>
    </div>
  </template>
  <% } %>
  <template x-if="m === 'start'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/staff/tasks/<%= task.id %>/start" class="modal space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-lg font-semibold">Xác nhận xử lý</h3>
        <p class="text-sm">Bạn sẽ nhận sửa <strong><%= task.device_model %></strong> (<%= task.ticket_code %>). Task chuyển sang <strong>Đang sửa</strong>.</p>
        <div class="flex justify-end gap-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-primary">Xác nhận</button></div>
      </form>
    </div>
  </template>

  <template x-if="m === 'done'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/staff/tasks/<%= task.id %>/done" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-lg font-semibold text-emerald-700 dark:text-emerald-400">Sửa xong</h3>
        <label class="block"><span class="label">Chi tiết lỗi</span><textarea name="repair_detail" rows="3" class="input"></textarea></label>
        <label class="block"><span class="label">Vị trí sửa chữa / linh kiện đã thay</span><textarea name="replaced_parts" rows="2" class="input"></textarea></label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class="label">KTV xử lý</span><input class="input bg-slate-50 dark:bg-slate-800/50" value="<%= user.full_name %>" disabled></label>
          <label class="block"><span class="label">Thời gian</span><input class="input bg-slate-50 dark:bg-slate-800/50" value="<%= nowStr %>" disabled></label>
        </div>
        <label class="block" x-data="moneyInput('<%= task.estimated_price ?? '' %>')"><span class="label">Giá tiền (₫)</span>
          <input class="input text-right text-lg font-semibold tabular-nums" inputmode="numeric" :value="display" @input="onInput($event)">
          <input type="hidden" name="final_price" :value="raw"></label>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn bg-emerald-600 text-white hover:bg-emerald-700">Lưu</button></div>
      </form>
    </div>
  </template>

  <template x-if="m === 'fail'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/staff/tasks/<%= task.id %>/fail" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-lg font-semibold text-red-600">Không sửa được</h3>
        <label class="block"><span class="label req">Lý do</span><textarea name="fail_reason" rows="3" class="input" required></textarea></label>
        <label class="block"><span class="label">Ghi chú</span><textarea name="note" rows="2" class="input"></textarea></label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class="label">KTV</span><input class="input bg-slate-50 dark:bg-slate-800/50" value="<%= user.full_name %>" disabled></label>
          <label class="block"><span class="label">Thời gian</span><input class="input bg-slate-50 dark:bg-slate-800/50" value="<%= nowStr %>" disabled></label>
        </div>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-danger">Lưu</button></div>
      </form>
    </div>
  </template>

  <template x-if="m === 'complete'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/staff/tasks/<%= task.id %>/complete" class="modal max-w-2xl space-y-3" x-data="completeForm(<%= task.status === 'unrepairable' ? 0 : (task.final_price ?? 0) %>)" @submit="beforeSubmit($event)">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="extra_items" :value="extraJson">
        <h3 class="text-lg font-semibold">Hoàn thành — trả máy cho khách</h3>
        <p class="text-sm text-slate-500"><%= task.device_model %> · <%= task.customer_name || '' %> <%= task.customer_phone %></p>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class="label">Tiền sửa máy (₫)</span>
            <input class="input text-right text-lg font-semibold tabular-nums" inputmode="numeric" :value="amountDisplay" @input="onAmount($event)">
            <input type="hidden" name="amount" :value="amount"></label>
          <label class="block"><span class="label">Bảo hành sửa chữa</span>
            <select name="warranty_months" class="input"><% warrantyOptions.forEach(w => { %><option value="<%= w %>" <%= w === (task.status === 'unrepairable' ? 0 : 3) ? 'selected' : '' %>><%= w %> tháng</option><% }) %></select></label>
        </div>

        <%# ---- Bán kèm hàng / dịch vụ (trừ kho, ghi doanh thu chung phiếu) ---- %>
        <fieldset class="space-y-2 rounded-lg border border-slate-200 p-3 dark:border-slate-800">
          <legend class="px-1 text-sm font-semibold">Bán kèm hàng / dịch vụ <span class="font-normal text-slate-400">(không bắt buộc)</span></legend>
          <div class="relative" @click.outside="open = false">
            <input x-model="q" x-ref="q" @input="search()" @keydown.arrow-down.prevent="move(1)" @keydown.arrow-up.prevent="move(-1)" @keydown.enter.prevent="open && results.length ? choose() : addLine()" @focus="results.length && (open = true)"
                   class="input" placeholder="Gõ tên hàng / serial (VD: chuột LM106) hoặc tên dịch vụ" autocomplete="off">
            <p class="mt-1 text-xs" :class="group ? 'text-emerald-600' : free ? 'text-amber-600' : 'text-slate-500'"
               x-text="group ? 'Hàng trong kho — sẽ trừ kho' : free ? 'Không chọn từ kho → ghi doanh thu, không trừ kho' : 'Chọn từ gợi ý để trừ kho'"></p>
            <div x-show="open" x-cloak class="absolute z-20 mt-1 max-h-64 w-full overflow-y-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:bg-slate-900">
              <template x-for="(g, i) in results" :key="g.item_code + g.name">
                <button type="button" @click="choose(g)" @mouseenter="hi = i" class="flex w-full items-center justify-between gap-3 px-3 py-2 text-left text-sm" :class="hi === i && 'bg-brand-50 dark:bg-slate-800'">
                  <span class="min-w-0"><span class="block truncate font-medium" x-text="g.name"></span><span class="block text-xs text-slate-500" x-text="g.item_code"></span></span>
                  <span class="shrink-0 text-right"><span class="block font-semibold tabular-nums" x-text="g.retail_price != null ? formatVnd(g.retail_price) + ' ₫' : '—'"></span><span class="badge-green" x-text="'Còn ' + g.qty"></span></span>
                </button>
              </template>
              <p x-show="!results.length && !loading" class="px-3 py-3 text-sm text-slate-500">Không có trong kho — sẽ ghi như <strong>dịch vụ / hàng ngoài kho</strong></p>
            </div>
          </div>
          <template x-if="group && hasSerials">
            <select x-model="unitId" @change="applyUnit()" class="input">
              <option value="" x-text="'— Chọn Serial (còn ' + freeUnits.length + ') —'"></option>
              <template x-for="u in freeUnits" :key="u.id"><option :value="u.id" x-text="(u.serial || '(không serial)') + (u.condition ? ' · ' + u.condition : '') + (u.retail_price != null ? ' · ' + formatVnd(u.retail_price) + ' ₫' : '')"></option></template>
            </select>
          </template>
          <div x-show="free" x-cloak class="flex gap-4 text-sm">
            <label class="flex items-center gap-1.5"><input type="radio" x-model="kind" value="sale">Hàng ngoài kho</label>
            <label class="flex items-center gap-1.5"><input type="radio" x-model="kind" value="repair">Dịch vụ</label>
          </div>
          <div class="flex flex-wrap items-end gap-2" x-show="q.trim() || group" x-cloak>
            <label class="block min-w-[8rem] flex-1"><span class="label">Giá (₫)</span>
              <input class="input text-right font-semibold tabular-nums" inputmode="numeric" :value="priceDisplay" @input="onPrice($event)" @keydown.enter.prevent="addLine()"></label>
            <label class="block w-36"><span class="label">Bảo hành</span>
              <select x-model="warranty" class="input"><option value="" x-text="group ? 'Theo kho' : 'Không BH'"></option><% [0,1,3,6,9,12,24,36].forEach(w => { %><option value="<%= w %>"><%= w %> tháng</option><% }) %></select></label>
            <button type="button" @click="addLine()" class="btn-secondary"><%- icon('plusSquare', 'h-4 w-4') %>Thêm</button>
          </div>
          <p x-show="error" x-cloak class="text-xs text-red-600" x-text="error"></p>
          <ul x-show="cart.length" x-cloak class="divide-y divide-slate-100 rounded-lg border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
            <template x-for="(l, i) in cart" :key="i">
              <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
                <span class="min-w-0"><span class="block truncate font-medium" x-text="l.name"></span>
                  <span class="block text-xs text-slate-500" x-text="(l.item_id ? 'Trong kho' : (l.kind === 'repair' ? 'Dịch vụ' : 'Ngoài kho')) + (l.serial ? ' · SN: ' + l.serial : '') + ' · BH ' + l.warrantyShow + ' th'"></span></span>
                <span class="flex shrink-0 items-center gap-2"><span class="font-semibold tabular-nums" x-text="formatVnd(l.price) + ' ₫'"></span>
                  <button type="button" @click="removeLine(i)" class="rounded p-1 text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950" title="Bỏ món"><%- icon('x', 'h-4 w-4') %></button></span>
              </li>
            </template>
          </ul>
        </fieldset>

        <fieldset><legend class="label">Hình thức thanh toán</legend>
          <div class="grid grid-cols-3 gap-2">
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30"><input type="radio" name="payment_method" value="cash" x-model="pay"><%- icon('cash', 'h-4 w-4') %>Tiền mặt</label>
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30"><input type="radio" name="payment_method" value="transfer" x-model="pay"><%- icon('bank', 'h-4 w-4') %>Chuyển khoản</label>
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 p-3 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30"><input type="radio" name="payment_method" value="debt" x-model="pay"><%- icon('receipt', 'h-4 w-4') %>Công nợ</label>
          </div>
          <%# Công nợ: trả trước 1 phần (trống = nợ hết); đối tác tự gộp vào công nợ đối tác %>
          <div x-show="pay === 'debt'" x-cloak class="mt-2 grid gap-2 rounded-lg border border-amber-300 bg-amber-50 p-3 sm:grid-cols-2 dark:border-amber-800 dark:bg-amber-950/30">
            <label class="block"><span class="label">Khách trả trước <span class="font-normal text-slate-400">(để trống = nợ hết)</span></span>
              <input class="input text-right tabular-nums" inputmode="numeric" :value="paidDisplay" @input="onPaid($event)" placeholder="0">
              <input type="hidden" name="paid_amount" :value="pay === 'debt' ? paid : ''"></label>
            <label class="block"><span class="label">Trả trước bằng</span>
              <select name="paid_method" class="input"><option value="cash">Tiền mặt</option><option value="transfer">Chuyển khoản</option></select></label>
            <p class="text-sm sm:col-span-2">Ghi nợ: <b class="text-red-600 tabular-nums" x-text="formatVnd(debtAmount) + ' ₫'"></b>
              <span class="text-xs text-slate-500"><%= task.partner_id ? '— gộp vào công nợ đối tác' : (task.customer_name || task.customer_phone ? '— theo ' + (task.customer_phone || task.customer_name) : '— phiếu này chưa có tên / SĐT khách, không ghi nợ được') %></span></p>
          </div></fieldset>
        <div class="flex items-center justify-between rounded-lg bg-slate-50 px-3 py-2 text-sm dark:bg-slate-800/50">
          <span class="text-slate-500"><span x-text="cart.length ? 'Tổng thu (sửa máy + ' + cart.length + ' món bán kèm)' : 'Tổng thu'"></span> · <%= nowStr %></span>
          <span class="text-lg font-bold tabular-nums text-red-600" x-text="formatVnd(total) + ' ₫'"></span>
        </div>
        <div class="flex justify-end gap-2 pt-1"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-primary"><%- icon('checkCircle', 'h-4 w-4') %>Xác nhận hoàn thành</button></div>
      </form>
    </div>
  </template>

  <% if (canDelete) { %>
  <template x-if="m === 'delete'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/staff/tasks/<%= task.id %>/delete" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-red-600"><%- icon('trash', 'h-5 w-5') %><%= task.status === 'completed' ? 'Xóa máy đã trả' : 'Xóa task' %></h3>
        <p class="text-sm">Xóa vĩnh viễn phiếu <strong><%= task.ticket_code %></strong> — <%= task.device_model %> (<%= task.customer_name || task.customer_phone || 'khách lẻ' %>)<%= histories.length ? ' cùng ' + histories.length + ' lần sửa trong lịch sử' : '' %>.</p>
        <% if (revenues.length) { %>
          <p class="rounded-lg bg-red-50 p-3 text-sm text-red-800 dark:bg-red-950 dark:text-red-200">Doanh thu <strong><%= fmt.money(revenues.reduce((s, r) => s + r.amount, 0)) %></strong> của máy này cũng sẽ bị xóa khỏi thống kê.</p>
        <% } %>
        <p class="text-xs text-slate-500">Không thể hoàn tác.</p>
        <div class="flex justify-end gap-2 pt-1"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-danger"><%- icon('trash', 'h-4 w-4') %>Xóa</button></div>
      </form>
    </div>
  </template>
  <% } %>

  <template x-if="m === 'redo'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/staff/tasks/<%= task.id %>/redo" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-lg font-semibold">Sửa lại</h3>
        <p class="text-sm">Thông tin lần sửa hiện tại sẽ được lưu vào lịch sử (không xóa), task quay về <strong>Đang sửa</strong>.</p>
        <label class="block"><span class="label">Lý do sửa lại</span><textarea name="note" rows="2" class="input" placeholder="VD: khách báo còn lỗi..."></textarea></label>
        <div class="flex justify-end gap-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-primary">Xác nhận sửa lại</button></div>
      </form>
    </div>
  </template>
</div>
<%- include('../app/_bottom') %>
