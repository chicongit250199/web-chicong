  </main>
</div>

<% if (isManager) { %>
  <%# Cột phải: thông báo real-time (SSE) %>
  <script type="application/json" id="notif-data"><%- JSON.stringify({ items: notifications, unread: unreadCount }).replace(/</g, '\\u003c') %></script>
  <div x-data="notifPanel()" x-init="init()">
    <div x-show="notifs" x-cloak x-transition.opacity class="fixed inset-0 z-50 bg-slate-950/50 xl:hidden" @click="notifs = false"></div>
    <aside :class="notifs ? 'translate-x-0' : 'translate-x-full xl:translate-x-0'"
           class="fixed bottom-0 right-0 top-14 z-50 flex w-80 max-w-[90vw] flex-col border-l border-slate-200 bg-white transition-transform xl:z-30 dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-800">
        <h2 class="flex items-center gap-2 font-semibold"><%- icon('bell', 'h-5 w-5 text-brand-600') %>Thông báo
          <span class="flex items-center gap-1 text-[11px] font-normal" :class="live ? 'text-emerald-600' : 'text-slate-400'">
            <span class="h-2 w-2 rounded-full" :class="live ? 'bg-emerald-500 animate-pulse' : 'bg-slate-300'"></span><span x-text="live ? 'Trực tiếp' : 'Mất kết nối'"></span>
          </span>
        </h2>
        <div class="flex items-center gap-1">
          <button type="button" x-show="unread > 0" @click="markRead()" class="rounded-md px-2 py-1 text-xs text-brand-600 hover:bg-brand-50 dark:hover:bg-slate-800">Đã đọc hết</button>
          <button type="button" @click="notifs = false" class="rounded-md p-1 hover:bg-slate-100 xl:hidden dark:hover:bg-slate-800" aria-label="Đóng"><%- icon('x', 'h-5 w-5') %></button>
        </div>
      </div>
      <ul class="flex-1 divide-y divide-slate-100 overflow-y-auto dark:divide-slate-800">
        <template x-for="n in items" :key="n.id">
          <li>
            <a :href="n.link || '#'" class="flex gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/60" :class="!n.is_read && 'bg-brand-50/60 dark:bg-brand-900/20'">
              <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full text-white" :class="typeColor(n.type)" x-html="typeIcon(n.type)"></span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm leading-snug" x-text="n.message"></span>
                <span class="mt-0.5 block text-xs text-slate-500" x-text="timeAgo(n.created_at)"></span>
              </span>
            </a>
          </li>
        </template>
        <li x-show="!items.length" class="px-4 py-10 text-center text-sm text-slate-500">Chưa có thông báo</li>
      </ul>
    </aside>
    <%# Toast khi có thông báo mới %>
    <div class="pointer-events-none fixed right-4 top-16 z-[60] w-80 max-w-[90vw] space-y-2 xl:right-[21rem]">
      <template x-for="t in toasts" :key="t.id">
        <div x-transition class="pointer-events-auto rounded-lg bg-slate-900 px-4 py-3 text-sm text-white shadow-lg dark:bg-white dark:text-slate-900" x-text="t.message"></div>
      </template>
    </div>
  </div>
<% } %>
</div>
<%- include('../partials/foot') %>
