<%- include('../partials/head') %>
<div x-data="{ menu: false, notifs: false }" @open-notifs.window="notifs = true">
<%- include('../partials/app-header') %>

<% if (isManager) { %>
  <%# Manager: sidebar trái cố định, luôn mở rộng %>
  <aside class="fixed bottom-0 left-0 top-14 z-30 hidden w-60 overflow-y-auto border-r border-slate-200 bg-white px-3 py-4 lg:block dark:border-slate-800 dark:bg-slate-900">
    <% menuGroups.forEach((g, gi) => { %>
      <p class="mb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 <%= gi ? 'mt-4' : '' %>"><%= g.title %></p>
      <nav class="space-y-0.5"><% g.items.forEach(item => { %><%- partial('app/_nav_item', { item, nav, badges, icon }) %><% }) %></nav>
    <% }) %>
  </aside>
<% } else { %>
  <%# Staff: thu gọn icon, hover mở rộng (đè lên nội dung) %>
  <aside class="collapsible fixed bottom-0 left-0 top-14 z-30 hidden w-16 overflow-y-auto overflow-x-hidden border-r border-slate-200 bg-white px-2 py-3 transition-[width] duration-200 hover:w-60 hover:shadow-xl md:block dark:border-slate-800 dark:bg-slate-900">
    <% menuGroups.forEach((g, gi) => { %>
      <div class="<%= gi ? 'mt-2 border-t border-slate-200 pt-2 dark:border-slate-800' : '' %>">
        <p class="nav-label mb-0.5 h-4 overflow-hidden whitespace-nowrap px-3 text-[10px] font-bold uppercase tracking-wider text-slate-400"><%= g.title %></p>
        <nav class="space-y-0.5"><% g.items.forEach(item => { %><%- partial('app/_nav_item', { item, nav, badges, icon }) %><% }) %></nav>
      </div>
    <% }) %>
  </aside>
<% } %>

<%# Mobile: thanh dưới + drawer menu đầy đủ %>
<nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t border-slate-200 bg-white/95 pb-[env(safe-area-inset-bottom)] text-[10px] font-medium backdrop-blur <%= isManager ? 'lg:hidden' : 'md:hidden' %> dark:border-slate-800 dark:bg-slate-900/95">
  <% [[isManager ? '/manager' : '/staff', 'home', 'Tổng quan'], ['/staff/tasks/new', 'inbox', 'Nhận máy'], ['/staff/return', 'checkCircle', 'Trả máy'], ['/staff/sell', 'cart', 'Bán hàng']].forEach(([href, ic, label]) => { %>
    <a href="<%= href %>" class="flex flex-col items-center gap-0.5 py-2 <%= path === href.replace(/\?.*/, '') ? 'text-brand-600' : 'text-slate-600 dark:text-slate-300' %>"><%- icon(ic, 'h-5 w-5') %><%= label %></a>
  <% }) %>
  <button type="button" @click="menu = true" class="flex flex-col items-center gap-0.5 py-2 text-slate-600 dark:text-slate-300"><%- icon('menu', 'h-5 w-5') %>Menu</button>
</nav>
<div x-show="menu" x-cloak x-transition.opacity class="fixed inset-0 z-50 bg-slate-950/50" @click="menu = false"></div>
<aside x-show="menu" x-cloak x-transition:enter="transition duration-200" x-transition:enter-start="-translate-x-full" x-transition:leave="transition duration-150" x-transition:leave-end="-translate-x-full"
       class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] overflow-y-auto bg-white p-3 shadow-xl dark:bg-slate-900" @keydown.escape.window="menu = false">
  <div class="mb-2 flex items-center justify-between px-2">
    <span class="font-semibold">Menu</span>
    <button type="button" @click="menu = false" class="rounded-lg p-2 hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Đóng"><%- icon('x', 'h-5 w-5') %></button>
  </div>
  <% menuGroups.forEach((g, gi) => { %>
    <p class="mb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 <%= gi ? 'mt-4' : '' %>"><%= g.title %></p>
    <nav class="space-y-0.5"><% g.items.forEach(item => { %><%- partial('app/_nav_item', { item, nav, badges, icon }) %><% }) %></nav>
  <% }) %>
</aside>

<div class="pb-20 <%= isManager ? 'lg:pb-6 lg:pl-60 xl:pr-80' : 'md:pb-6 md:pl-16' %>">
  <main class="mx-auto <%= typeof wide !== 'undefined' && wide ? 'max-w-[1600px]' : 'max-w-6xl' %> p-4 md:p-6">
    <% if (taskAlerts.length && !(typeof hideTaskAlerts !== 'undefined' && hideTaskAlerts)) { const pend = taskAlerts.filter(x => x.alert && x.alert.kind === 'pending').length; %>
      <div x-data="{ open: <%= taskAlerts.length <= 3 ? 'true' : 'false' %> }" class="mb-4 overflow-hidden rounded-xl border border-orange-300 bg-orange-50 text-sm text-orange-900 dark:border-orange-800 dark:bg-orange-950/40 dark:text-orange-100">
        <div class="flex flex-wrap items-center gap-2 px-4 py-2.5">
          <%- icon('alert', 'h-5 w-5 shrink-0 text-orange-600') %>
          <p class="flex-1 font-semibold">Có <%= taskAlerts.length %> task cần chú ý<span class="font-normal"><%= pend ? ` · ${pend} task chờ quá 3 ngày` : '' %><%= taskAlerts.length - pend ? ` · ${taskAlerts.length - pend} task đang sửa quá 1 ngày` : '' %></span></p>
          <button type="button" @click="open = !open" class="rounded-md px-2 py-1 text-xs font-medium hover:bg-orange-100 dark:hover:bg-orange-900/40" x-text="open ? 'Thu gọn' : 'Xem'"></button>
          <a href="/staff/tasks?view=overdue" class="rounded-md bg-orange-600 px-2.5 py-1 text-xs font-semibold text-white hover:bg-orange-700">Danh sách</a>
        </div>
        <ul x-show="open" x-cloak class="divide-y divide-orange-200 border-t border-orange-200 dark:divide-orange-900 dark:border-orange-900">
          <% taskAlerts.slice(0, 5).forEach(x => { %>
            <li><a href="/staff/tasks/<%= x.id %>" class="flex flex-wrap items-center gap-x-3 gap-y-0.5 px-4 py-2 hover:bg-orange-100/70 dark:hover:bg-orange-900/30">
              <span class="font-mono text-xs"><%= x.ticket_code %></span>
              <span class="min-w-0 flex-1 truncate font-medium"><%= x.device_model %></span>
              <span class="text-xs"><%= x.assigned_name || 'Chưa ai nhận' %></span>
              <span class="<%= x.alert.kind === 'pending' ? 'badge-red' : 'badge-amber' %>"><%= x.alert.label %></span>
            </a></li>
          <% }) %>
          <% if (taskAlerts.length > 5) { %><li class="px-4 py-2 text-xs"><a href="/staff/tasks?view=overdue" class="font-medium underline">+ <%= taskAlerts.length - 5 %> task khác</a></li><% } %>
        </ul>
      </div>
    <% } %>
    <% flash.forEach(f => { %>
      <div x-data="{ show: true }" x-show="show" x-init="setTimeout(() => show = false, 6000)" x-transition
           class="mb-4 flex items-start gap-2 rounded-lg px-4 py-3 text-sm <%= f.type === 'error' ? 'bg-red-50 text-red-800 ring-1 ring-red-200 dark:bg-red-950 dark:text-red-200 dark:ring-red-900' : 'bg-emerald-50 text-emerald-800 ring-1 ring-emerald-200 dark:bg-emerald-950 dark:text-emerald-200 dark:ring-emerald-900' %>">
        <%- icon(f.type === 'error' ? 'alert' : 'checkCircle', 'h-5 w-5 shrink-0') %><span class="flex-1"><%= f.message %></span>
        <button type="button" @click="show = false" class="opacity-60 hover:opacity-100" aria-label="Đóng"><%- icon('x', 'h-4 w-4') %></button>
      </div>
    <% }) %>
