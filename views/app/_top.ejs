<%- include('../partials/head', { appUi: true }) %>
<% const menuHtml = menuGroups.map((g, gi) => `<p class="mb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 ${gi ? 'mt-4' : ''}">${escapeFn(g.title)}</p>
    <nav class="space-y-0.5">${g.items.map(item => partial('app/_nav_item', { item, nav, badges, icon })).join('')}</nav>`).join('\n  ');
   // Ô tìm chức năng + trang con (ẩn, chỉ hiện khi gõ tìm) — nằm ngoài data-live-nav để không bị làm mới
   const menuSearchHtml = `<div class="relative mb-3">
      <span class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400">${icon('search', 'h-4 w-4')}</span>
      <input type="search" data-menu-search placeholder="Tìm chức năng…  ( / )" autocomplete="off" aria-label="Tìm chức năng"
             class="w-full rounded-lg border border-slate-200 bg-slate-50 py-1.5 pl-8 pr-2 text-sm outline-none focus:border-brand-400 focus:bg-white focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-800 dark:focus:bg-slate-900">
    </div>`;
   const extrasHtml = `<div data-menu-extras hidden class="mb-3">
      <p class="mb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400">Trang con</p>
      <nav class="space-y-0.5">${(typeof menuExtras !== 'undefined' ? menuExtras : []).map(x => `<a href="${escapeFn(x.href)}" data-k="${escapeFn(x.label + ' ' + x.parent + ' ' + (x.kw || ''))}" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-brand-50 hover:text-brand-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">${icon(x.icon, 'h-4 w-4 shrink-0')}<span class="flex-1">${escapeFn(x.label)}<span class="block text-[11px] text-slate-400">${escapeFn(x.parent)}</span></span></a>`).join('')}</nav>
    </div>`; %>
<div x-data="{ menu: false, notifs: false }" @open-notifs.window="notifs = true">
<%- include('../partials/app-header') %>

<%# Sidebar trái cố định, luôn mở rộng (quản lý và nhân viên) %>
<aside class="fixed bottom-0 left-0 top-14 z-30 hidden w-60 overflow-y-auto border-r border-slate-200 bg-white px-3 py-4 lg:block dark:border-slate-800 dark:bg-slate-900">
  <%- menuSearchHtml %><%- extrasHtml %>
  <div data-live-nav><%- menuHtml %></div>
</aside>

<%# Mobile: thanh dưới + drawer menu đầy đủ %>
<nav class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t border-slate-200 bg-white/95 pb-[env(safe-area-inset-bottom)] text-[10px] font-medium backdrop-blur lg:hidden dark:border-slate-800 dark:bg-slate-900/95">
  <% [[isManager ? '/manager' : '/staff', 'home', 'Tổng quan'], ['/staff/tasks/new', 'inbox', 'Nhận máy'], ['/staff/return', 'checkCircle', 'Trả máy'], ['/staff/sell', 'cart', 'Bán hàng']].forEach(([href, ic, label]) => { %>
    <a href="<%= href %>" class="flex flex-col items-center gap-0.5 py-2 <%= path === href.replace(/\?.*/, '') ? 'text-brand-600' : 'text-slate-600 dark:text-slate-300' %>"><%- icon(ic, 'h-5 w-5') %><%= label %></a>
  <% }) %>
  <button type="button" @click="menu = true" class="flex flex-col items-center gap-0.5 py-2 text-slate-600 dark:text-slate-300"><%- icon('menu', 'h-5 w-5') %>Menu</button>
</nav>
<div x-show="menu" x-cloak x-transition.opacity class="fixed inset-0 z-50 bg-slate-950/50" @click="menu = false"></div>
<aside x-show="menu" x-cloak x-transition:enter="transition duration-200" x-transition:enter-start="-translate-x-full" x-transition:leave="transition duration-150" x-transition:leave-end="-translate-x-full"
       class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] overflow-y-auto bg-white p-3 shadow-xl dark:bg-slate-900" @keydown.escape.window="menu = false">
  <div class="mb-2 flex items-center justify-between px-2">
    <span class="font-semibold">Menu</span>
    <button type="button" @click="menu = false" class="rounded-lg p-2 hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Đóng"><%- icon('x', 'h-5 w-5') %></button>
  </div>
  <%- menuSearchHtml %><%- extrasHtml %>
  <div data-live-nav><%- menuHtml %></div>
</aside>

<div class="pb-20 lg:pb-6 lg:pl-60">
  <main class="mx-auto max-w-[1600px] p-4 md:p-6">
    <%# Thông báo (lưu / lỗi...): popup góc trên phải, 2 giây tự tắt (rê chuột vào thì giữ lại) %>
    <% if (flash.length) { %>
      <div class="pointer-events-none fixed right-4 top-16 z-[70] flex w-[22rem] max-w-[calc(100vw-2rem)] flex-col gap-2" aria-live="polite">
        <% flash.forEach((f, k) => { %>
          <div x-data="{ show: true, t: null, hide(ms) { clearTimeout(this.t); this.t = setTimeout(() => this.show = false, ms) } }" x-init="hide(<%= 2000 + k * 300 %>)"
               @mouseenter="clearTimeout(t)" @mouseleave="hide(1000)" x-show="show"
               x-transition:leave="transition duration-300 ease-in" x-transition:leave-end="opacity-0 translate-x-8"
               class="toast-top-in pointer-events-auto flex items-start gap-2 rounded-xl px-4 py-3 text-sm shadow-2xl ring-1 backdrop-blur-xl <%= f.type === 'error' ? 'bg-red-50/95 text-red-800 ring-red-200 dark:bg-red-950/95 dark:text-red-200 dark:ring-red-900' : 'bg-emerald-50/95 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/95 dark:text-emerald-200 dark:ring-emerald-900' %>">
            <%- icon(f.type === 'error' ? 'alert' : 'checkCircle', 'h-5 w-5 shrink-0') %><span class="flex-1"><%= f.message %></span>
            <button type="button" @click="show = false" class="opacity-60 hover:opacity-100" aria-label="Đóng"><%- icon('x', 'h-4 w-4') %></button>
          </div>
        <% }) %>
      </div>
    <% } %>
