<%- include('../app/_top') %>
<div x-data="zaloLink('/manager/users', { sendTo: <%= JSON.stringify((users.find(x => x.zalo_chat_id) ? 'user:' + users.find(x => x.zalo_chat_id).id : zaloPartners[0] ? 'partner:' + zaloPartners[0].id : '')) %> })" @keydown.escape.window="closeModal()">
  <div class="page-title">
    <h1><%- icon('cpu', 'h-6 w-6 text-brand-600') %>Hệ thống</h1>
    <button type="button" @click="m = 'create'" class="btn-primary"><%- icon('plusSquare', 'h-4 w-4') %>Thêm tài khoản</button>
  </div>
  <%- include('_system_tabs', { sysTab: 'users' }) %>
  <%# ---- Thông báo Zalo: trạng thái bot ---- %>
  <section class="card mb-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="flex items-center gap-2 font-semibold"><span class="text-[#0068ff]"><%- icon('zalo', 'h-5 w-5') %></span>Thông báo Zalo</h2>
        <p class="mt-0.5 text-sm text-slate-500"><b>Quản lý</b>: giao dịch (bán hàng, trả máy), sửa xong / không sửa được, yêu cầu nhập hàng. <b>Nhân viên</b>: task mới, task được giao cho mình, mỗi sáng nhắc task quá hạn mình đang giữ. <b>Nhóm đối tác</b> (liên kết ở trang Khách đối tác): máy bắt đầu sửa / sửa xong. Không gửi thao tác do chính mình làm.</p>
      </div>
      <span x-show="zs.enabled !== undefined" x-cloak :class="zs.enabled ? (zs.polling ? 'badge-green' : 'badge-amber') : 'badge-red'"
            x-text="!zs.configured ? 'Chưa cấu hình' : !zs.enabled ? 'Đang tắt' : zs.polling ? 'Đang hoạt động' : 'Mất kết nối'"></span>
    </div>
    <dl class="mt-3 grid grid-cols-[8rem_1fr] gap-x-4 gap-y-1.5 text-sm">
      <dt class="text-slate-500">Bot</dt>
      <dd x-text="!zs.configured ? 'Chưa có token — thêm ZALO_BOT_TOKEN vào .env rồi khởi động lại' : !zs.enabled ? 'Tắt trên máy chủ thử' : (zs.bot || '(chưa lấy được tên bot)')"></dd>
      <dt class="text-slate-500">Đã gửi</dt>
      <dd><span x-text="(zs.sent || 0) + ' tin'"></span><span x-show="zs.failed" x-cloak class="text-red-600" x-text="' · lỗi ' + zs.failed"></span>
        <span class="text-xs text-slate-500" x-show="zs.lastSentAt" x-text="'— gần nhất ' + (zs.lastSentAt ? new Date(zs.lastSentAt).toLocaleString('vi-VN') : '')"></span>
        <span class="block text-xs text-slate-500">(đếm từ lần khởi động web gần nhất)</span></dd>
      <dt class="text-slate-500">Nhắc quá hạn</dt>
      <dd>Gửi ngay khi task vừa quá hạn cho người được giao (ban đêm 21:00–7:00 giữ lại, sáng gửi)<span class="block text-xs text-slate-500" x-show="zs.lastOverdue && zs.lastOverdue.people" x-cloak x-text="zs.lastOverdue ? 'Lần gần nhất: ' + new Date(zs.lastOverdue.at).toLocaleString('vi-VN') + ' — ' + zs.lastOverdue.tasks + ' task' : ''"></span></dd>
      <dt x-show="zs.lastError" x-cloak class="text-slate-500">Lỗi gần nhất</dt>
      <dd x-show="zs.lastError" x-cloak class="text-xs text-red-600" x-text="zs.lastError + (zs.lastErrorAt ? ' (' + new Date(zs.lastErrorAt).toLocaleString('vi-VN') + ')' : '')"></dd>
    </dl>
    <%# ---- Thử tin nhắn: gửi ngay 1 tin tự soạn tới tài khoản / nhóm đã liên kết ---- %>
    <% const zTargets = users.filter(x => x.zalo_chat_id).map(x => ['user:' + x.id, x.full_name + (x.zalo_name ? ' (' + x.zalo_name + ')' : '')])
         .concat(zaloPartners.map(p => ['partner:' + p.id, 'Nhóm ' + p.name + (p.zalo_name ? ' (' + p.zalo_name + ')' : '')])); %>
    <form @submit.prevent="sendCustom()" class="mt-4 border-t border-slate-200 pt-3 dark:border-slate-800">
      <h3 class="text-sm font-semibold">Thử tin nhắn</h3>
      <% if (zTargets.length) { %>
        <div class="mt-2 grid gap-2 md:grid-cols-[14rem_minmax(0,1fr)_auto] md:items-start">
          <select x-model="sendTo" class="input" required>
            <% zTargets.forEach(([k, l]) => { %><option value="<%= k %>"><%= l %></option><% }) %>
          </select>
          <textarea x-model="sendText" rows="2" maxlength="2000" required class="input" placeholder="Nội dung tin nhắn..."></textarea>
          <button type="submit" :disabled="busy || !zs.enabled || !sendText.trim()" class="btn-primary" x-text="busy ? 'Đang gửi...' : 'Gửi ngay'"></button>
        </div>
      <% } else { %>
        <p class="mt-1 text-sm text-slate-500">Chưa có tài khoản / nhóm nào liên kết Zalo.</p>
      <% } %>
    </form>
    <p x-show="zerr" x-cloak class="mt-2 text-sm text-red-600" x-text="zerr"></p>
    <p x-show="zmsg" x-cloak class="mt-2 text-sm text-emerald-700 dark:text-emerald-400" x-text="zmsg"></p>
  </section>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>Họ tên</th><th>Tên đăng nhập</th><th>Vai trò</th><th>Trạng thái</th><th>Zalo</th><th class="text-right">Task đang mở</th><th>Tạo lúc</th><th class="text-right">Thao tác</th></tr></thead>
    <tbody>
      <% users.forEach(x => { %>
        <tr class="<%= x.is_active ? '' : 'opacity-60' %>">
          <td class="font-medium"><%= x.full_name %><%= x.id === user.id ? ' (bạn)' : '' %></td>
          <td class="font-mono text-xs"><%= x.username %></td>
          <td><span class="<%= x.role === 'manager' ? 'badge-violet' : 'badge-blue' %>"><%= x.role === 'manager' ? 'Quản lý' : 'Nhân viên' %></span></td>
          <td><span class="<%= x.is_active ? 'badge-green' : 'badge-red' %>"><%= x.is_active ? 'Hoạt động' : 'Đã khóa' %></span></td>
          <td class="whitespace-nowrap">
            <% if (x.zalo_chat_id) { %>
              <span class="flex items-center gap-1">
                <span class="<%= x.zalo_enabled ? 'badge-green' : 'badge-gray' %> max-w-[9rem] truncate" title="<%= x.zalo_name || '' %>"><%= x.zalo_enabled ? (x.zalo_name || 'Đã liên kết') : 'Tắt nhận tin' %></span>
                <button type="button" title="<%= x.zalo_enabled ? 'Tắt nhận tin Zalo' : 'Bật nhận tin Zalo' %>" @click="setEnabled(<%= x.id %>, <%= x.zalo_enabled ? 'false' : 'true' %>)" class="rounded-md p-1 hover:bg-slate-100 dark:hover:bg-slate-800 <%= x.zalo_enabled ? 'text-brand-600' : 'text-slate-400' %>"><%- icon('bell', 'h-4 w-4') %></button>
                <button type="button" title="Gửi tin thử" @click="test(<%= x.id %>)" class="rounded-md p-1 hover:bg-slate-100 dark:hover:bg-slate-800"><%- icon('chat', 'h-4 w-4') %></button>
                <button type="button" title="Gỡ liên kết" @click="unlink(<%= x.id %>, <%= JSON.stringify(x.full_name) %>)" class="rounded-md p-1 text-red-600 hover:bg-red-50 dark:hover:bg-red-950"><%- icon('x', 'h-4 w-4') %></button>
              </span>
            <% } else if (x.is_active) { %>
              <button type="button" @click="startLink(<%= JSON.stringify({ id: x.id, full_name: x.full_name }) %>)" class="btn-secondary px-2 py-1 text-xs"><span class="text-[#0068ff]"><%- icon('zalo', 'h-4 w-4') %></span>Liên kết</button>
            <% } else { %><span class="text-xs text-slate-400">—</span><% } %>
          </td>
          <td class="text-right tabular-nums"><%= x.open_tasks %></td>
          <td class="whitespace-nowrap text-xs"><%= fmt.datetime(x.created_at) %></td>
          <td class="whitespace-nowrap text-right">
            <button type="button" title="Sửa" @click="u = <%= JSON.stringify({ id: x.id, username: x.username, full_name: x.full_name, role: x.role }) %>; m = 'edit'" class="rounded-md p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"><%- icon('edit', 'h-4 w-4') %></button>
            <button type="button" title="Đổi mật khẩu" @click="u = <%= JSON.stringify({ id: x.id, username: x.username }) %>; m = 'password'" class="rounded-md p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"><%- icon('key', 'h-4 w-4') %></button>
            <% if (x.id !== user.id) { %>
              <form method="post" action="/manager/users/<%= x.id %>/toggle" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button title="<%= x.is_active ? 'Khóa' : 'Mở khóa' %>" class="rounded-md p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"><%- icon(x.is_active ? 'lock' : 'unlock', 'h-4 w-4') %></button>
              </form>
              <form method="post" action="/manager/users/<%= x.id %>/delete" class="inline" data-confirm="Xóa tài khoản <%= x.username %>? Lịch sử task/doanh thu vẫn được giữ.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button title="Xóa" class="rounded-md p-1.5 text-red-600 hover:bg-red-50 dark:hover:bg-red-950"><%- icon('trash', 'h-4 w-4') %></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>

  <template x-if="m === 'create'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" action="/manager/users" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-lg font-semibold">Thêm tài khoản</h3>
        <label class="block"><span class="label req">Họ tên</span><input name="full_name" class="input" required></label>
        <label class="block"><span class="label req">Tên đăng nhập</span><input name="username" class="input" required pattern="[a-zA-Z0-9._\-]{3,32}" autocomplete="off"></label>
        <label class="block"><span class="label req">Mật khẩu</span><input name="password" type="text" class="input" required minlength="6" autocomplete="new-password"></label>
        <label class="block"><span class="label">Vai trò</span><select name="role" class="input"><option value="staff">Nhân viên</option><option value="manager">Quản lý</option></select></label>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-primary">Tạo</button></div>
      </form>
    </div>
  </template>
  <template x-if="m === 'edit'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" :action="'/manager/users/' + u.id" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-lg font-semibold">Sửa tài khoản <span class="font-mono text-base" x-text="u.username"></span></h3>
        <label class="block"><span class="label req">Họ tên</span><input name="full_name" :value="u.full_name" class="input" required></label>
        <label class="block"><span class="label">Vai trò</span><select name="role" class="input"><option value="staff" :selected="u.role === 'staff'">Nhân viên</option><option value="manager" :selected="u.role === 'manager'">Quản lý</option></select></label>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-primary">Lưu</button></div>
      </form>
    </div>
  </template>
  <template x-if="m === 'password'">
    <div class="modal-backdrop" @click.self="m = null">
      <form method="post" :action="'/manager/users/' + u.id + '/password'" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="text-lg font-semibold">Đổi mật khẩu <span class="font-mono text-base" x-text="u.username"></span></h3>
        <label class="block"><span class="label req">Mật khẩu mới</span><input name="password" type="text" class="input" required minlength="6" autocomplete="new-password"></label>
        <p class="text-xs text-slate-500">Tài khoản này sẽ bị đăng xuất khỏi các thiết bị khác.</p>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="m = null" class="btn-secondary">Hủy</button><button class="btn-primary">Đổi mật khẩu</button></div>
      </form>
    </div>
  </template>
  <%- include('_zalo_modal', { group: false }) %>
        <template x-if="linked">
          <p class="rounded-xl bg-emerald-50 p-4 text-sm text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">✅ Đã liên kết với Zalo <b x-text="linkedName || ''"></b>. Bot đã gửi tin xác nhận.</p>
        </template>
        <p x-show="zerr" class="text-sm text-red-600" x-text="zerr"></p>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="closeModal()" class="btn-secondary" x-text="linked ? 'Xong' : 'Đóng'"></button></div>
      </div>
    </div>
  </template>
</div>
<%- include('../app/_bottom') %>
