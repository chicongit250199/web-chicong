<%- include('../app/_top') %>
<div class="page-title">
  <h1><%- icon('archive', 'h-6 w-6 text-brand-600') %>Ghép kho với báo giá</h1>
  <a href="/manager/pc-parts" class="btn-secondary"><%- icon('arrowLeft', 'h-4 w-4') %>Báo giá linh kiện</a>
</div>
<p class="mb-3 text-sm text-slate-500">Hàng <strong>còn trong kho</strong> nhưng chưa biết ứng với món nào trong báo giá (tên ghi khác nhau). Ghép 1 lần, web nhớ mãi — hàng nhập sau cùng tên tự ghép. Món nhập kho bằng nút <em>“Hàng đặt · Nhập kho”</em> thì tự ghép sẵn.</p>


<% if (!rows.length) { %>
  <p class="card py-6 text-center text-sm text-emerald-700 dark:text-emerald-400"><%- icon('checkCircle', 'mr-1 inline h-5 w-5') %>Tất cả hàng trong kho đã được ghép hoặc bỏ qua.</p>
<% } else { %>
  <div class="space-y-3">
    <% rows.forEach(r => { %>
      <div class="card" x-data="{ pick: '<%= r.suggestions[0] ? r.suggestions[0].id : '' %>' }">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="font-medium"><%= r.name %></p>
            <p class="text-xs text-slate-500"><%= r.item_code || '' %> · <%= r.condition || 'không rõ tình trạng' %> · còn <%= r.qty %> · giá bán lẻ <%= r.retail_price != null ? fmt.money(r.retail_price) : '—' %></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="/manager/pc-parts/from-stock?inv_name=<%= encodeURIComponent(r.name) %>" class="btn-secondary px-3 py-1.5 text-sm"><%- icon('plusSquare', 'h-4 w-4') %>Thêm vào báo giá</a>
            <form method="post" action="/manager/pc-parts/link"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="inv_name" value="<%= r.name %>"><input type="hidden" name="ignore" value="1">
              <button class="btn-secondary px-3 py-1.5 text-sm" title="Không phải linh kiện PC (laptop, card wifi...) — không hỏi lại nữa">Bỏ qua</button></form>
          </div>
        </div>
        <form method="post" action="/manager/pc-parts/link" class="mt-3 space-y-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="inv_name" value="<%= r.name %>">
          <% if (r.suggestions.length) { %>
            <p class="text-xs font-medium text-slate-500">Gợi ý (theo mã model):</p>
            <div class="flex flex-wrap gap-2">
              <% r.suggestions.forEach(s => { %>
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 px-3 py-1.5 text-sm has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50 dark:border-slate-700 dark:has-[:checked]:bg-brand-900/30">
                  <input type="radio" x-model="pick" value="<%= s.id %>"><span><%= s.name %><%= s.condition ? ' (' + s.condition + ')' : '' %> <span class="text-xs text-slate-500"><%= s.category %> · <%= s.price != null ? fmt.money(s.price) : 'chưa có giá' %></span></span></label>
              <% }) %>
            </div>
          <% } else { %><p class="text-xs text-slate-500">Không tìm thấy món nào giống — chọn tay bên dưới, hoặc “Thêm vào báo giá”.</p><% } %>
          <div class="flex flex-wrap items-center gap-2">
            <select name="part_id" x-model="pick" class="input max-w-md flex-1 py-1.5 text-sm">
              <option value="">— Chọn món khác trong báo giá —</option>
              <% let lastCat = null; parts.forEach(p => { if (p.category !== lastCat) { if (lastCat !== null) { %></optgroup><% } lastCat = p.category; %><optgroup label="<%= p.category %>"><% } %>
                <option value="<%= p.id %>"><%= p.name %><%= p.condition ? ' (' + p.condition + ')' : '' %></option>
              <% }); if (lastCat !== null) { %></optgroup><% } %>
            </select>
            <button class="btn-primary px-3 py-1.5 text-sm" :disabled="!pick"><%- icon('check', 'h-4 w-4') %>Ghép</button>
          </div>
        </form>
      </div>
    <% }) %>
  </div>
<% } %>

<section id="links" class="mt-6">
  <h2 class="mb-2 font-semibold">Đã ghép / bỏ qua (<%= links.length %>)</h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>Tên hàng kho (bỏ dấu)</th><th>Món báo giá</th><th>Cách ghép</th><th></th></tr></thead>
    <tbody>
      <% links.forEach(l => { %>
        <tr><td class="text-slate-600 dark:text-slate-300"><%= l.inv_key %></td>
          <td><%= l.part ? `${l.part.name}${l.part.condition ? ' (' + l.part.condition + ')' : ''}` : (l.part_id == null ? '— bỏ qua —' : '(đã xóa)') %></td>
          <td><span class="<%= l.auto ? 'badge-blue' : 'badge-gray' %>"><%= l.auto ? 'Tự động' : 'Tay' %></span></td>
          <td class="text-right"><form method="post" action="/manager/pc-parts/unlink"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="inv_key" value="<%= l.inv_key %>"><button class="text-xs text-red-600 hover:underline">Bỏ ghép</button></form></td></tr>
      <% }) %>
      <% if (!links.length) { %><tr><td colspan="4" class="py-4 text-center text-sm text-slate-500">Chưa có</td></tr><% } %>
    </tbody>
  </table></div>
</section>
<%- include('../app/_bottom') %>
