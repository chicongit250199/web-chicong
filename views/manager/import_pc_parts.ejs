<%- include('../app/_top') %>
<%- include('_import_tabs', { active: 'pc_parts' }) %>
<% const LABEL = { price: 'Giá', warranty_months: 'BH', note: 'Ghi chú', note_public: 'Ghi chú hiển thị', category: 'Nhóm', name: 'Tên', condition: 'Tình trạng' };
   const show = (f, v) => v == null || v === '' ? '—' : f === 'price' ? fmt.money(v) : f === 'warranty_months' ? v + ' th' : v; %>

<% if (!data) { %>
  <form method="post" action="/manager/import/pc-parts?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" class="card space-y-4" x-data="{ busy: false, name: '' }" @submit="busy = true">
    <label class="grid cursor-pointer place-items-center gap-2 rounded-xl border-2 border-dashed border-slate-300 px-4 py-10 text-center hover:border-brand-500 dark:border-slate-700">
      <%- icon('upload', 'h-10 w-10 text-brand-600') %>
      <span class="font-medium" x-text="name || 'Chọn file báo giá linh kiện (.xlsx)'"></span>
      <span class="text-xs text-slate-500">Hiện có <%= count %> linh kiện trên web · nhập file sẽ <strong>cập nhật</strong>, không xóa sạch</span>
      <input type="file" name="file" accept=".xlsx,.xls,.xlsm" required class="sr-only" @change="name = $event.target.files[0]?.name || ''">
    </label>
    <div class="flex justify-end"><button class="btn-primary" :disabled="busy"><%- icon('search', 'h-4 w-4') %><span x-text="busy ? 'Đang đọc file...' : 'Đọc & xem trước'"></span></button></div>
  </form>
  <section class="card mt-4 text-sm">
    <h2 class="mb-2 font-semibold">Cấu trúc file (sheet “Giá LK”)</h2>
    <div class="flex flex-wrap gap-1.5"><% ['Tên LK: cột A = nhóm (ô gộp), cột B = tên', 'Tình trạng', 'Giá', 'Bảo hành', 'Ghi chú', 'Ghi chú hiển thị'].forEach(c => { %><span class="badge-gray"><%= c %></span><% }) %></div>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-600 dark:text-slate-400">
      <li>Web tự tìm sheet có dòng tiêu đề <strong>“Tên LK”</strong> + <strong>“Giá”</strong>. Nhóm ghi 1 lần ở dòng đầu, các dòng dưới tự theo nhóm đó.</li>
      <li>Mỗi món nhận diện theo <strong>nhóm + tên + tình trạng</strong>: món đã có → cập nhật giá, bảo hành, ghi chú (giữ nguyên thông số AI, ghép kho). Món mới → thêm.</li>
      <li>Món có trên web mà không có trong file → <strong>không tự xóa</strong>, bạn tick chọn ở bước xem trước.</li>
      <li>Ô giá trống → “chưa có giá”. Bảo hành “36 Tháng” → 36.</li>
    </ul>
  </section>
  <% if (batches.length) { %>
    <h2 class="mb-2 mt-6 font-semibold">Các lần nhập gần đây</h2>
    <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Thời gian</th><th>File</th><th>Số dòng</th><th>Món mới</th><th>Người nhập</th></tr></thead><tbody>
      <% batches.forEach(b => { %><tr><td class="whitespace-nowrap"><%= fmt.datetime(b.created_at) %></td><td><%= b.file_name %></td><td><%= b.row_count %></td><td><%= b.total %></td><td><%= b.user_name %></td></tr><% }) %>
    </tbody></table></div>
  <% } %>
<% } else { %>
  <form method="post" action="/manager/import/pc-parts/confirm" x-data="{ busy: false }" @submit="busy = true">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="font-semibold"><%- icon('fileSheet', 'mr-1 inline h-5 w-5 text-emerald-600') %><%= data.fileName %> <span class="text-sm font-normal text-slate-500">· sheet “<%= data.sheet %>”</span></p>
        <p class="text-sm text-slate-500"><%= data.rows.length %> linh kiện trong file</p>
      </div>
      <div class="flex gap-2">
        <button type="submit" form="cancel-form" class="btn-secondary">Hủy / chọn file khác</button>
        <button class="btn-primary" :disabled="busy"><%- icon('check', 'h-4 w-4') %><span x-text="busy ? 'Đang lưu...' : 'Xác nhận cập nhật'"></span></button>
      </div>
    </div>
    <% data.warnings.forEach(w => { %><p class="mb-2 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800 dark:bg-amber-950 dark:text-amber-200"><%= w %></p><% }) %>
    <div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4">
      <div class="stat"><p class="stat-label">Món mới</p><p class="stat-value text-emerald-600"><%= d.added.length %></p></div>
      <div class="stat"><p class="stat-label">Thay đổi</p><p class="stat-value text-blue-600"><%= d.changed.length %></p></div>
      <div class="stat"><p class="stat-label">Không đổi</p><p class="stat-value text-slate-500"><%= d.same %></p></div>
      <div class="stat"><p class="stat-label">Có trên web, không có trong file</p><p class="stat-value text-amber-600"><%= d.missing.length %></p></div>
    </div>

    <% if (d.changed.length) { %>
      <h2 class="mb-2 font-semibold">Thay đổi (<%= d.changed.length %>)</h2>
      <div class="tbl-wrap mb-4 max-h-[50vh] overflow-y-auto"><table class="tbl text-sm"><thead class="sticky top-0"><tr><th>Nhóm</th><th>Linh kiện</th><th>Thay đổi</th></tr></thead><tbody>
        <% d.changed.forEach(r => { %><tr><td class="whitespace-nowrap"><%= r.category %></td><td class="font-medium"><%= r.name %><%= r.condition ? ' (' + r.condition + ')' : '' %></td>
          <td><% r.changes.forEach(c => { %><span class="mr-2 whitespace-nowrap text-xs"><span class="text-slate-500"><%= LABEL[c.field] %>:</span> <span class="text-red-600 line-through"><%= show(c.field, c.from) %></span> → <strong class="<%= c.field === 'price' && c.to != null && c.from != null ? (c.to > c.from ? 'text-red-600' : 'text-emerald-600') : '' %>"><%= show(c.field, c.to) %></strong></span><% }) %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>

    <% if (d.added.length) { %>
      <h2 class="mb-2 font-semibold">Món mới (<%= d.added.length %>)</h2>
      <div class="tbl-wrap mb-4 max-h-[50vh] overflow-y-auto"><table class="tbl text-sm"><thead class="sticky top-0"><tr><th>Nhóm</th><th>Linh kiện</th><th>Tình trạng</th><th class="text-right">Giá</th><th>BH</th><th>Ghi chú</th></tr></thead><tbody>
        <% d.added.forEach(r => { %><tr class="<%= r.price == null ? 'bg-amber-50/70 dark:bg-amber-950/30' : '' %>"><td class="whitespace-nowrap"><%= r.category %></td><td class="font-medium"><%= r.name %></td><td><%= r.condition || '' %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= r.price != null ? fmt.money(r.price) : 'Chưa có giá' %></td><td><%= r.warranty_months ?? '' %></td><td class="text-xs text-slate-500"><%= [r.note_public, r.note].filter(Boolean).join(' · ') %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>

    <% if (d.missing.length) { %>
      <h2 class="mb-1 font-semibold">Có trên web nhưng không có trong file (<%= d.missing.length %>)</h2>
      <p class="mb-2 text-sm text-slate-500">Mặc định <strong>giữ lại</strong> (có thể là món bạn thêm trên web). Tick món nào muốn xóa.</p>
      <div class="tbl-wrap mb-4"><table class="tbl text-sm"><thead><tr><th class="w-10">Xóa</th><th>Nhóm</th><th>Linh kiện</th><th class="text-right">Giá</th></tr></thead><tbody>
        <% d.missing.forEach(p => { %><tr><td><input type="checkbox" name="remove" value="<%= p.id %>"></td><td><%= p.category %></td><td><%= p.name %><%= p.condition ? ' (' + p.condition + ')' : '' %></td><td class="text-right tabular-nums"><%= p.price != null ? fmt.money(p.price) : '' %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
    <% if (!d.added.length && !d.changed.length && !d.missing.length) { %><p class="card py-6 text-center text-sm text-slate-500">File giống hệt dữ liệu trên web, không có gì thay đổi.</p><% } %>
  </form>
  <form id="cancel-form" method="post" action="/manager/import/pc-parts/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
<% } %>
<%- include('../app/_bottom') %>
