<%# Nút xóa 1 dòng doanh thu. Cần: r (revenue), back (đường dẫn quay lại) %>
<% const what = r.type === 'repair' ? 'Máy đã trả của giao dịch này cũng sẽ bị xóa.' : 'Món hàng sẽ quay lại tồn kho.'; %>
<form method="post" action="/manager/revenues/<%= r.id %>/delete" class="inline"
      data-confirm="<%= `Xóa doanh thu ${fmt.money(r.amount)}?\n${r.content || ''}\n\n${what}\nKhông thể hoàn tác.` %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= back %>">
  <button class="rounded-md p-1 text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950" title="Xóa doanh thu"><%- icon('trash', 'h-4 w-4') %></button>
</form>
