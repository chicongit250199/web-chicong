  <a href="/manager/debts" class="btn-secondary"><%- icon('arrowLeft', 'h-4 w-4') %>Danh sách công nợ</a>
</div>
<%- include('_revenue_tabs', { revTab: 'debts' }) %>
<%- include('../staff/_debt_panel', { d, back: '/manager/debts/view?k=' + encodeURIComponent(d.key) }) %>
<%- include('../app/_bottom') %>
