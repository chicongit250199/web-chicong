<%- include('../app/_top') %>
<% const ds = driveStatus; const ready = ds.credentials && aiEnabled; %>
<div x-data="{
    job: null, err: '', ex: null, inv: null, invItems: [], timer: null,
    get running() { return this.job && this.job.running },
    get pct() { return this.job && this.job.total ? Math.round(this.job.processed / this.job.total * 100) : 0 },
    async init() { await this.poll(); },
    async poll() {
      try { const d = await api('/manager/vat/sync/status'); this.job = d.job; } catch (e) {}
      clearTimeout(this.timer);
      if (this.running) this.timer = setTimeout(() => this.poll(), 3000);
    },
    async sync(dir) {
      this.err = '';
      try { const d = await api('/manager/vat/sync/' + dir, { method: 'POST' }); this.job = d.job; this.poll(); }
      catch (e) { this.err = e.message }
    },
    async openInv(id) { const d = await api('/manager/vat/invoices/' + id); this.inv = d.invoice; this.invItems = d.items; }
  }" @keydown.escape.window="ex = null; inv = null">
  <div class="page-title">
    <h1><%- icon('receipt', 'h-6 w-6 text-brand-600') %>Kho hóa đơn VAT</h1>
    <div class="flex flex-wrap gap-2">
      <button type="button" @click="sync('in')" :disabled="running" class="btn-primary" <%= ds.inFolder ? '' : 'disabled title="Chưa cấu hình DRIVE_VAT_INPUT_FOLDER_ID"' %>>
        <%- icon('refresh', 'h-4 w-4') %><span x-text="running && job.direction === 'in' ? 'Đang quét đầu vào...' : 'Cập nhật HĐ đầu vào'"></span></button>
      <button type="button" @click="sync('out')" :disabled="running" class="btn-secondary" <%= ds.outFolder ? '' : 'disabled title="Chưa cấu hình DRIVE_VAT_OUTPUT_FOLDER_ID"' %>>
        <%- icon('refresh', 'h-4 w-4') %><span x-text="running && job.direction === 'out' ? 'Đang quét bán ra...' : 'Cập nhật HĐ bán ra'"></span></button>
    </div>
  </div>

  <% if (!ds.credentials || !ds.inFolder || !aiEnabled) { %>
    <div class="card mb-4 border-amber-300 bg-amber-50 text-sm dark:border-amber-800 dark:bg-amber-950/40">
      <p class="mb-2 flex items-center gap-2 font-semibold text-amber-800 dark:text-amber-200"><%- icon('alert', 'h-5 w-5') %>Cần cấu hình để quét hóa đơn từ Google Drive</p>
      <ol class="list-decimal space-y-1 pl-5 text-amber-900 dark:text-amber-100">
        <li class="<%= ds.credentials ? 'line-through opacity-60' : '' %>">Tạo Service Account trên Google Cloud (bật Google Drive API), tải file JSON, đặt vào <code>credentials/service-account.json</code>.</li>
        <li class="<%= ds.inFolder ? 'line-through opacity-60' : '' %>">Điền <code>DRIVE_VAT_INPUT_FOLDER_ID</code> và <code>DRIVE_VAT_OUTPUT_FOLDER_ID</code> trong <code>.env</code> (dán link thư mục cũng được).</li>
        <li>Share 2 thư mục cho email Service Account <%= ds.email ? '' : '(quyền Người xem)' %><% if (ds.email) { %>: <code class="select-all"><%= ds.email %></code><% } %>.</li>
        <li class="<%= aiEnabled ? 'line-through opacity-60' : '' %>">Điền <code>GEMINI_API_KEY</code> (dùng cho hóa đơn PDF/ảnh; file XML đọc trực tiếp, không cần AI).</li>
        <li>Khởi động lại server.</li>
      </ol>
    </div>
  <% } %>

  <div x-show="err" x-cloak class="mb-4 flex items-center gap-2 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200 dark:bg-red-950 dark:text-red-200 dark:ring-red-900"><%- icon('alert', 'h-5 w-5') %><span x-text="err"></span></div>
  <%# Tiến độ quét chạy nền %>
  <template x-if="job">
    <div class="mb-4 rounded-lg px-4 py-3 text-sm ring-1"
         :class="job.error ? 'bg-red-50 text-red-900 ring-red-200 dark:bg-red-950 dark:text-red-100 dark:ring-red-900' : (job.running ? 'bg-blue-50 text-blue-900 ring-blue-200 dark:bg-blue-950 dark:text-blue-100 dark:ring-blue-900' : 'bg-emerald-50 text-emerald-900 ring-emerald-200 dark:bg-emerald-950 dark:text-emerald-100 dark:ring-emerald-900')">
      <p class="font-semibold">
        <span x-text="(job.running ? 'Đang quét' : 'Đã quét xong') + ' hóa đơn ' + (job.direction === 'in' ? 'đầu vào' : 'bán ra')"></span>
        <span x-show="job.total" x-text="': ' + job.processed + ' / ' + job.total + ' (' + pct + '%)'"></span>
        <span x-show="!job.running && !job.error" x-text="' · thêm ' + job.added + ' hóa đơn' + (job.duplicates ? ' · ' + job.duplicates + ' trùng' : '') + (job.usedAi ? ' · ' + job.usedAi + ' đọc bằng AI' : '')"></span>
        <span x-show="!job.running && !job.error && !job.found"> — không có file mới</span>
      </p>
      <div x-show="job.running" class="mt-2 h-2 overflow-hidden rounded-full bg-blue-200 dark:bg-blue-900"><div class="h-full rounded-full bg-blue-600 transition-all" :style="'width:' + pct + '%'"></div></div>
      <p x-show="job.running && job.current" class="mt-1 truncate text-xs opacity-75" x-text="'Đang đọc: ' + job.current"></p>
      <p x-show="job.running" class="mt-1 text-xs opacity-75">Hóa đơn PDF đọc bằng AI mất khoảng 10–60 giây/file. Có thể rời trang, việc quét vẫn chạy trên máy chủ.</p>
      <p x-show="job.error" x-text="job.error"></p>
      <ul x-show="job.errors && job.errors.length" class="mt-1 list-disc pl-5 text-red-700 dark:text-red-300"><template x-for="e in job.errors"><li x-text="e"></li></template></ul>
      <a x-show="!job.running && job.added" href="" class="mt-1 inline-block font-medium underline">Tải lại trang để xem hóa đơn mới</a>
    </div>
  </template>

  <div class="tabs">
    <% [['stock','Tồn kho VAT', counts.stock],['exported','Đã xuất hết', counts.exported],['exports','Lịch sử xuất', counts.exports],['in','HĐ đầu vào', counts.in],['out','HĐ bán ra', counts.out]].forEach(([k, l, n]) => { %>
      <a href="?tab=<%= k %>" class="tab <%= tab === k ? 'tab-active' : '' %>"><%= l %> (<%= n %>)</a>
    <% }) %>
  </div>
  <form class="mb-3 flex gap-2"><input type="hidden" name="tab" value="<%= tab %>">
    <input name="q" value="<%= search %>" class="input" placeholder="<%= ['in','out'].includes(tab) ? 'Tên đơn vị, MST, số hóa đơn, tên file...' : 'Tên mặt hàng, nhà cung cấp, số hóa đơn...' %>">
    <button class="btn-primary"><%- icon('search', 'h-4 w-4') %></button></form>

  <% const link = p => `?tab=${tab}${search ? '&q=' + encodeURIComponent(search) : ''}${p > 1 ? '&page=' + p : ''}`; %>
  <% if (tab === 'in' || tab === 'out') { %>
    <div class="tbl-wrap">
      <table class="tbl table-fixed">
        <colgroup><col class="w-36"><col><col class="hidden w-[30%] lg:table-column"><col class="w-32"><col class="w-14"></colgroup>
        <thead><tr>
          <th>Hóa đơn</th><th><%= tab === 'in' ? 'Nhà cung cấp' : 'Đơn vị mua' %></th><th class="hidden lg:table-cell">Mặt hàng</th>
          <th class="text-right">Tổng tiền</th><th class="text-center">File</th>
        </tr></thead>
        <tbody>
          <% rows.forEach(r => { %>
            <tr>
              <td>
                <button type="button" @click="openInv(<%= r.id %>)" class="font-semibold text-brand-600 hover:underline"><%= r.invoice_number %></button>
                <span class="block text-xs text-slate-500"><%= r.invoice_symbol || '' %> · <%= fmt.date(r.invoice_date) %></span>
              </td>
              <td class="min-w-0">
                <span class="block truncate font-medium" title="<%= r.partner_name || '' %>"><%= r.partner_name || (tab === 'out' ? 'Khách lẻ' : '—') %></span>
                <span class="block font-mono text-xs text-slate-500"><%= r.partner_tax_id || '' %></span>
              </td>
              <td class="hidden min-w-0 text-xs text-slate-600 lg:table-cell dark:text-slate-400">
                <span class="line-clamp-2" title="<%= r.item_preview || '' %>"><%= r.item_preview || '' %></span>
                <% if (r.item_count > 3) { %><span class="text-slate-400">+<%= r.item_count - 3 %> mặt hàng</span><% } %>
              </td>
              <td class="whitespace-nowrap text-right">
                <span class="font-semibold tabular-nums"><%= fmt.num(r.total_amount) %></span>
                <span class="block text-xs tabular-nums text-slate-500">VAT <%= fmt.num(r.vat_amount) %></span>
              </td>
              <td class="text-center">
                <a href="<%= r.pdf_link || r.drive_link %>" target="_blank" rel="noopener" title="<%= r.file_name %>" class="inline-grid h-8 w-8 place-items-center rounded-lg text-slate-500 hover:bg-brand-50 hover:text-brand-600 dark:hover:bg-slate-800"><%- icon('external', 'h-4 w-4') %></a>
              </td>
            </tr>
          <% }) %>
          <% if (!rows.length) { %><tr><td colspan="5" class="py-10 text-center text-slate-500"><%= search ? 'Không tìm thấy hóa đơn phù hợp.' : 'Chưa có hóa đơn. Bấm "Cập nhật" để quét Google Drive.' %></td></tr><% } %>
        </tbody>
        <% if (total) { %>
          <tfoot><tr class="bg-slate-50 dark:bg-slate-800/50"><td colspan="2" class="px-3 py-2 text-sm font-medium"><%= total %> hóa đơn<%= search ? ' phù hợp' : '' %></td>
            <td class="hidden lg:table-cell"></td><td class="whitespace-nowrap px-3 py-2 text-right font-bold tabular-nums"><%= fmt.num(sumAmount) %></td><td></td></tr></tfoot>
        <% } %>
      </table>
    </div>
  <% } else if (tab === 'stock' || tab === 'exported') { %>
    <div class="tbl-wrap">
      <table class="tbl table-fixed">
        <colgroup><col><col class="w-36"><col class="hidden w-28 sm:table-column"><col class="hidden w-44 md:table-column"><% if (tab === 'stock') { %><col class="w-20"><% } %></colgroup>
        <thead><tr>
          <th>Mặt hàng</th><th>Số lượng</th><th class="hidden text-right sm:table-cell">Đơn giá</th><th class="hidden md:table-cell">Hóa đơn nhập</th><% if (tab === 'stock') { %><th></th><% } %>
        </tr></thead>
        <tbody>
          <% rows.forEach(r => { const pct = r.quantity_in ? Math.round(r.quantity_remaining / r.quantity_in * 100) : 0; %>
            <tr>
              <td class="min-w-0">
                <span class="line-clamp-2 font-medium" title="<%= r.item_name %>"><%= r.item_name %></span>
                <span class="text-xs text-slate-500"><%= r.unit || '' %><%= r.vat_rate ? ' · VAT ' + r.vat_rate : '' %></span>
                <span class="block text-xs text-slate-500 md:hidden"><%= r.invoice_number %> · <%= fmt.date(r.invoice_date) %> · <%= fmt.num(r.unit_price) %> ₫</span>
              </td>
              <td>
                <span class="font-semibold tabular-nums <%= r.quantity_remaining > 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-400' %>"><%= fmt.num(r.quantity_remaining) %></span>
                <span class="text-xs text-slate-500">/ <%= fmt.num(r.quantity_in) %></span>
                <span class="mt-1 block h-1.5 w-full max-w-24 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><span class="block h-full rounded-full bg-emerald-500" style="width: <%= pct %>%"></span></span>
              </td>
              <td class="hidden whitespace-nowrap text-right tabular-nums sm:table-cell"><%= fmt.num(r.unit_price) %></td>
              <td class="hidden min-w-0 text-xs md:table-cell">
                <button type="button" @click="openInv(<%= r.invoice_id %>)" class="font-medium text-brand-600 hover:underline"><%= r.invoice_number %></button>
                <span class="text-slate-500">· <%= fmt.date(r.invoice_date) %></span>
                <span class="block truncate text-slate-500" title="<%= r.partner_name || '' %>"><%= r.partner_name || '' %></span>
              </td>
              <% if (tab === 'stock') { %>
                <td class="text-right"><button type="button" @click="ex = <%= JSON.stringify({ id: r.id, name: r.item_name, unit: r.unit || '', max: r.quantity_remaining }) %>" class="btn-secondary px-2.5 py-1 text-xs">Xuất</button></td>
              <% } %>
            </tr>
          <% }) %>
          <% if (!rows.length) { %><tr><td colspan="5" class="py-10 text-center text-slate-500">Không có mặt hàng.</td></tr><% } %>
        </tbody>
        <% if (total && tab === 'stock') { %>
          <tfoot><tr class="bg-slate-50 dark:bg-slate-800/50"><td colspan="5" class="px-3 py-2 text-sm"><span class="font-medium"><%= total %> mặt hàng còn tồn</span> · giá trị tồn ước tính <strong class="tabular-nums"><%= fmt.money(sumAmount) %></strong></td></tr></tfoot>
        <% } %>
      </table>
    </div>
  <% } else { %>
    <div class="tbl-wrap">
      <table class="tbl table-fixed">
        <colgroup><col class="w-28"><col><col class="w-28"><col class="hidden w-56 md:table-column"><col class="w-12"></colgroup>
        <thead><tr><th>Ngày xuất</th><th>Mặt hàng</th><th class="text-right">SL xuất</th><th class="hidden md:table-cell">Đơn vị mua</th><th></th></tr></thead>
        <tbody>
          <% rows.forEach(r => { %>
            <tr>
              <td class="whitespace-nowrap text-xs"><%= fmt.datetime(r.created_at) %><span class="block text-slate-500"><%= r.user_name %></span></td>
              <td class="min-w-0"><span class="line-clamp-2 font-medium" title="<%= r.item_name %>"><%= r.item_name %></span>
                <span class="block truncate text-xs text-slate-500">HĐ nhập <%= r.invoice_number %> · <%= r.partner_name || '' %></span>
                <% if (r.note) { %><span class="block truncate text-xs italic text-slate-500"><%= r.note %></span><% } %></td>
              <td class="whitespace-nowrap text-right"><span class="font-semibold tabular-nums"><%= fmt.num(r.quantity) %></span> <span class="text-xs text-slate-500"><%= r.unit || '' %></span></td>
              <td class="hidden min-w-0 md:table-cell"><span class="block truncate"><%= r.buyer_name || '—' %></span><span class="font-mono text-xs text-slate-500"><%= r.buyer_tax_id || '' %></span></td>
              <td class="text-right"><form method="post" action="/manager/vat/exports/<%= r.id %>/undo" @submit="confirm('Hoàn tác lần xuất này? Số lượng sẽ được cộng lại vào tồn kho VAT.') || $event.preventDefault()">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="inline-grid h-8 w-8 place-items-center rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800" title="Hoàn tác"><%- icon('refresh', 'h-4 w-4') %></button></form></td>
            </tr>
          <% }) %>
          <% if (!rows.length) { %><tr><td colspan="5" class="py-10 text-center text-slate-500">Chưa xuất mặt hàng nào.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  <% } %>
  <%- include('../partials/pager', { page, pages, total, pageSize, link }) %>

  <% if (errors.length) { %>
    <details class="card mt-4 text-sm">
      <summary class="cursor-pointer font-semibold text-red-600"><%= errors.length %> file chưa đọc được (sẽ thử lại khi bấm Cập nhật)</summary>
      <ul class="mt-2 space-y-1"><% errors.forEach(e => { %><li><span class="font-medium"><%= e.file_name %></span> — <span class="text-slate-500"><%= e.error %></span></li><% }) %></ul>
    </details>
  <% } %>

  <%# Popup xuất mặt hàng VAT %>
  <template x-if="ex">
    <div class="modal-backdrop" @click.self="ex = null">
      <form method="post" :action="'/manager/vat/items/' + ex.id + '/export'" class="modal space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="q" value="<%= search %>"><input type="hidden" name="page" value="<%= page %>">
        <h3 class="text-lg font-semibold">Xuất mặt hàng VAT</h3>
        <p class="text-sm font-medium" x-text="ex.name"></p>
        <label class="block"><span class="label req">Số lượng xuất <span class="font-normal text-slate-400" x-text="'(còn ' + ex.max + ' ' + ex.unit + ')'"></span></span>
          <input type="number" name="quantity" step="any" min="0" :max="ex.max" :value="ex.max" class="input" required></label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class="label">Đơn vị mua</span><input name="buyer_name" class="input"></label>
          <label class="block"><span class="label">MST người mua</span><input name="buyer_tax_id" class="input"></label>
        </div>
        <label class="block"><span class="label">Ghi chú</span><input name="note" class="input" placeholder="Số HĐ bán ra, lý do..."></label>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="ex = null" class="btn-secondary">Hủy</button><button class="btn-primary">Xác nhận xuất</button></div>
      </form>
    </div>
  </template>

  <%# Popup chi tiết hóa đơn %>
  <template x-if="inv">
    <div class="modal-backdrop" @click.self="inv = null">
      <div class="modal max-w-3xl space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div><h3 class="text-lg font-semibold" x-text="'Hóa đơn ' + (inv.invoice_symbol || '') + ' ' + inv.invoice_number"></h3>
            <p class="text-sm text-slate-500" x-text="(inv.invoice_date || '') + ' · ' + (inv.direction === 'in' ? 'Đầu vào' : 'Bán ra')"></p></div>
          <button type="button" @click="inv = null" class="rounded-lg p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"><%- icon('x', 'h-5 w-5') %></button>
        </div>
        <div class="grid gap-3 text-sm sm:grid-cols-2">
          <div class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800/50"><p class="text-xs text-slate-500">Bên bán</p><p class="font-medium" x-text="inv.seller_name || '—'"></p><p class="font-mono text-xs" x-text="inv.seller_tax_id ? 'MST ' + inv.seller_tax_id : ''"></p></div>
          <div class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800/50"><p class="text-xs text-slate-500">Bên mua</p><p class="font-medium" x-text="inv.buyer_name || '—'"></p><p class="font-mono text-xs" x-text="inv.buyer_tax_id ? 'MST ' + inv.buyer_tax_id : ''"></p></div>
        </div>
        <div class="tbl-wrap max-h-80 overflow-y-auto"><table class="tbl text-xs">
          <thead class="sticky top-0"><tr><th>Mặt hàng</th><th>ĐVT</th><th class="text-right">SL</th><th class="text-right">Đơn giá</th><th class="text-right">Thành tiền</th><th>Thuế</th></tr></thead>
          <tbody><template x-for="it in invItems" :key="it.id"><tr><td x-text="it.item_name"></td><td x-text="it.unit || ''"></td><td class="text-right" x-text="formatVnd(it.quantity_in)"></td><td class="text-right" x-text="formatVnd(it.unit_price)"></td><td class="text-right" x-text="formatVnd(it.total_price)"></td><td x-text="it.vat_rate || ''"></td></tr></template></tbody>
        </table></div>
        <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
          <a :href="inv.pdf_link || inv.drive_link" target="_blank" rel="noopener" class="btn-secondary"><%- icon('external', 'h-4 w-4') %>Mở file trên Drive</a>
          <p class="text-right"><span class="text-slate-500">Trước thuế</span> <span x-text="formatVnd(inv.subtotal)"></span> · <span class="text-slate-500">Thuế</span> <span x-text="formatVnd(inv.vat_amount)"></span><br>
            <span class="text-slate-500">Tổng</span> <strong class="text-lg" x-text="formatVnd(inv.total_amount) + ' ₫'"></strong></p>
        </div>
      </div>
    </div>
  </template>
</div>
<%- include('../app/_bottom') %>
