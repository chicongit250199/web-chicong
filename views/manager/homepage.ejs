<%- include('../app/_top') %>
<div class="page-title">
  <h1><%- icon('settings', 'h-6 w-6 text-brand-600') %>Sửa trang chủ</h1>
  <a href="/" target="_blank" class="btn-secondary"><%- icon('external', 'h-4 w-4') %>Xem trang chủ</a>
</div>

<form method="post" action="/manager/homepage/settings?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" class="card mb-6 space-y-4">
  <h2 class="font-semibold">Thông tin & hình ảnh</h2>
  <div class="grid gap-4 md:grid-cols-2">
    <div x-data="{ p: '' }">
      <span class="label">Logo <span class="font-normal text-slate-400">(tối đa 512px, WebP)</span></span>
      <div class="flex items-center gap-3">
        <div class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
          <img x-show="p" :src="p" alt="" class="h-full w-full object-contain">
          <% if (settings.logo_url) { %><img x-show="!p" src="<%= settings.logo_url %>" alt="" class="h-full w-full object-contain"><% } else { %><span x-show="!p" class="text-xs text-slate-400">Chưa có</span><% } %>
        </div>
        <div class="min-w-0 flex-1 space-y-1">
          <input type="file" name="logo" accept="image/*" class="input p-1.5 text-xs" @change="p = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : ''">
          <% if (settings.logo_url) { %><label class="flex items-center gap-1.5 text-xs text-slate-500"><input type="checkbox" name="remove_logo" value="1">Xóa logo</label><% } %>
        </div>
      </div>
    </div>
    <div x-data="{ p: '' }">
      <span class="label">Banner <span class="font-normal text-slate-400">(giữ nguyên tỉ lệ ảnh, WebP)</span></span>
      <div class="flex items-center gap-3">
        <div class="grid h-20 w-40 shrink-0 place-items-center overflow-hidden rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
          <img x-show="p" :src="p" alt="" class="h-full w-full object-cover">
          <% if (settings.banner_url) { %><img x-show="!p" src="<%= settings.banner_url %>" alt="" class="h-full w-full object-cover"><% } else { %><span x-show="!p" class="text-xs text-slate-400">Chưa có</span><% } %>
        </div>
        <div class="min-w-0 flex-1 space-y-1">
          <input type="file" name="banner" accept="image/*" class="input p-1.5 text-xs" @change="p = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : ''">
          <% if (settings.banner_url) { %><label class="flex items-center gap-1.5 text-xs text-slate-500"><input type="checkbox" name="remove_banner" value="1">Xóa banner</label><% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="grid gap-4 md:grid-cols-3">
    <label class="block"><span class="label req">Tên hiển thị</span><input name="company_name" value="<%= settings.company_name %>" class="input" required></label>
    <label class="block md:col-span-2"><span class="label req">Tên công ty (footer)</span><input name="legal_name" value="<%= settings.legal_name %>" class="input" required></label>
    <label class="block"><span class="label">Mã số thuế</span><input name="tax_id" value="<%= settings.tax_id %>" class="input"></label>
    <label class="block"><span class="label">Số điện thoại (Zalo / WhatsApp)</span><input name="phone" value="<%= settings.phone %>" class="input"></label>
    <label class="block"><span class="label">Số hàng sản phẩm mỗi danh mục</span><input type="number" min="1" max="10" name="featured_rows" value="<%= settings.featured_rows %>" class="input"></label>
    <label class="block"><span class="label">Logo trên nền các trang</span>
      <select name="bg_logo" class="input"><% [['float','Logo trôi quanh + in chìm'],['static','Chỉ in chìm ở giữa'],['off','Tắt']].forEach(([k, l]) => { %><option value="<%= k %>" <%= (settings.bg_logo || 'float') === k ? 'selected' : '' %>><%= l %></option><% }) %></select></label>
    <label class="block md:col-span-3"><span class="label">Địa chỉ</span><input name="address" value="<%= settings.address %>" class="input"></label>
    <label class="block md:col-span-2"><span class="label">Bản đồ nhúng <span class="font-normal text-slate-400">(dán link hoặc mã &lt;iframe&gt; từ Google Maps → Chia sẻ → Nhúng bản đồ)</span></span>
      <input name="map_embed" value="<%= settings.map_embed %>" class="input font-mono text-xs"></label>
    <label class="block"><span class="label">Link nút "Chỉ đường"</span><input name="map_link" value="<%= settings.map_link || '' %>" class="input font-mono text-xs"></label>
  </div>
  <div class="flex justify-end border-t border-slate-200 pt-4 dark:border-slate-800"><button class="btn-primary"><%- icon('check', 'h-4 w-4') %>Lưu cài đặt</button></div>
</form>

<section id="banners" class="mb-6 scroll-mt-20">
  <h2 class="mb-1 font-semibold">Banner trình chiếu</h2>
  <p class="mb-3 text-sm text-slate-500">Banner chính (ở trên) luôn hiện đầu tiên, sau đó lần lượt các banner dưới đây, tự chuyển mỗi 5 giây. Nên dùng ảnh cùng tỉ lệ với banner chính.</p>
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <% banners.forEach((b, i) => { %>
      <div class="card overflow-hidden p-0">
        <img src="<%= b %>" alt="" class="block h-auto w-full">
        <div class="flex items-center justify-between px-3 py-2 text-sm">
          <span class="text-slate-500">#<%= i + 2 %></span>
          <span class="flex gap-1">
            <form method="post" action="/manager/banners/<%= i %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="up">
              <button class="rounded-md px-2 py-1 hover:bg-slate-100 disabled:opacity-30 dark:hover:bg-slate-800" title="Lên trước" <%= i === 0 ? 'disabled' : '' %>>↑</button></form>
            <form method="post" action="/manager/banners/<%= i %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="down">
              <button class="rounded-md px-2 py-1 hover:bg-slate-100 disabled:opacity-30 dark:hover:bg-slate-800" title="Xuống sau" <%= i === banners.length - 1 ? 'disabled' : '' %>>↓</button></form>
            <form method="post" action="/manager/banners/<%= i %>/delete" @submit="confirm('Xóa banner này?') || $event.preventDefault()"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="rounded-md p-1.5 text-red-600 hover:bg-red-50 dark:hover:bg-red-950" title="Xóa"><%- icon('trash', 'h-4 w-4') %></button></form>
          </span>
        </div>
      </div>
    <% }) %>
    <form method="post" action="/manager/banners?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" x-data="{ n: 0 }"
          class="grid min-h-32 place-items-center gap-2 rounded-xl border-2 border-dashed border-slate-300 p-4 text-center dark:border-slate-700">
      <label class="cursor-pointer text-sm">
        <%- icon('upload', 'mx-auto mb-1 h-7 w-7 text-brand-600') %>
        <span x-text="n ? n + ' ảnh đã chọn' : 'Chọn ảnh banner (nhiều ảnh)'"></span>
        <input type="file" name="banners" accept="image/*" multiple class="sr-only" @change="n = $event.target.files.length">
      </label>
      <button class="btn-primary px-3 py-1.5" :disabled="!n"><%- icon('plusSquare', 'h-4 w-4') %>Thêm banner</button>
    </form>
  </div>
</section>

<section id="categories" class="mb-6 scroll-mt-20">
  <h2 class="mb-2 font-semibold">Danh mục</h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>Icon</th><th>Tên (VI)</th><th>EN</th><th>RU</th><th>ZH</th><th>Thứ tự</th><th>Hiện</th><th>SP</th><th></th></tr></thead>
    <tbody>
      <% categories.forEach(c => { %>
        <tr x-data="{ ic: '<%= c.icon %>' }">
          <td colspan="9" class="p-0">
            <form method="post" action="/manager/categories/<%= c.id %>" class="grid grid-cols-[3rem_1.4fr_1fr_1fr_1fr_4.5rem_3rem_3rem_auto] items-center gap-2 px-3 py-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="relative" x-data="{ o: false }" @click.outside="o = false">
                <button type="button" @click="o = !o" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-300 text-brand-600 dark:border-slate-700">
                  <% iconNames.forEach(n => { %><span x-show="ic === '<%= n %>'"><%- icon(n, 'h-5 w-5') %></span><% }) %></button>
                <input type="hidden" name="icon" :value="ic">
                <div x-show="o" x-cloak class="absolute left-0 z-20 mt-1 grid w-64 grid-cols-6 gap-1 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                  <% iconNames.forEach(n => { %><button type="button" @click="ic = '<%= n %>'; o = false" title="<%= n %>" class="grid h-9 place-items-center rounded hover:bg-brand-50 dark:hover:bg-slate-800" :class="ic === '<%= n %>' && 'bg-brand-100 dark:bg-slate-700'"><%- icon(n, 'h-5 w-5') %></button><% }) %>
                </div>
              </div>
              <input name="name_vi" value="<%= c.name_vi %>" class="input py-1.5" required>
              <input name="name_en" value="<%= c.name_en || '' %>" class="input py-1.5">
              <input name="name_ru" value="<%= c.name_ru || '' %>" class="input py-1.5">
              <input name="name_zh" value="<%= c.name_zh || '' %>" class="input py-1.5">
              <input type="number" name="sort_order" value="<%= c.sort_order %>" class="input py-1.5">
              <input type="checkbox" name="is_active" value="1" <%= c.is_active ? 'checked' : '' %> class="h-4 w-4 justify-self-center">
              <span class="text-center tabular-nums"><%= c.n %></span>
              <span class="flex gap-1">
                <button class="rounded-md p-1.5 text-brand-600 hover:bg-brand-50 dark:hover:bg-slate-800" title="Lưu"><%- icon('check', 'h-4 w-4') %></button>
                <button formaction="/manager/categories/<%= c.id %>/delete" class="rounded-md p-1.5 text-red-600 hover:bg-red-50 dark:hover:bg-red-950" title="Xóa" @click="confirm('Xóa danh mục <%= c.name_vi %>?') || $event.preventDefault()"><%- icon('trash', 'h-4 w-4') %></button>
              </span>
            </form>
          </td>
        </tr>
      <% }) %>
      <tr x-data="{ ic: 'box' }">
        <td colspan="9" class="p-0">
          <form method="post" action="/manager/categories" class="grid grid-cols-[3rem_1.4fr_1fr_1fr_1fr_4.5rem_3rem_3rem_auto] items-center gap-2 bg-slate-50 px-3 py-2 dark:bg-slate-800/40">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="relative" x-data="{ o: false }" @click.outside="o = false">
              <button type="button" @click="o = !o" class="grid h-9 w-9 place-items-center rounded-lg border border-dashed border-slate-400 text-brand-600">
                <% iconNames.forEach(n => { %><span x-show="ic === '<%= n %>'"><%- icon(n, 'h-5 w-5') %></span><% }) %></button>
              <input type="hidden" name="icon" :value="ic">
              <div x-show="o" x-cloak class="absolute bottom-full left-0 z-20 mb-1 grid w-64 grid-cols-6 gap-1 rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900">
                <% iconNames.forEach(n => { %><button type="button" @click="ic = '<%= n %>'; o = false" title="<%= n %>" class="grid h-9 place-items-center rounded hover:bg-brand-50 dark:hover:bg-slate-800"><%- icon(n, 'h-5 w-5') %></button><% }) %>
              </div>
            </div>
            <input name="name_vi" placeholder="Danh mục mới" class="input py-1.5" required>
            <input name="name_en" placeholder="English" class="input py-1.5">
            <input name="name_ru" placeholder="Русский" class="input py-1.5">
            <input name="name_zh" placeholder="中文" class="input py-1.5">
            <input type="number" name="sort_order" value="<%= categories.length + 1 %>" class="input py-1.5">
            <span></span><span></span>
            <button class="btn-primary px-3 py-1.5"><%- icon('plusSquare', 'h-4 w-4') %>Thêm</button>
          </form>
        </td>
      </tr>
    </tbody>
  </table></div>
</section>

<section id="featured" class="scroll-mt-20">
  <h2 class="mb-1 font-semibold">Sản phẩm nổi bật trên trang chủ</h2>
  <p class="mb-3 text-sm text-slate-500">Bật ⭐ để ưu tiên hiển thị. Mỗi danh mục hiện <strong><%= settings.featured_rows %></strong> hàng; sản phẩm nổi bật xếp trước.</p>
  <div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
    <% products.forEach(p => { %>
      <div class="card flex items-center gap-3 p-2.5" x-data="{ f: <%= p.is_featured ? 'true' : 'false' %> }">
        <% if (p.image_url) { %><img src="<%= p.image_url %>" alt="" class="h-12 w-12 rounded object-cover"><% } else { %><span class="grid h-12 w-12 place-items-center rounded bg-slate-100 text-slate-400 dark:bg-slate-800"><%- icon('box', 'h-5 w-5') %></span><% } %>
        <a href="/manager/products/<%= p.id %>" class="min-w-0 flex-1 hover:underline"><span class="block truncate text-sm font-medium"><%= p.name_vi %></span><span class="text-xs text-slate-500"><%= p.cat_name || '' %> · <%= p.price ? fmt.money(p.price) : 'Liên hệ' %></span></a>
        <button type="button" @click="api('/manager/products/<%= p.id %>/feature', { method: 'POST' }).then(d => f = !!d.is_featured)"
                class="rounded-lg p-2 text-xl leading-none transition" :class="f ? 'text-amber-400' : 'text-slate-300 hover:text-amber-300 dark:text-slate-600'" :title="f ? 'Bỏ nổi bật' : 'Đặt nổi bật'">★</button>
      </div>
    <% }) %>
  </div>
  <% if (!products.length) { %><p class="card py-8 text-center text-sm text-slate-500">Chưa có sản phẩm đã duyệt.</p><% } %>
</section>
<%- include('../app/_bottom') %>
