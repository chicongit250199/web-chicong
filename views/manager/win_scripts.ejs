<%- include('../app/_top') %>
<div x-data="winScripts(<%= JSON.stringify(slug) %>)">
  <div class="page-title">
    <h1><%- icon('cpu', 'h-6 w-6 text-brand-600') %>Hệ thống</h1>
  </div>
  <%- include('_system_tabs', { sysTab: 'scripts' }) %>

  <%# ---- Lệnh chạy trên máy khách ---- %>
  <section class="card">
    <h2 class="flex items-center gap-2 font-semibold"><%- icon('terminal', 'h-5 w-5 text-brand-600') %>Chạy trên máy Windows</h2>
    <p class="mt-0.5 text-sm text-slate-500">Mở PowerShell (Run as Administrator) trên máy khách trong mạng LAN, dán 1 trong 2 lệnh. Menu tự gồm các script đang <b>bật</b> bên dưới, theo đúng thứ tự — thêm / sửa / tắt script là menu đổi ngay, không cần khởi động lại web.</p>
    <form @submit.prevent="saveSlug()" class="mt-3 flex flex-wrap items-center gap-2 text-sm">
      <label for="shel-slug" class="w-56 shrink-0 text-xs text-slate-500">Đuôi link</label>
      <span class="font-mono text-slate-500">chicongcomputer.local/</span>
      <input id="shel-slug" x-model="slugEdit" class="input w-40 py-1.5 font-mono" maxlength="30" required pattern="[a-zA-Z0-9][a-zA-Z0-9_\-]{1,29}">
      <button type="submit" class="btn-secondary px-3 py-1.5 text-sm" :disabled="!!busy || slugEdit.trim().toLowerCase() === slug" x-text="busy === 'slug' ? 'Đang lưu...' : 'Đổi đuôi link'"></button>
      <span class="text-xs text-slate-500">Đổi xong link cũ không dùng được nữa — tải lại file USB nếu có.</span>
    </form>
    <div class="mt-3 space-y-2">
      <template x-for="c in [['Theo tên', 'irm chicongcomputer.local/' + slug + ' | iex'], ['Theo IP (khi tên .local chậm / lỗi)', 'irm 192.168.1.199:3000/' + slug + ' | iex']]" :key="c[0]">
      <div class="flex flex-wrap items-center gap-2">
        <span class="w-56 shrink-0 text-xs text-slate-500" x-text="c[0]"></span>
        <code class="min-w-0 flex-1 select-all rounded-lg bg-slate-900 px-3 py-2 font-mono text-sm text-emerald-300" x-text="c[1]"></code>
        <button type="button" class="btn-secondary px-3 py-1.5 text-sm" @click="copy(c[1])">Chép</button>
      </div>
      </template>
    </div>
    <p class="mt-2 text-xs text-slate-500"><a :href="'/' + slug" target="_blank" class="text-brand-600 hover:underline" x-text="'Xem nội dung /' + slug"></a> · Máy khách chưa mở quyền Admin thì script tự xin mở lại cửa sổ Admin.</p>
    <div class="mt-3 rounded-lg bg-slate-50 p-3 text-sm dark:bg-slate-800/50">
      <p class="font-medium">Chạy trên WinPE (Anhdv Boot…) hoặc máy không có mạng</p>
      <p class="mt-0.5 text-xs text-slate-500">Tải file bên dưới chép vào USB boot. Trong WinPE mở CMD gõ <code class="rounded bg-white px-1 dark:bg-slate-900">powershell -ExecutionPolicy Bypass -File E:\ChiCongTools.ps1</code> (đổi E: thành ổ USB). Trên WinPE menu chỉ hiện các script có đánh dấu <b>WinPE</b>. Sửa script xong nhớ tải lại file mới.</p>
      <a :href="'/' + slug + '?download=1'" class="btn-secondary mt-2 px-3 py-1.5 text-sm"><%- icon('download', 'h-4 w-4') %>Tải ChiCongTools.ps1</a>
    </div>
  </section>

  <%# ---- Danh sách script ---- %>
  <section class="card mt-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="flex items-center gap-2 font-semibold"><%- icon('list', 'h-5 w-5 text-brand-600') %>Script trong menu</h2>
        <p class="mt-0.5 text-sm text-slate-500">Script gắn link gist thì bấm <b>Cập nhật từ gist</b> để lấy bản mới nhất. Mỗi lần sửa / cập nhật đều giữ lại bản trước để khôi phục.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" @click="syncAll()" :disabled="!!busy || !items.some(s => s.gist_url)" class="btn-secondary px-3 py-1.5 text-sm"><%- icon('refresh', 'h-4 w-4') %><span x-text="busy === 'all' ? 'Đang cập nhật...' : 'Cập nhật tất cả từ gist'"></span></button>
        <button type="button" @click="openNew()" class="btn-primary px-3 py-1.5 text-sm"><%- icon('plusSquare', 'h-4 w-4') %>Thêm script</button>
      </div>
    </div>
    <p x-show="msg" x-cloak class="mt-3 whitespace-pre-line rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300" x-text="msg"></p>
    <p x-show="err" x-cloak class="mt-3 whitespace-pre-line rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950/40 dark:text-red-300" x-text="err"></p>

    <div class="mt-3 overflow-x-auto"><table class="table">
      <thead><tr><th class="w-16">Menu</th><th>Chức năng</th><th>File</th><th>Gist</th><th>Cập nhật</th><th class="text-center">Bật</th><th class="text-center" title="Hiện trong menu khi chạy trên WinPE">WinPE</th><th class="text-right">Thao tác</th></tr></thead>
      <tbody>
        <template x-for="(s, i) in items" :key="s.id">
          <tr :class="s.enabled ? '' : 'opacity-60'">
            <td class="whitespace-nowrap">
              <span class="inline-grid h-6 min-w-[1.5rem] place-items-center rounded bg-slate-100 px-1 text-xs font-bold dark:bg-slate-800" x-text="s.enabled ? '[' + menuNo(s) + ']' : '—'"></span>
              <button type="button" class="ml-1 text-slate-400 hover:text-brand-600 disabled:opacity-30" :disabled="i === 0 || !!busy" @click="move(s, -1)" title="Lên" aria-label="Lên">▲</button>
              <button type="button" class="text-slate-400 hover:text-brand-600 disabled:opacity-30" :disabled="i === items.length - 1 || !!busy" @click="move(s, 1)" title="Xuống" aria-label="Xuống">▼</button>
            </td>
            <td class="min-w-[16rem]"><p class="font-medium" x-text="s.name"></p><p class="text-xs text-slate-500" x-text="s.descr"></p></td>
            <td class="whitespace-nowrap"><code class="text-xs" x-text="s.file"></code><span class="block text-xs text-slate-500" x-text="kb(s.size)"></span></td>
            <td class="whitespace-nowrap text-xs">
              <template x-if="s.gist_url"><a :href="s.gist_url" target="_blank" rel="noopener" class="text-brand-600 hover:underline">Mở gist</a></template>
              <template x-if="!s.gist_url"><span class="text-slate-400">—</span></template>
              <span x-show="s.synced_at" class="block text-slate-500" x-text="'lấy ' + dt(s.synced_at)"></span>
            </td>
            <td class="whitespace-nowrap text-xs text-slate-500"><span x-text="dt(s.updated_at)"></span><span x-show="s.updated_by_name" class="block" x-text="s.updated_by_name"></span></td>
            <td class="text-center"><input type="checkbox" class="h-4 w-4 accent-brand-600" :checked="!!s.enabled" :disabled="!!busy" @change="toggle(s, $event.target.checked)" :aria-label="'Bật ' + s.name"></td>
            <td class="text-center"><input type="checkbox" class="h-4 w-4 accent-amber-600" :checked="!!s.pe" :disabled="!!busy" @change="togglePe(s, $event.target.checked)" :aria-label="'Chạy trên WinPE: ' + s.name"></td>
            <td class="whitespace-nowrap text-right">
              <button type="button" class="btn-secondary px-2 py-1 text-xs" :disabled="!!busy" @click="openEdit(s)"><%- icon('edit', 'h-3.5 w-3.5') %>Sửa</button>
              <button type="button" x-show="s.gist_url" class="btn-secondary px-2 py-1 text-xs" :disabled="!!busy" @click="sync(s)"><%- icon('refresh', 'h-3.5 w-3.5') %><span x-text="busy === s.id ? 'Đang lấy...' : 'Cập nhật từ gist'"></span></button>
              <button type="button" x-show="s.has_prev" class="btn-secondary px-2 py-1 text-xs" :disabled="!!busy" @click="undo(s)" title="Khôi phục bản trước lần sửa / cập nhật gần nhất">Bản trước</button>
              <button type="button" class="px-2 py-1 text-xs text-red-600 hover:underline" :disabled="!!busy" @click="del(s)"><%- icon('trash', 'h-3.5 w-3.5') %></button>
            </td>
          </tr>
        </template>
        <tr x-show="loaded && !items.length"><td colspan="8" class="py-6 text-center text-slate-500">Chưa có script nào — bấm “Thêm script”.</td></tr>
      </tbody>
    </table></div>
  </section>

  <%# ---- Menu khách sẽ thấy ---- %>
  <section class="card mt-4">
    <h2 class="font-semibold">Menu hiện trên máy khách</h2>
    <pre class="mt-2 overflow-x-auto rounded-lg bg-[#012456] p-4 font-mono text-xs leading-relaxed text-slate-100"><span class="text-cyan-300">==========================================================</span>
<span class="text-yellow-300">        BỘ CÔNG CỤ WINDOWS - CHÍ CÔNG COMPUTER</span>
<span class="text-cyan-300">==========================================================</span>
<template x-for="s in items.filter(x => x.enabled)" :key="s.id"><span><span class="text-green-400" x-text="' [' + menuNo(s) + '] '"></span><span x-text="s.name"></span>
<span class="text-slate-400" x-show="s.descr" x-text="'     ' + s.descr + '\n'"></span></span></template><span class="text-red-400"> [Q] Thoát</span></pre>
  </section>

  <%# ---- Thêm / sửa script ---- %>
  <template x-if="ed">
    <div class="modal-backdrop" @keydown.escape.window="close()">
      <div class="modal max-w-5xl space-y-3">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-semibold" x-text="ed.id ? 'Sửa script' : 'Thêm script'"></h3>
          <button type="button" @click="close()" class="text-slate-400 hover:text-slate-700" aria-label="Đóng"><%- icon('x', 'h-5 w-5') %></button>
        </div>
        <form @submit.prevent="save()" class="space-y-3">
          <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto]">
            <label class="block"><span class="label">Link gist (để cập nhật sau này)</span><input x-model="ed.gist_url" class="input" placeholder="https://gist.github.com/chicongit250199/..."></label>
            <div class="flex items-end"><button type="button" @click="fromGist()" :disabled="!ed.gist_url || gistBusy" class="btn-secondary w-full" x-text="gistBusy ? 'Đang lấy...' : 'Lấy nội dung từ gist'"></button></div>
          </div>
          <div class="grid gap-3 md:grid-cols-2">
            <label class="block"><span class="label req">Tên chức năng (hiện trong menu)</span><input x-model="ed.name" class="input" required maxlength="120" placeholder="VD: Tối ưu Windows"></label>
            <label class="block"><span class="label req">Tên file</span><input x-model="ed.file" class="input font-mono" required maxlength="64" placeholder="VD: OptimizeW.ps1"></label>
          </div>
          <label class="block"><span class="label">Mô tả ngắn (dòng nhỏ dưới tên)</span><input x-model="ed.descr" class="input" maxlength="300" placeholder="VD: dọn rác, tắt dịch vụ ngầm, gỡ app rác"></label>
          <div>
            <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
              <span class="label mb-0 req">Nội dung script (.ps1)</span>
              <label class="cursor-pointer text-xs text-brand-600 hover:underline">Chọn file .ps1 từ máy<input type="file" accept=".ps1,.txt,text/plain" class="hidden" @change="loadFile($event)"></label>
            </div>
            <textarea x-model="ed.content" class="input h-[50vh] whitespace-pre font-mono text-xs leading-relaxed" spellcheck="false" wrap="off" placeholder="Dán nội dung PowerShell vào đây, hoặc lấy từ gist / chọn file"></textarea>
            <p class="mt-1 text-xs text-slate-500" x-text="lines(ed.content) + ' dòng · ' + kb(bytes(ed.content)) + (ed.gist_url && ed.id ? ' · sửa ở đây rồi bấm Cập nhật từ gist sẽ bị ghi đè bằng bản trên gist' : '')"></p>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <label class="flex items-center gap-2"><input type="checkbox" x-model="ed.enabled" class="h-4 w-4 accent-brand-600">Hiện trong menu</label>
            <label class="flex items-center gap-2"><input type="checkbox" x-model="ed.pe" class="h-4 w-4 accent-amber-600">Chạy được trên WinPE <span class="text-xs text-slate-500">(chỉ đánh dấu script không cần Windows đang chạy)</span></label>
          </div>
          <p x-show="edErr" x-cloak class="text-sm text-red-600" x-text="edErr"></p>
          <div class="flex justify-end gap-2">
            <button type="button" @click="close()" class="btn-secondary">Hủy</button>
            <button type="submit" :disabled="!!busy" class="btn-primary" x-text="busy === 'save' ? 'Đang lưu...' : 'Lưu'"></button>
          </div>
        </form>
      </div>
    </div>
  </template>
</div>
<%- include('../app/_bottom') %>
