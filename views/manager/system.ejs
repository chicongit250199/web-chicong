<%- include('../app/_top') %>
<div x-data="systemPage()">
  <div class="page-title">
    <h1><%- icon('cpu', 'h-6 w-6 text-brand-600') %>Hệ thống</h1>
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <template x-if="d"><span :class="badge(overall)" class="text-xs" x-text="overall === 'ok' ? 'Máy chủ hoạt động bình thường' : overall === 'warn' ? 'Có thông số cần chú ý' : 'Có thông số nguy hiểm'"></span></template>
      <span x-show="updated" x-text="'Cập nhật ' + updated + ' · tự làm mới 5 giây'"></span>
    </div>
  </div>

  <%# ---- Console máy chủ (log PM2) ---- %>
  <section class="card mb-4" x-data="serverConsole()">
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <h2 class="mr-auto flex items-center gap-2 font-semibold"><%- icon('terminal', 'h-5 w-5 text-brand-600') %>Console máy chủ
        <span class="text-xs font-normal text-slate-500" x-text="paused ? '· tạm dừng' : '· tự làm mới 3 giây'"></span></h2>
      <input type="search" x-model="q" placeholder="Lọc dòng..." class="input w-36 py-1 text-xs sm:w-48">
      <div class="inline-flex overflow-hidden rounded-lg border border-slate-300 text-xs dark:border-slate-700">
        <template x-for="o in [['all','Tất cả'],['err','Lỗi']]" :key="o[0]">
          <button type="button" @click="only = o[0]" class="px-2.5 py-1" :class="only === o[0] ? 'bg-brand-600 text-white' : 'bg-white text-slate-700 dark:bg-slate-800 dark:text-slate-200'" x-text="o[1] + (o[0] === 'err' && errCount ? ' (' + errCount + ')' : '')"></button>
        </template>
      </div>
      <button type="button" class="btn-secondary px-2.5 py-1 text-xs" @click="togglePause()" x-text="paused ? 'Tiếp tục' : 'Tạm dừng'"></button>
      <button type="button" class="btn-secondary px-2.5 py-1 text-xs" @click="open = !open" x-text="open ? 'Thu gọn' : 'Mở rộng'"></button>
    </div>
    <p x-show="err" x-cloak class="mb-2 text-xs text-red-600 dark:text-red-400" x-text="'Không đọc được log: ' + err"></p>
    <div x-ref="box" @scroll="onScroll()" class="overflow-auto rounded-lg bg-slate-950 p-3 font-mono text-[11px] leading-5 text-slate-200 sm:text-xs" :class="open ? 'h-[28rem]' : 'h-48'">
      <p x-show="loaded && !shown.length" class="text-slate-500" x-text="lines.length ? 'Không có dòng nào khớp.' : 'Chưa có log.'"></p>
      <p x-show="!loaded" class="text-slate-500">Đang đọc log...</p>
      <template x-for="(l, i) in shown" :key="i">
        <div class="whitespace-pre-wrap break-all" :class="l.s === 'err' ? 'text-red-400' : ''"><span class="select-none text-slate-500" x-text="fmt(l.t) + ' '"></span><span x-text="l.m"></span></div>
      </template>
    </div>
    <p class="mt-1.5 flex justify-between text-xs text-slate-500">
      <span x-text="lines.length + ' dòng gần nhất · đỏ = luồng lỗi (stderr)'"></span>
      <button type="button" x-show="!stick" x-cloak class="text-brand-600 hover:underline" @click="toBottom()">Xuống dòng mới nhất ↓</button>
    </p>
  </section>

  <p x-show="err" x-cloak class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-950 dark:text-red-200" x-text="'Không lấy được số liệu: ' + err"></p>
  <p x-show="!d && !err" class="card py-10 text-center text-sm text-slate-500">Đang đọc số liệu...</p>

  <template x-if="d">
    <div class="space-y-4">
      <%# ---- 4 chỉ số chính ---- %>
      <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
        <div class="stat">
          <p class="stat-label flex items-center justify-between">Nhiệt độ CPU <span :class="badge(tempLevel(maxTemp))" x-text="label(tempLevel(maxTemp))"></span></p>
          <p class="stat-value" :class="text(tempLevel(maxTemp))" x-text="maxTemp != null ? Math.round(maxTemp) + '°C' : '—'"></p>
          <p class="text-xs text-slate-500" x-text="cpuTemps.length && cpuTemps[0].crit ? 'Ngưỡng tới hạn ' + cpuTemps[0].crit + '°C' : ''"></p>
        </div>
        <div class="stat">
          <p class="stat-label flex items-center justify-between">CPU <span :class="badge(pctLevel(d.cpu.usage))" x-text="label(pctLevel(d.cpu.usage))"></span></p>
          <p class="stat-value" x-text="Math.round(d.cpu.usage) + '%'"></p>
          <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div class="h-full rounded-full transition-all" :class="bar(pctLevel(d.cpu.usage))" :style="'width:' + d.cpu.usage + '%'"></div></div>
          <p class="mt-1 text-xs text-slate-500" x-text="'Tải TB: ' + d.cpu.load.map(function (x) { return x.toFixed(2); }).join(' · ')"></p>
        </div>
        <div class="stat">
          <p class="stat-label flex items-center justify-between">RAM <span :class="badge(pctLevel(memPct))" x-text="label(pctLevel(memPct))"></span></p>
          <p class="stat-value" x-text="memPct + '%'"></p>
          <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div class="h-full rounded-full transition-all" :class="bar(pctLevel(memPct))" :style="'width:' + memPct + '%'"></div></div>
          <p class="mt-1 text-xs text-slate-500" x-text="gb(d.memory.total - d.memory.available) + ' / ' + gb(d.memory.total)"></p>
        </div>
        <template x-for="k in d.disks" :key="k.path">
          <div class="stat">
            <p class="stat-label flex items-center justify-between">Ổ đĩa <span :class="badge(pctLevel(diskPct(k)))" x-text="label(pctLevel(diskPct(k)))"></span></p>
            <p class="stat-value" x-text="diskPct(k) + '%'"></p>
            <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div class="h-full rounded-full transition-all" :class="bar(pctLevel(diskPct(k)))" :style="'width:' + diskPct(k) + '%'"></div></div>
            <p class="mt-1 text-xs text-slate-500" x-text="'Còn trống ' + gb(k.free) + ' / ' + gb(k.total)"></p>
          </div>
        </template>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <%# ---- Nhiệt độ chi tiết ---- %>
        <section class="card">
          <h2 class="mb-3 flex items-center justify-between font-semibold"><span x-text="fans.length ? 'Nhiệt độ & quạt' : 'Nhiệt độ'"></span> <span class="text-xs font-normal text-slate-500">10 phút gần nhất</span></h2>
          <div class="space-y-2.5">
            <template x-for="t in cpuTemps.concat(otherTemps)" :key="t.label">
              <div class="flex items-center gap-3 text-sm">
                <span class="w-28 shrink-0 text-slate-600 dark:text-slate-300" x-text="t.label"></span>
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div class="h-full rounded-full transition-all" :class="bar(tempLevel(t.value))" :style="'width:' + Math.min(100, t.value / (t.crit || 100) * 100) + '%'"></div></div>
                <span class="w-14 shrink-0 text-right font-semibold tabular-nums" :class="text(tempLevel(t.value))" x-text="t.value.toFixed(0) + '°C'"></span>
              </div>
            </template>
            <template x-for="f in fans" :key="f.key">
              <div class="flex items-center gap-3 border-t border-slate-100 pt-2.5 text-sm dark:border-slate-800">
                <span class="w-28 shrink-0 text-slate-600 dark:text-slate-300" x-text="f.label"></span>
                <span class="flex-1 text-xs text-slate-500" x-text="f.rpm > 0 ? (f.pwm != null ? 'Công suất ' + f.pwm + '%' : '') : 'Quạt đang dừng — kiểm tra quạt!'"></span>
                <span class="shrink-0 text-right font-semibold tabular-nums" :class="text(fanLevel(f))" x-text="f.rpm.toLocaleString('vi-VN') + ' vòng/phút'"></span>
              </div>
            </template>
          </div>
          <figure class="mt-4">
            <svg viewBox="0 0 300 60" preserveAspectRatio="none" class="h-16 w-full" role="img" :aria-label="'Nhiệt độ CPU 10 phút'">
              <line x1="0" x2="300" :y1="60 - 75 / 100 * 56 - 2" :y2="60 - 75 / 100 * 56 - 2" class="stroke-amber-400/60" stroke-dasharray="3 3" stroke-width="1" vector-effect="non-scaling-stroke"/>
              <polygon :points="spark('temp', 100).area" class="fill-rose-500/10"/>
              <polyline :points="spark('temp', 100).line" fill="none" class="stroke-rose-500" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/>
            </svg>
            <figcaption class="mt-1 flex justify-between text-xs text-slate-500">
              <span>CPU nóng nhất (thang 0–100°C, vạch: 75°C)</span>
              <span x-show="histRange('temp')" x-text="histRange('temp') ? 'thấp ' + histRange('temp').min.toFixed(0) + '° · cao ' + histRange('temp').max.toFixed(0) + '°' : ''"></span>
            </figcaption>
          </figure>
        </section>

        <%# ---- CPU chi tiết ---- %>
        <section class="card">
          <h2 class="mb-3 flex items-center justify-between font-semibold">CPU <span class="text-xs font-normal text-slate-500" x-text="d.cpu.model + ' · ' + d.cpu.cores + ' nhân'"></span></h2>
          <div class="space-y-2.5">
            <template x-for="(p, i) in d.cpu.perCore" :key="i">
              <div class="flex items-center gap-3 text-sm">
                <span class="w-28 shrink-0 text-slate-600 dark:text-slate-300" x-text="'Nhân ' + i"></span>
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700"><div class="h-full rounded-full bg-brand-500 transition-all" :style="'width:' + p + '%'"></div></div>
                <span class="w-14 shrink-0 text-right font-semibold tabular-nums" x-text="Math.round(p) + '%'"></span>
              </div>
            </template>
          </div>
          <figure class="mt-4">
            <svg viewBox="0 0 300 60" preserveAspectRatio="none" class="h-16 w-full" role="img" aria-label="CPU 10 phút">
              <polygon :points="spark('cpu', 100).area" class="fill-brand-500/10"/>
              <polyline :points="spark('cpu', 100).line" fill="none" class="stroke-brand-500" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/>
            </svg>
            <figcaption class="mt-1 flex justify-between text-xs text-slate-500">
              <span>% sử dụng CPU (thang 0–100%)</span>
              <span x-show="histRange('cpu')" x-text="histRange('cpu') ? 'thấp ' + Math.round(histRange('cpu').min) + '% · cao ' + Math.round(histRange('cpu').max) + '%' : ''"></span>
            </figcaption>
          </figure>
        </section>
      </div>

      <%# ---- Mạng ---- %>
      <section class="card" x-show="d.network && d.network.length">
        <h2 class="mb-3 flex items-center justify-between font-semibold">Mạng <span class="text-xs font-normal text-slate-500">tốc độ đang truyền thực tế · 10 phút gần nhất</span></h2>
        <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
          <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800/60">
                <p class="flex items-center gap-1.5 text-xs text-slate-500"><span class="inline-block h-2 w-2 rounded-full bg-brand-500"></span>Tải xuống</p>
                <p class="text-xl font-bold tabular-nums" x-text="bps(netRx)"></p>
              </div>
              <div class="rounded-lg bg-slate-50 p-3 dark:bg-slate-800/60">
                <p class="flex items-center gap-1.5 text-xs text-slate-500"><span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>Tải lên</p>
                <p class="text-xl font-bold tabular-nums" x-text="bps(netTx)"></p>
              </div>
            </div>
            <%# Đo tốc độ Internet %>
            <div class="rounded-lg border border-brand-200 bg-brand-50/50 p-3 text-sm dark:border-brand-900 dark:bg-brand-950/20">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="font-medium">Tốc độ Internet</p>
                <button type="button" @click="speedTest()" :disabled="d.speedTest && d.speedTest.running" class="btn-primary px-3 py-1.5 text-xs">
                  <span x-text="d.speedTest && d.speedTest.running ? 'Đang đo (5–20 giây)...' : 'Đo tốc độ Internet'"></span></button>
              </div>
              <template x-if="d.speedTest && d.speedTest.last">
                <div class="mt-2 grid grid-cols-3 gap-2 text-center">
                  <div><p class="text-xs text-slate-500">Ping</p><p class="text-lg font-bold tabular-nums" x-text="d.speedTest.last.ping + ' ms'"></p></div>
                  <div><p class="text-xs text-slate-500">Tải xuống</p><p class="text-lg font-bold tabular-nums text-brand-600 dark:text-brand-400" x-text="d.speedTest.last.down + ' Mbps'"></p></div>
                  <div><p class="text-xs text-slate-500">Tải lên</p><p class="text-lg font-bold tabular-nums text-emerald-600 dark:text-emerald-400" x-text="d.speedTest.last.up + ' Mbps'"></p></div>
                </div>
              </template>
              <p x-show="d.speedTest && d.speedTest.last" class="mt-1 text-xs text-slate-500"
                 x-text="d.speedTest.last ? 'Đo lúc ' + time(d.speedTest.last.at) + ' · máy chủ ' + (d.speedTest.last.colo || '?') + ' · IP public ' + (d.speedTest.last.ip || '?') : ''"></p>
              <p x-show="d.speedTest && d.speedTest.error" class="mt-1 text-xs text-red-600" x-text="d.speedTest && d.speedTest.error"></p>
              <p x-show="!d.speedTest || (!d.speedTest.last && !d.speedTest.running && !d.speedTest.error)" class="mt-1 text-xs text-slate-500">Đo qua speed.cloudflare.com — mỗi lần dùng khoảng 35MB dữ liệu.</p>
            </div>
            <p x-show="d.gateway" class="text-xs text-slate-500" x-text="d.gateway ? 'Gateway (router): ' + d.gateway.ip + ' qua ' + d.gateway.iface : ''"></p>
            <template x-for="n in d.network" :key="n.name">
              <div class="rounded-lg border border-slate-200 p-3 text-sm dark:border-slate-700" :class="!n.up && 'opacity-60'">
                <p class="flex items-center justify-between gap-2 font-medium">
                  <span x-text="(n.wifi ? 'Wi-Fi' : 'Dây LAN') + ' · ' + n.name"></span>
                  <span :class="n.up ? 'badge-green' : 'badge-amber'" x-text="n.up ? 'Đang kết nối' : 'Không dùng'"></span>
                </p>
                <dl class="mt-2 grid grid-cols-[6.5rem_1fr] gap-x-3 gap-y-1 text-slate-600 dark:text-slate-300">
                  <template x-if="n.up && !n.wifi"><dt class="text-slate-500">Tốc độ cổng</dt></template>
                  <template x-if="n.up && !n.wifi"><dd>
                    <span x-text="linkSpeed(n.speed)"></span>
                    <span x-show="n.speed && n.speed < 1000" class="block text-xs text-amber-600 dark:text-amber-400">Cổng đang chạy dưới 1 Gbps — kiểm tra dây mạng (Cat5e trở lên) hoặc cổng router/switch.</span>
                  </dd></template>
                  <template x-if="n.ip"><dt class="text-slate-500">IP</dt></template>
                  <template x-if="n.ip"><dd class="font-mono" x-text="n.ip"></dd></template>
                  <dt class="text-slate-500">MAC</dt><dd class="font-mono" x-text="n.mac"></dd>
                  <template x-if="n.up"><dt class="text-slate-500">Từ lúc bật máy</dt></template>
                  <template x-if="n.up"><dd x-text="'↓ ' + size(n.rxTotal) + ' · ↑ ' + size(n.txTotal)"></dd></template>
                </dl>
              </div>
            </template>
          </div>
          <figure>
            <svg viewBox="0 0 300 60" preserveAspectRatio="none" class="h-32 w-full" role="img" aria-label="Tốc độ mạng 10 phút">
              <polygon :points="spark('rx', netMax).area" class="fill-brand-500/10"/>
              <polyline :points="spark('rx', netMax).line" fill="none" class="stroke-brand-500" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/>
              <polyline :points="spark('tx', netMax).line" fill="none" class="stroke-emerald-500" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/>
            </svg>
            <figcaption class="mt-1 flex flex-wrap justify-between gap-x-3 text-xs text-slate-500">
              <span class="flex items-center gap-3">
                <span class="flex items-center gap-1"><span class="inline-block h-0.5 w-3 bg-brand-500"></span>Tải xuống</span>
                <span class="flex items-center gap-1"><span class="inline-block h-0.5 w-3 bg-emerald-500"></span>Tải lên</span>
              </span>
              <span x-text="'đỉnh 10 phút: ' + bps(netMax)"></span>
            </figcaption>
          </figure>
        </div>
      </section>

      <div class="grid gap-4 lg:grid-cols-2">
        <%# ---- Máy chủ ---- %>
        <section class="card">
          <h2 class="mb-3 font-semibold">Máy chủ</h2>
          <dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2 text-sm">
            <dt class="text-slate-500">Tên máy</dt><dd class="font-medium" x-text="d.host.hostname"></dd>
            <dt class="text-slate-500">Địa chỉ LAN</dt><dd class="font-mono" x-text="d.host.ips.map(function (ip) { return ip + ':3000'; }).join(', ')"></dd>
            <dt class="text-slate-500">Hệ điều hành</dt><dd x-text="d.host.os + ' · kernel ' + d.host.kernel"></dd>
            <dt class="text-slate-500">Đã chạy</dt><dd x-text="dur(d.host.uptime)"></dd>
            <dt class="text-slate-500">Swap</dt><dd x-text="d.memory.swapTotal ? swapPct + '% · ' + gb(d.memory.swapTotal - d.memory.swapFree) + ' / ' + gb(d.memory.swapTotal) : 'Không dùng'"></dd>
          </dl>
        </section>

        <%# ---- Ứng dụng web ---- %>
        <section class="card">
          <h2 class="mb-3 font-semibold">Ứng dụng web</h2>
          <dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2 text-sm">
            <dt class="text-slate-500">Chạy bằng</dt><dd><span :class="d.app.manager === 'PM2' ? 'badge-green' : 'badge-amber'" x-text="d.app.manager"></span> <span class="text-slate-500" x-text="'· ' + d.app.env + ' · Node ' + d.app.node"></span></dd>
            <dt class="text-slate-500">Đã chạy</dt><dd x-text="dur(d.app.uptime)"></dd>
            <dt class="text-slate-500">RAM ứng dụng</dt><dd x-text="size(d.app.rss)"></dd>
            <dt class="text-slate-500">Cơ sở dữ liệu</dt><dd x-text="size(d.app.db)"></dd>
            <dt class="text-slate-500">Ảnh upload</dt><dd x-text="size(d.app.uploads.total) + ' · ' + d.app.uploads.count + ' file'"></dd>
            <dt class="text-slate-500">Sao lưu</dt><dd x-text="d.app.backups.count ? d.app.backups.count + ' bản · gần nhất ' + time(d.app.backups.last) : 'Chưa có (tự chạy lúc 2h sáng)'"></dd>
            <dt class="text-slate-500">Quét hóa đơn</dt>
            <dd x-text="d.vat.running ? 'Đang quét ' + (d.vat.job.direction === 'in' ? 'đầu vào' : 'bán ra') + ' ' + d.vat.job.processed + '/' + d.vat.job.total : (d.vat.auto && d.vat.auto.enabled ? 'Tự động mỗi ' + d.vat.auto.minutes + ' phút · lần tới ' + time(d.vat.auto.nextRunAt) : 'Tắt')"></dd>
          </dl>
        </section>
      </div>
    </div>
  </template>

  <%# ---- Cảnh báo task quá hạn ---- %>
  <section class="card mt-4" x-data="taskAlertCfg()">
    <h2 class="flex items-center gap-2 font-semibold"><%- icon('clock', 'h-5 w-5 text-brand-600') %>Cảnh báo task quá hạn</h2>
    <p class="mt-0.5 text-sm text-slate-500">Task không thay đổi quá số ngày dưới đây sẽ hiện cảnh báo đầu trang và trong mail báo cáo. Không tính Chủ nhật; nhập 0,5 = nửa ngày.</p>
    <form @submit.prevent="save()" class="mt-3 flex flex-wrap items-end gap-3 text-sm">
      <label class="block">
        <span class="mb-1 block text-slate-600 dark:text-slate-300">Chờ xử lý quá</span>
        <span class="flex items-center gap-2"><input type="number" min="0.5" max="60" step="0.5" x-model="pending" required class="input w-24"> ngày</span>
      </label>
      <label class="block">
        <span class="mb-1 block text-slate-600 dark:text-slate-300">Đang sửa quá</span>
        <span class="flex items-center gap-2"><input type="number" min="0.5" max="60" step="0.5" x-model="processing" required class="input w-24"> ngày</span>
      </label>
      <button type="submit" :disabled="busy" class="btn-primary px-3 py-1.5 text-sm" x-text="busy ? 'Đang lưu...' : 'Lưu'"></button>
      <span x-show="msg" x-cloak class="text-emerald-700 dark:text-emerald-400" x-text="msg"></span>
      <span x-show="err" x-cloak class="text-red-600" x-text="err"></span>
    </form>
  </section>

  <%# ---- Máy in ---- %>
  <section class="card mt-4" x-data="printerAdmin()">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="flex items-center gap-2 font-semibold"><%- icon('printer', 'h-5 w-5 text-brand-600') %>Máy in</h2>
        <p class="mt-0.5 text-sm text-slate-500">Máy in cắm USB vào máy chủ NUC hoặc máy in trong mạng LAN. Nhân viên in file ở mục <a href="/staff/print" class="text-brand-600 hover:underline">In tài liệu</a>; file in xong không lưu lại trên server.</p>
      </div>
      <div class="flex flex-wrap gap-2" x-show="s.running">
        <button type="button" @click="load()" :disabled="busy" class="btn-secondary px-3 py-1.5 text-sm"><%- icon('refresh', 'h-4 w-4') %>Làm mới</button>
        <button type="button" @click="openAdd()" class="btn-primary px-3 py-1.5 text-sm">+ Thêm máy in</button>
      </div>
    </div>

    <p x-show="!loaded" class="mt-3 text-sm text-slate-500">Đang đọc danh sách máy in...</p>
    <div x-show="loaded && !s.available" x-cloak class="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100">
      Máy chủ chưa cài hệ thống in (CUPS). Chạy 1 lần trên NUC:
      <code class="mt-1 block select-all break-all rounded bg-white/70 px-2 py-1 font-mono text-xs dark:bg-black/30">sudo apt install -y cups cups-client cups-bsd avahi-utils && sudo usermod -aG lpadmin <%= sysUser %></code>
    </div>
    <p x-show="loaded && s.available && !s.running" x-cloak class="mt-3 text-sm text-red-600">Dịch vụ in (CUPS) đang tắt — chạy <code>sudo systemctl enable --now cups</code>.</p>

    <template x-if="s.running">
      <div class="mt-3 space-y-3">
        <div x-show="!s.sharing" class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100">
          Máy tính khác trong mạng chưa in thẳng được (chưa chia sẻ máy in). Chạy 1 lần trên NUC: <code class="select-all font-mono">sudo bash scripts/setup-printer-share.sh</code>
        </div>
        <div x-show="s.sharing && s.printers.some(function (p) { return p.shared; })" class="rounded-lg border border-slate-200 p-3 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
          <b>In thẳng từ máy tính khác:</b> Mac / iPhone tự thấy máy in (AirPrint). Windows: Settings → Printers → Add → “The printer that I want isn't listed” → nhập
          <template x-for="p in s.printers.filter(function (p) { return p.shared; })" :key="p.name"><code class="mx-1 select-all font-mono text-xs" x-text="'http://192.168.1.199:631/printers/' + p.name"></code></template>
          rồi chọn driver “Microsoft PCL6 Class Driver” hoặc driver của hãng.
        </div>
        <p x-show="!s.printers.length" class="rounded-lg border border-dashed border-slate-300 p-4 text-center text-sm text-slate-500 dark:border-slate-700">Chưa có máy in nào — bấm “Thêm máy in”.</p>
        <template x-for="p in s.printers" :key="p.name">
          <div class="rounded-lg border border-slate-200 p-3 dark:border-slate-700">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-semibold" x-text="p.info || p.name"></span>
              <span x-show="p.isDefault" class="badge-blue">Mặc định</span>
              <span :class="p.state === 'disabled' ? 'badge-red' : p.state === 'printing' ? 'badge-amber' : 'badge-green'" x-text="p.state === 'disabled' ? 'Tạm dừng' : p.state === 'printing' ? 'Đang in' : 'Sẵn sàng'"></span>
              <span class="badge-gray" x-text="p.connection" x-show="p.connection"></span>
              <span x-show="p.shared && s.sharing" class="badge-green">Chia sẻ LAN</span>
            </div>
            <p class="mt-1 break-all text-xs text-slate-500"><span x-text="p.name"></span><span x-show="p.model"> · <span x-text="p.model"></span></span><span x-show="p.location"> · <span x-text="p.location"></span></span> · <span x-text="p.uri"></span></p>
            <label x-show="p.pageSizes && p.pageSizes.length" class="mt-2 flex items-center gap-2 text-sm"><span class="text-slate-500">Khổ giấy mặc định</span>
              <select class="input w-auto py-1 text-sm" :value="p.pageSize" @change="setSize(p, $event.target.value)" :disabled="busy">
                <template x-for="z in p.pageSizes" :key="z"><option :value="z" :selected="z === p.pageSize" x-text="z"></option></template>
              </select></label>
            <p x-show="p.reason || (p.reasons && p.reasons !== 'none')" class="mt-1 text-xs text-amber-700 dark:text-amber-400" x-text="p.reason || p.reasons"></p>
            <div class="mt-2 flex flex-wrap gap-2 text-sm">
              <button type="button" @click="act(p, 'test')" :disabled="busy" class="btn-secondary px-2.5 py-1 text-xs">In thử</button>
              <button type="button" @click="printTo = p.name; $refs.pf.click()" :disabled="busy" class="btn-secondary px-2.5 py-1 text-xs">In file...</button>
              <button type="button" x-show="!p.isDefault" @click="act(p, 'default')" :disabled="busy" class="btn-secondary px-2.5 py-1 text-xs">Đặt mặc định</button>
              <button type="button" @click="act(p, p.state === 'disabled' ? 'enable' : 'disable')" :disabled="busy" class="btn-secondary px-2.5 py-1 text-xs" x-text="p.state === 'disabled' ? 'Bật lại' : 'Tạm dừng'"></button>
              <button type="button" x-show="jobsOf(p).length" @click="act(p, 'cancel-all', 'Hủy hết lệnh in đang chờ của ' + p.name + '?')" :disabled="busy" class="btn-secondary px-2.5 py-1 text-xs">Hủy hết lệnh in</button>
              <button type="button" x-show="s.sharing" @click="act(p, p.shared ? 'unshare' : 'share')" :disabled="busy" class="btn-secondary px-2.5 py-1 text-xs" x-text="p.shared ? 'Ngừng chia sẻ LAN' : 'Chia sẻ LAN'"></button>
              <button type="button" @click="act(p, 'delete', 'Xóa máy in ' + p.name + ' khỏi hệ thống?')" :disabled="busy" class="btn-secondary px-2.5 py-1 text-xs text-red-600">Xóa</button>
            </div>
            <ul x-show="jobsOf(p).length" class="mt-2 divide-y divide-slate-100 rounded border border-slate-100 text-xs dark:divide-slate-800 dark:border-slate-800">
              <template x-for="j in jobsOf(p)" :key="j.id">
                <li class="flex items-center gap-2 px-2 py-1.5"><span class="font-mono" x-text="j.id"></span><span class="flex-1 text-slate-500" x-text="j.time + ' · ' + Math.ceil(j.size / 1024) + ' KB'"></span>
                  <button type="button" @click="cancelJob(j)" class="text-red-600 hover:underline">Hủy</button></li>
              </template>
            </ul>
          </div>
        </template>
        <input type="file" x-ref="pf" class="hidden" accept=".pdf,.jpg,.jpeg,.png,.txt,application/pdf,image/jpeg,image/png,text/plain" @change="printFile($event)">
      </div>
    </template>

    <%# Hộp thêm máy in %>
    <div x-show="adding" x-cloak class="mt-4 rounded-lg border border-brand-200 bg-brand-50/40 p-3 dark:border-brand-900 dark:bg-brand-950/20">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="mr-auto font-semibold">Thêm máy in</h3>
        <button type="button" @click="discover()" :disabled="finding" class="btn-secondary px-3 py-1.5 text-sm" x-text="finding ? 'Đang tìm (~10 giây)...' : 'Tìm máy in'"></button>
        <button type="button" @click="adding = false" class="btn-secondary px-3 py-1.5 text-sm">Đóng</button>
      </div>
      <template x-if="found.length">
        <ul class="mt-2 max-h-60 divide-y divide-slate-200 overflow-auto rounded border border-slate-200 bg-white text-sm dark:divide-slate-700 dark:border-slate-700 dark:bg-slate-900">
          <template x-for="f in found" :key="f.uri">
            <li><button type="button" @click="pick(f)" class="flex w-full items-center gap-2 px-3 py-2 text-left hover:bg-slate-50 dark:hover:bg-slate-800" :class="form.uri === f.uri && 'bg-brand-50 dark:bg-brand-950/40'">
              <span class="badge-gray" x-text="f.connection"></span><span class="flex-1"><span x-text="f.label"></span><span class="block break-all text-xs text-slate-500" x-text="f.uri"></span></span>
            </button></li>
          </template>
        </ul>
      </template>
      <p x-show="foundNone" x-cloak class="mt-2 text-sm text-slate-500">Không tìm thấy máy in nào. Kiểm tra máy in đã bật/cắm cáp, hoặc nhập địa chỉ IP bên dưới.</p>
      <form @submit.prevent="add()" class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
        <label class="block sm:col-span-2"><span class="mb-1 block text-slate-600 dark:text-slate-300">Địa chỉ máy in (URI)</span>
          <input x-model="form.uri" required class="input w-full font-mono text-xs" placeholder="ipp://192.168.1.50/ipp/print   hoặc   socket://192.168.1.50:9100">
          <span class="mt-1 block text-xs text-slate-500">Máy in mạng nhập IP: hầu hết máy đời mới dùng <code>ipp://IP/ipp/print</code>; máy in bill/tem mạng thường là <code>socket://IP:9100</code>.</span></label>
        <label class="block"><span class="mb-1 block text-slate-600 dark:text-slate-300">Tên hệ thống (không dấu)</span>
          <input x-model="form.name" required pattern="[A-Za-z0-9_.\-]{1,64}" class="input w-full" placeholder="HP_Quay"></label>
        <label class="block"><span class="mb-1 block text-slate-600 dark:text-slate-300">Tên hiển thị</span>
          <input x-model="form.info" class="input w-full" placeholder="Máy in quầy thu ngân"></label>
        <label class="block sm:col-span-2"><span class="mb-1 block text-slate-600 dark:text-slate-300">Driver</span>
          <select x-model="form.driverMode" class="input w-full">
            <option value="everywhere">Tự động — không cần driver (máy in đời mới, hỗ trợ AirPrint / IPP)</option>
            <option value="raw">Raw — gửi thẳng (máy in bill / tem nhiệt)</option>
            <option value="model">Chọn driver theo model...</option>
          </select></label>
        <div x-show="form.driverMode === 'model'" class="sm:col-span-2">
          <input x-model="modelQ" @input.debounce.400ms="searchModels()" class="input w-full" placeholder="Gõ tên model, vd: hp laserjet 1020">
          <select x-model="form.model" size="6" class="input mt-2 w-full text-xs">
            <template x-for="m in modelList" :key="m.id"><option :value="m.id" x-text="m.name"></option></template>
          </select>
          <p x-show="modelQ && !modelList.length" class="mt-1 text-xs text-slate-500">Không có driver phù hợp đã cài. Có thể cần cài thêm gói driver của hãng (vd HP: <code>sudo apt install hplip</code>).</p>
        </div>
        <label class="flex items-center gap-2 sm:col-span-2"><input type="checkbox" x-model="form.makeDefault"> Đặt làm máy in mặc định</label>
        <div class="sm:col-span-2"><button type="submit" :disabled="busy" class="btn-primary px-3 py-1.5 text-sm" x-text="busy ? 'Đang thêm...' : 'Thêm máy in'"></button></div>
      </form>
    </div>

    <p x-show="err" x-cloak class="mt-2 text-sm text-red-600" x-text="err"></p>
    <p x-show="msg" x-cloak class="mt-2 text-sm text-emerald-700 dark:text-emerald-400" x-text="msg"></p>
  </section>

  <%# ---- Lưu ý in trên phiếu (báo giá / thanh toán - bảo hành) ---- %>
  <section id="print-note" class="card mt-4 scroll-mt-20">
    <h2 class="flex items-center gap-2 font-semibold"><%- icon('receipt', 'h-5 w-5 text-brand-600') %>Lưu ý in trên phiếu</h2>
    <p class="mt-1 text-sm text-slate-500">In ở cuối phiếu báo giá Build PC và phiếu thanh toán - bảo hành (bán hàng).</p>
    <form method="post" action="/manager/system/print-note" class="mt-3 space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid gap-3 lg:grid-cols-2">
        <label class="block"><span class="label">Tiếng Việt</span><textarea name="note_vi" rows="5" class="input"><%= printNote.vi %></textarea></label>
        <label class="block"><span class="label">Tiếng Anh</span><textarea name="note_en" rows="5" class="input"><%= printNote.en %></textarea></label>
      </div>
      <div class="flex justify-end"><button class="btn-primary"><%- icon('check', 'h-4 w-4') %>Lưu</button></div>
    </form>
  </section>

  <%# ---- Báo cáo doanh thu qua email ---- %>
  <section class="card mt-4" x-data="reportEmail()">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="flex items-center gap-2 font-semibold"><%- icon('chart', 'h-5 w-5 text-brand-600') %>Báo cáo doanh thu qua email</h2>
        <p class="mt-0.5 text-sm text-slate-500">Mỗi ngày lúc <b x-text="s.at || '20:00'"></b> gửi doanh thu trong ngày (trừ Chủ nhật — có giao dịch thì gộp vào thứ 2); ngày cuối tháng gửi thêm báo cáo cả tháng. Người nhận: <b x-text="s.to || '(chưa đặt)'"></b></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/manager/system/report-email/preview" target="_blank" class="btn-secondary px-3 py-1.5 text-sm">Xem trước (ngày)</a>
        <a href="/manager/system/report-email/preview?kind=monthly" target="_blank" class="btn-secondary px-3 py-1.5 text-sm">Xem trước (tháng)</a>
      </div>
    </div>
    <dl class="mt-3 grid grid-cols-[9rem_1fr] gap-x-4 gap-y-1.5 text-sm">
      <dt class="text-slate-500">Trạng thái</dt>
      <dd x-text="!s.configured ? 'Chưa cấu hình — thêm SMTP_USER, SMTP_PASS (mật khẩu ứng dụng Gmail), REPORT_EMAIL_TO vào .env rồi khởi động lại' : (s.enabled ? 'Đang bật · gửi từ ' + s.user : 'Đã tắt')"></dd>
      <dt class="text-slate-500 pt-1.5">Giờ gửi</dt>
      <dd><form @submit.prevent="saveTime()" class="flex flex-wrap items-center gap-2">
        <input type="time" x-model="at" required class="input w-32 py-1">
        <button type="submit" :disabled="busy || at === s.at" class="btn-primary px-3 py-1 text-sm" x-text="busy ? 'Đang lưu...' : 'Lưu giờ gửi'"></button>
        <span class="text-xs text-slate-500">giờ VN · Chủ nhật không gửi</span>
      </form></dd>
      <dt class="text-slate-500">Lần gửi kế tiếp</dt>
      <dd x-text="s.nextRunAt ? new Date(s.nextRunAt).toLocaleString('vi-VN') : '—'"></dd>
      <dt class="text-slate-500">Đã gửi gần nhất</dt>
      <dd x-text="(s.dailyLast ? 'ngày ' + s.dailyLast.split('-').reverse().join('/') : '—') + (s.monthlyLast ? ' · tháng ' + s.monthlyLast.split('-').reverse().join('/') : '')"></dd>
    </dl>
    <p x-show="s.lastError" x-cloak class="mt-2 text-sm text-red-600" x-text="s.lastError ? 'Lỗi lần trước (' + new Date(s.lastError.at).toLocaleString('vi-VN') + '): ' + s.lastError.message : ''"></p>
    <p x-show="err" x-cloak class="mt-2 text-sm text-red-600" x-text="err"></p>
    <p x-show="msg" x-cloak class="mt-2 text-sm text-emerald-700 dark:text-emerald-400" x-text="msg"></p>
  </section>

  <%# ---- Sao lưu ra ngoài máy: GitHub (mã hóa) ---- %>
  <section class="card mt-4" x-data="gitBackup()">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="flex items-center gap-2 font-semibold"><%- icon('lock', 'h-5 w-5 text-brand-600') %>Sao lưu ngoài máy (GitHub, mã hóa)</h2>
        <p class="mt-0.5 text-sm text-slate-500">Mỗi ngày 2h sáng: CSDL + ảnh được nén, <strong>mã hóa AES-256</strong> rồi đẩy lên nhánh <code x-text="s.branch || 'backup'"></code> của repo GitHub. Giữ <span x-text="s.keep || 7"></span> bản gần nhất. Phòng khi máy NUC hỏng ổ.</p>
      </div>
      <button type="button" @click="runNow()" :disabled="busy || s.running || !s.configured" class="btn-primary px-3 py-1.5 text-sm"><%- icon('refresh', 'h-4 w-4') %><span x-text="busy || s.running ? 'Đang sao lưu...' : 'Sao lưu ngay'"></span></button>
    </div>
    <dl class="mt-3 grid grid-cols-[9rem_1fr] gap-x-4 gap-y-1.5 text-sm">
      <dt class="text-slate-500">Lần gần nhất</dt>
      <dd x-text="s.last ? new Date(s.last.at).toLocaleString('vi-VN') + ' — ' + s.last.file + ' (' + (s.last.size / 1048576).toFixed(1) + ' MB, ' + s.last.seconds + 's) · đang giữ ' + s.last.kept + ' bản' : 'Chưa chạy — bấm “Sao lưu ngay” để thử'"></dd>
      <dt class="text-slate-500">Mật khẩu giải mã</dt>
      <dd>
        <template x-if="!pass"><button type="button" @click="showPass()" class="text-brand-600 hover:underline">Hiện mật khẩu</button></template>
        <template x-if="pass"><span><code class="select-all rounded bg-slate-100 px-2 py-0.5 font-mono dark:bg-slate-800" x-text="pass"></code>
          <span class="block text-xs text-amber-700 dark:text-amber-400">Chép ra chỗ an toàn ngoài máy này (ghi chú điện thoại, sổ). Mất mật khẩu thì không mở được bản sao lưu.</span></span></template>
      </dd>
    </dl>
    <p x-show="s.lastError" x-cloak class="mt-2 text-sm text-red-600" x-text="s.lastError ? 'Lỗi lần trước (' + new Date(s.lastError.at).toLocaleString('vi-VN') + '): ' + s.lastError.message : ''"></p>
    <p x-show="err" x-cloak class="mt-2 text-sm text-red-600" x-text="err"></p>
    <p x-show="msg" x-cloak class="mt-2 text-sm text-emerald-700 dark:text-emerald-400" x-text="msg"></p>
  </section>
</div>
<%- include('../app/_bottom') %>
