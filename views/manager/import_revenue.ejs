<%- include('../app/_top') %>
<%- include('_import_tabs', { active: 'revenue' }) %>

<% if (!view) { %>
  <form method="post" action="/manager/import/revenue?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" class="card space-y-4" x-data="{ busy: false, name: '' }" @submit="busy = true">
    <label class="grid cursor-pointer place-items-center gap-2 rounded-xl border-2 border-dashed border-slate-300 px-4 py-10 text-center hover:border-brand-500 dark:border-slate-700">
      <%- icon('upload', 'h-10 w-10 text-brand-600') %>
      <span class="font-medium" x-text="name || 'Chọn file Excel doanh thu (.xlsx)'"></span>
      <span class="text-xs text-slate-500">Google Sheets: Tệp → Tải xuống → Microsoft Excel (.xlsx) · tối đa 25MB</span>
      <input type="file" name="file" accept=".xlsx,.xls,.xlsm" required class="sr-only" @change="name = $event.target.files[0]?.name || ''">
    </label>
    <div class="flex justify-end"><button class="btn-primary" :disabled="busy"><%- icon('search', 'h-4 w-4') %><span x-text="busy ? 'Đang đọc file (vài giây)...' : 'Đọc & xem trước'"></span></button></div>
  </form>
  <section class="card mt-4 text-sm">
    <h2 class="mb-2 font-semibold">Cấu trúc file được nhận diện</h2>
    <div class="flex flex-wrap gap-1.5"><% ['THÁNG','NGÀY','NỘI DUNG','SDT KHÁCH','THU','CHI','GHI CHÚ'].forEach(c => { %><span class="badge-gray"><%= c %></span><% }) %></div>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-600 dark:text-slate-400">
      <li>Ô <strong>NGÀY</strong> gộp nhiều dòng được hiểu đúng (mỗi dòng lấy ngày gần nhất phía trên). Sheet không có các cột này (VD "Tổng hợp") được bỏ qua.</li>
      <li>Chỉ lấy dòng <strong>có NỘI DUNG</strong>; dòng có số tiền nhưng trống nội dung được bỏ qua (hiện tổng để đối chiếu).</li>
      <li>Cột <strong>THU</strong> → Doanh thu. Cột <strong>CHI</strong> (mua máy, nhập hàng…) → mục <strong>Chi phí</strong> (có thể bỏ tích nếu không muốn nhập).</li>
      <li>Số tiền ghi theo <strong>nghìn đồng</strong> (900 = 900.000đ) được tự nhận diện; có thể đổi ở bước xem trước.</li>
      <li>Loại tự đoán theo nội dung: có "sửa, thay, vs, vệ sinh, cài win…" → <em>Sửa chữa</em>, còn lại → <em>Bán hàng</em>. Có "ck / chuyển khoản" → <em>Chuyển khoản</em>, còn lại → <em>Tiền mặt</em>.</li>
      <li>Nhập lại cùng file: các dòng đã nhập trước đó tự bỏ qua. Mỗi lần nhập là một <strong>đợt</strong>, có thể xóa cả đợt.</li>
    </ul>
  </section>
<% } else { const v = view; %>
  <div class="card mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="font-semibold"><%- icon('fileSheet', 'mr-1 inline h-5 w-5 text-emerald-600') %><%= v.fileName %></p>
      <p class="text-sm text-slate-500">Sheet: <%= v.sheets.join(', ') %> · <%= v.dateFrom ? fmt.date(v.dateFrom) + ' – ' + fmt.date(v.dateTo) : '' %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <form method="post" action="/manager/import/revenue/unit" class="flex items-center gap-1.5 text-sm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <span class="text-slate-500">Đơn vị tiền:</span>
        <select name="unit" class="input w-auto py-1.5 text-sm" @change="$el.form.submit()">
          <option value="auto" <%= v.unit === 'auto' ? 'selected' : '' %>>Tự nhận (<%= v.factor === 1000 ? 'nghìn đồng' : 'đồng' %>)</option>
          <option value="thousand" <%= v.unit === 'thousand' ? 'selected' : '' %>>Nghìn đồng (900 = 900.000đ)</option>
          <option value="vnd" <%= v.unit === 'vnd' ? 'selected' : '' %>>Đồng</option>
        </select>
      </form>
      <form method="post" action="/manager/import/revenue/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary">Hủy</button></form>
      <form method="post" action="/manager/import/revenue/confirm" x-data="{ busy: false, exp: <%= v.expense.new ? 'true' : 'false' %> }" @submit="busy = true" class="flex flex-wrap items-center gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (v.expense.count) { %><label class="flex items-center gap-1.5 text-sm"><input type="checkbox" name="with_expense" value="1" x-model="exp" class="h-4 w-4">Nhập cả <%= fmt.num(v.expense.new) %> khoản chi (cột CHI)</label><% } %>
        <button class="btn-primary" :disabled="busy || <%= v.good === 0 && !v.expense.new %>"><%- icon('check', 'h-4 w-4') %><span x-text="busy ? 'Đang lưu...' : 'Nhập <%= v.good %> giao dịch' + (exp ? ' + <%= v.expense.new %> khoản chi' : '')"></span></button></form>
    </div>
  </div>
  <% v.warnings.forEach(w => { %><p class="mb-2 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800 dark:bg-amber-950 dark:text-amber-200"><%= w %></p><% }) %>

  <div class="mb-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <div class="stat col-span-2 lg:col-span-1"><p class="stat-label">Sẽ nhập</p><p class="stat-value text-brand-700 dark:text-brand-300"><%= fmt.money(v.sum) %></p><p class="text-xs text-slate-500"><%= fmt.num(v.good) %> giao dịch</p></div>
    <a href="?show=repair" class="stat hover:border-brand-400 <%= v.filter === 'repair' ? 'ring-2 ring-brand-500' : '' %>"><p class="stat-label">Sửa chữa / Bán hàng</p><p class="mt-1 text-lg font-bold tabular-nums"><%= fmt.num(v.repair) %> / <%= fmt.num(v.sale) %></p><p class="text-xs text-slate-500"><%= fmt.num(v.transfer) %> chuyển khoản</p></a>
    <a href="?show=duplicate" class="stat hover:border-brand-400 <%= v.filter === 'duplicate' ? 'ring-2 ring-brand-500' : '' %>"><p class="stat-label">Bỏ qua (trùng / thiếu ngày)</p><p class="mt-1 text-lg font-bold tabular-nums text-red-600"><%= fmt.num(v.duplicate) %> / <%= fmt.num(v.problem) %></p></a>
    <div class="stat"><p class="stat-label">Chi & bỏ qua</p>
      <p class="mt-1 text-sm"><span class="text-slate-500">Cột CHI → Chi phí:</span> <strong class="tabular-nums"><%= fmt.money(v.expense.newTotal) %></strong> <span class="text-xs text-slate-500">(<%= fmt.num(v.expense.new) %> khoản mới<%= v.expense.count > v.expense.new ? ', ' + (v.expense.count - v.expense.new) + ' trùng/thiếu ngày' : '' %>)</span></p>
      <p class="text-sm"><span class="text-slate-500">Trống nội dung:</span> <strong class="tabular-nums"><%= fmt.money(v.noContent.total) %></strong> <span class="text-xs text-slate-500">(<%= fmt.num(v.noContent.count) %> dòng)</span></p></div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[22rem_1fr]">
    <section>
      <h2 class="mb-2 font-semibold">Theo tháng</h2>
      <div class="tbl-wrap max-h-[60vh] overflow-y-auto"><table class="tbl">
        <thead class="sticky top-0"><tr><th>Tháng</th><th class="text-right">GD</th><th class="text-right">Doanh thu</th></tr></thead>
        <tbody>
          <% v.months.forEach(m => { %>
            <tr><td class="whitespace-nowrap"><%= m.month.slice(5) %>/<%= m.month.slice(0, 4) %></td><td class="text-right tabular-nums"><%= m.count %></td>
              <td class="whitespace-nowrap text-right font-semibold tabular-nums" title="Sửa chữa <%= fmt.num(m.repair) %> · Bán hàng <%= fmt.num(m.sale) %>"><%= fmt.num(m.total) %></td></tr>
          <% }) %>
        </tbody>
      </table></div>
    </section>
    <section class="min-w-0">
      <div class="mb-2 flex flex-wrap items-center gap-1.5 text-sm">
        <% [['all','Tất cả'],['repair','Sửa chữa'],['sale','Bán hàng'],['transfer','Chuyển khoản'],['duplicate','Trùng'],['problem','Thiếu ngày']].forEach(([k, l]) => { %>
          <a href="?show=<%= k %>" class="rounded-md px-2.5 py-1 <%= v.filter === k ? 'bg-brand-600 text-white' : 'bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700' %>"><%= l %></a>
        <% }) %>
        <span class="ml-auto text-xs text-slate-500"><%= fmt.num(v.shown) %> dòng<%= v.shown > v.rows.length ? ` · hiện ${v.rows.length} dòng mới nhất` : '' %></span>
      </div>
      <div class="tbl-wrap max-h-[60vh] overflow-y-auto"><table class="tbl table-fixed">
        <colgroup><col class="w-24"><col><col class="w-28"><col class="w-24"><col class="w-28"></colgroup>
        <thead class="sticky top-0"><tr><th>Ngày</th><th>Nội dung</th><th class="text-right">Số tiền</th><th>Loại</th><th>Thanh toán</th></tr></thead>
        <tbody>
          <% v.rows.forEach(r => { %>
            <tr class="<%= r.duplicate || r.problem ? 'bg-red-50/60 dark:bg-red-950/30' : '' %>">
              <td class="whitespace-nowrap text-xs"><%= r.date ? fmt.date(r.date) : '—' %><span class="block text-slate-400">dòng <%= r.line %></span></td>
              <td class="min-w-0"><span class="block truncate" title="<%= r.content %>"><%= r.content %></span>
                <% if (r.phone || r.note || r.duplicate || r.problem) { %><span class="block truncate text-xs text-slate-500"><%= [r.phone, r.note, r.duplicate, r.problem].filter(Boolean).join(' · ') %></span><% } %></td>
              <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= fmt.num(r.amount) %></td>
              <td><span class="<%= r.type === 'repair' ? 'badge-blue' : 'badge-violet' %>"><%= r.type === 'repair' ? 'Sửa chữa' : 'Bán hàng' %></span></td>
              <td class="text-xs"><%= fmt.payment(r.payment) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    </section>
  </div>
<% } %>

<section class="mt-6">
  <h2 class="mb-2 font-semibold">Các đợt đã nhập</h2>
  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>Đợt</th><th>File</th><th>Khoảng ngày</th><th class="text-right">Thu</th><th class="text-right">Chi</th><th>Người nhập</th><th></th></tr></thead>
    <tbody>
      <% batches.forEach(b => { %>
        <tr>
          <td class="whitespace-nowrap font-mono text-xs"><%= b.id %><span class="block font-sans text-slate-500"><%= fmt.datetime(b.created_at) %></span></td>
          <td class="max-w-56 truncate text-sm" title="<%= b.file_name %>"><%= b.file_name %></td>
          <td class="whitespace-nowrap text-sm"><%= fmt.date(b.date_from) %> – <%= fmt.date(b.date_to) %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><span class="font-semibold"><%= fmt.num(b.total) %></span><span class="block text-xs text-slate-500"><%= fmt.num(b.remaining) %> GD</span></td>
          <td class="whitespace-nowrap text-right tabular-nums"><span class="font-semibold"><%= fmt.num(b.expense_total) %></span><span class="block text-xs text-slate-500"><%= fmt.num(b.exp_remaining) %> khoản</span></td>
          <td class="text-sm"><%= b.user_name %></td>
          <td class="text-right">
            <form method="post" action="/manager/import/revenue/batches/<%= b.id %>/delete" data-confirm="Xóa toàn bộ <%= b.remaining %> giao dịch thu<%= b.exp_remaining ? ' và ' + b.exp_remaining + ' khoản chi' : '' %> của đợt <%= b.id %>? Không thể hoàn tác.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="inline-grid h-8 w-8 place-items-center rounded-lg text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950" title="Xóa cả đợt"><%- icon('trash', 'h-4 w-4') %></button></form>
          </td>
        </tr>
      <% }) %>
      <% if (!batches.length) { %><tr><td colspan="7" class="py-6 text-center text-sm text-slate-500">Chưa nhập đợt nào.</td></tr><% } %>
    </tbody>
  </table></div>
</section>
<%- include('../app/_bottom') %>
